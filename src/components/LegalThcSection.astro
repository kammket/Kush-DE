---
import { defaultLocale, type Locale } from '../i18n/config';
import { getLocalePath } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale as Locale } = Astro.props;
const lp = (path: string) => getLocalePath(path, locale);

const tr: Record<string, { tag: string; title: string; desc: string; flowers: string; gummies: string; wa: string; note: string }> = {
  en: {
    tag: 'Legal THC & CBD',
    title: 'The Strongest Products Allowed Under EU Law',
    desc: 'Looking for legal THC? We supply precisely dosed THC gummies and edibles compliant with European legislation (<0.20% THC), and premium hemp flowers naturally rich in cannabinoids with THC below the 0.3% legal limit. Every batch is lab-tested, certified, and shipped discreetly across Europe within 24 hours.',
    gummies: 'Shop Legal THC Gummies',
    flowers: 'Shop CBD Flowers',
    wa: 'Ask us on WhatsApp',
    note: '100% compliant with EU law · Lab certificates available for every product',
  },
  fr: {
    tag: 'THC & CBD légaux',
    title: 'Les produits les plus puissants autorisés par la loi européenne',
    desc: 'Vous cherchez du THC légal ? Nous fournissons des gummies et comestibles THC dosés avec précision, conformes à la législation européenne (<0,20 % THC), et des fleurs de chanvre premium naturellement riches en cannabinoïdes avec un THC inférieur à la limite légale de 0,3 %. Chaque lot est testé en laboratoire, certifié et expédié discrètement dans toute l\'Europe sous 24 h.',
    gummies: 'Voir les Gummies THC légaux',
    flowers: 'Voir les Fleurs CBD',
    wa: 'Contactez-nous sur WhatsApp',
    note: '100 % conforme à la loi UE · Certificats de laboratoire disponibles pour chaque produit',
  },
  de: {
    tag: 'Legales THC & CBD',
    title: 'Die stärksten Produkte, die das EU-Recht erlaubt',
    desc: 'Sie suchen legales THC? Wir liefern präzise dosierte THC-Fruchtgummis und Edibles konform mit europäischem Recht (<0,20 % THC) sowie Premium-Hanfblüten, von Natur aus reich an Cannabinoiden, mit THC unter der gesetzlichen Grenze von 0,3 %. Jede Charge ist laborgeprüft, zertifiziert und wird diskret innerhalb von 24 Stunden in ganz Europa versandt.',
    gummies: 'Legale THC-Fruchtgummis ansehen',
    flowers: 'CBD-Blüten ansehen',
    wa: 'Fragen Sie uns auf WhatsApp',
    note: '100 % EU-rechtskonform · Laborzertifikate für jedes Produkt verfügbar',
  },
  es: {
    tag: 'THC y CBD legales',
    title: 'Los productos más potentes permitidos por la ley de la UE',
    desc: '¿Buscas THC legal? Suministramos gominolas y comestibles THC dosificados con precisión, conformes con la legislación europea (<0,20 % THC), y flores de cáñamo premium naturalmente ricas en cannabinoides con THC por debajo del límite legal del 0,3 %. Cada lote está testado en laboratorio, certificado y se envía discretamente por toda Europa en 24 h.',
    gummies: 'Ver Gominolas THC legales',
    flowers: 'Ver Flores CBD',
    wa: 'Pregúntanos por WhatsApp',
    note: '100 % conforme con la ley de la UE · Certificados de laboratorio disponibles para cada producto',
  },
  it: {
    tag: 'THC e CBD legali',
    title: 'I prodotti più potenti consentiti dalla legge UE',
    desc: 'Cerchi THC legale? Forniamo caramelle gommose ed edibili THC dosati con precisione, conformi alla legislazione europea (<0,20 % THC), e fiori di canapa premium naturalmente ricchi di cannabinoidi con THC sotto il limite legale dello 0,3 %. Ogni lotto è testato in laboratorio, certificato e spedito con discrezione in tutta Europa entro 24 ore.',
    gummies: 'Vedi le Caramelle THC legali',
    flowers: 'Vedi i Fiori CBD',
    wa: 'Chiedici su WhatsApp',
    note: '100 % conforme alla legge UE · Certificati di laboratorio disponibili per ogni prodotto',
  },
  nl: {
    tag: 'Legale THC & CBD',
    title: 'De sterkste producten die de EU-wet toestaat',
    desc: 'Op zoek naar legale THC? Wij leveren nauwkeurig gedoseerde THC-gummies en edibles conform de Europese wetgeving (<0,20 % THC), en premium hennepbloemen van nature rijk aan cannabinoïden met THC onder de wettelijke grens van 0,3 %. Elke partij is laboratoriumgetest, gecertificeerd en wordt discreet binnen 24 uur door heel Europa verzonden.',
    gummies: 'Bekijk legale THC-gummies',
    flowers: 'Bekijk CBD-bloemen',
    wa: 'Vraag het ons via WhatsApp',
    note: '100 % conform EU-wetgeving · Laboratoriumcertificaten beschikbaar voor elk product',
  },
  fi: {
    tag: 'Laillinen THC & CBD',
    title: 'Vahvimmat EU-lain sallimat tuotteet',
    desc: 'Etsitkö laillista THC:tä? Toimitamme tarkasti annosteltuja THC-kumikarkkeja ja -syötäviä, jotka ovat eurooppalaisen lainsäädännön mukaisia (<0,20 % THC), sekä premium-hamppukukkia, jotka ovat luonnostaan runsaita kannabinoideja ja joiden THC on alle laillisen 0,3 %:n rajan. Jokainen erä on laboratoriotestattu, sertifioitu ja toimitetaan huomaamattomasti kaikkialle Eurooppaan 24 tunnissa.',
    gummies: 'Katso lailliset THC-kumikarkit',
    flowers: 'Katso CBD-kukat',
    wa: 'Kysy meiltä WhatsAppissa',
    note: '100 % EU-lain mukainen · Laboratoriotodistukset saatavilla jokaiselle tuotteelle',
  },
  pt: {
    tag: 'THC e CBD legais',
    title: 'Os produtos mais potentes permitidos pela lei da UE',
    desc: 'Procura THC legal? Fornecemos gomas e comestíveis THC doseados com precisão, conformes com a legislação europeia (<0,20 % THC), e flores de cânhamo premium naturalmente ricas em canabinoides com THC abaixo do limite legal de 0,3 %. Cada lote é testado em laboratório, certificado e enviado discretamente por toda a Europa em 24 horas.',
    gummies: 'Ver Gomas THC legais',
    flowers: 'Ver Flores CBD',
    wa: 'Pergunte-nos no WhatsApp',
    note: '100 % conforme a lei da UE · Certificados de laboratório disponíveis para cada produto',
  },
};

const s = tr[locale] || tr.en;
const waUrl = `https://wa.me/447346989289?text=${encodeURIComponent(
  locale === 'fr' ? 'Bonjour ! J\'ai une question sur vos produits THC légaux.'
  : locale === 'de' ? 'Hallo! Ich habe eine Frage zu Ihren legalen THC-Produkten.'
  : locale === 'es' ? '¡Hola! Tengo una pregunta sobre sus productos THC legales.'
  : locale === 'it' ? 'Salve! Ho una domanda sui vostri prodotti THC legali.'
  : locale === 'nl' ? 'Hallo! Ik heb een vraag over jullie legale THC-producten.'
  : locale === 'fi' ? 'Hei! Minulla on kysymys laillisista THC-tuotteistanne.'
  : locale === 'pt' ? 'Olá! Tenho uma pergunta sobre os vossos produtos THC legais.'
  : 'Hello! I have a question about your legal THC products.'
)}`;
---

<section class="relative bg-gray-900 text-white overflow-hidden" aria-labelledby="legal-thc-heading">
  <div class="absolute inset-0 bg-[url('/images/hero-pattern.svg')] opacity-5"></div>
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-accent/10 rounded-full blur-3xl"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
    <div class="max-w-3xl">
      <p class="text-accent font-semibold text-sm uppercase tracking-wider mb-3">{s.tag}</p>
      <h2 id="legal-thc-heading" class="text-2xl md:text-3xl lg:text-4xl font-extrabold leading-tight mb-5">{s.title}</h2>
      <p class="text-gray-300 leading-relaxed mb-8">{s.desc}</p>
      <div class="flex flex-wrap gap-3">
        <a href={lp('/collections/thc-gummies')} class="inline-flex items-center px-5 py-3 bg-accent text-gray-900 font-bold rounded-lg hover:bg-accent-dark transition-colors">
          {s.gummies}
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={lp('/collections/cbd-flowers')} class="inline-flex items-center px-5 py-3 border-2 border-white/40 text-white font-bold rounded-lg hover:bg-white/10 transition-colors">
          {s.flowers}
        </a>
        <a href={waUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 bg-[#128C7E] text-white font-bold rounded-lg hover:bg-[#0D6D5F] transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {s.wa}
        </a>
      </div>
      <p class="mt-6 text-xs text-gray-400 flex items-center gap-1.5">
        <svg class="w-4 h-4 text-green-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        {s.note}
      </p>
    </div>
  </div>
</section>
