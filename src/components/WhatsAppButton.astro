---
/**
 * WhatsApp floating button — shows on all pages for instant customer contact.
 * Uses WhatsApp Business API link.
 */
import { defaultLocale, type Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
  phone?: string;
}

const { locale = defaultLocale as Locale, phone = "447346989289" } = Astro.props;

const messages: Record<string, string> = {
  en: "Hello! I'm interested in your wholesale CBD products. Can you help me?",
  es: "¡Hola! Estoy interesado en sus productos CBD al por mayor. ¿Pueden ayudarme?",
  fr: "Bonjour ! Je suis intéressé par vos produits CBD en gros. Pouvez-vous m'aider ?",
  de: "Hallo! Ich interessiere mich für Ihre CBD-Großhandelsprodukte. Können Sie mir helfen?",
  nl: "Hallo! Ik ben geïnteresseerd in uw CBD-groothandelsproducten. Kunt u mij helpen?",
  it: "Ciao! Sono interessato ai vostri prodotti CBD all'ingrosso. Potete aiutarmi?",
  fi: "Hei! Olen kiinnostunut CBD-tukkutuotteistanne. Voitteko auttaa minua?",
  pt: "Olá! Estou interessado nos vossos produtos CBD por grosso. Podem ajudar-me?",
};

const tooltips: Record<string, string> = {
  en: "Chat with us on WhatsApp",
  es: "Chatea con nosotros en WhatsApp",
  fr: "Discutez avec nous sur WhatsApp",
  de: "Chatten Sie mit uns auf WhatsApp",
  nl: "Chat met ons op WhatsApp",
  it: "Chatta con noi su WhatsApp",
  fi: "Keskustele kanssamme WhatsAppissa",
  pt: "Fale connosco no WhatsApp",
};

const message = encodeURIComponent(messages[locale] || messages.en);
const tooltip = tooltips[locale] || tooltips.en;
const waUrl = `https://wa.me/${phone}?text=${message}`;
---

<a
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={tooltip}
  title={tooltip}
  class="whatsapp-btn fixed bottom-6 right-6 z-50 w-14 h-14 bg-[#128C7E] rounded-full flex items-center justify-center shadow-lg hover:shadow-xl hover:scale-110 transition-all duration-300 group"
>
  <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  <!-- Pulse animation -->
  <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full animate-ping opacity-75"></span>
  <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full"></span>
</a>

<style>
  @media (max-width: 640px) {
    .whatsapp-btn {
      bottom: 1rem;
      right: 1rem;
      width: 3rem;
      height: 3rem;
    }
    .whatsapp-btn svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }
</style>
