const headings: Record<string, { title: string; subtitle: string }> = {
  en: { title: "Trusted by 5,000+ Professionals Across Europe", subtitle: "See what our wholesale partners say about working with us" },
  es: { title: "Más de 5.000 Profesionales Confían en Nosotros", subtitle: "Descubra lo que dicen nuestros socios mayoristas" },
  fr: { title: "Plus de 5 000 Professionnels Nous Font Confiance", subtitle: "Découvrez ce que disent nos partenaires grossistes" },
  de: { title: "Über 5.000 Fachleute in Europa Vertrauen Uns", subtitle: "Lesen Sie, was unsere Großhandelspartner sagen" },
  nl: { title: "Meer dan 5.000 Professionals Vertrouwen Op Ons", subtitle: "Ontdek wat onze groothandelspartners zeggen" },
  it: { title: "Oltre 5.000 Professionisti in Europa Si Fidano di Noi", subtitle: "Scopri cosa dicono i nostri partner all'ingrosso" },
  fi: { title: "Yli 5 000 ammattilaista luottaa meihin Euroopassa", subtitle: "Katso mitä tukkukauppakumppanimme sanovat" },
  pt: { title: "Mais de 5.000 Profissionais Confiam em Nós", subtitle: "Veja o que os nossos parceiros grossistas dizem" },
};

const items = (testimonials[locale] || testimonials.en).slice(0, limit);
const heading = headings[locale] || headings.en;

---

<section class="py-12 md:py-16 bg-white" aria-labelledby="testimonials-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <div class="flex items-center justify-center gap-1 mb-3">
        {[1,2,3,4,5].map(() => (
          <svg class="w-6 h-6 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        ))}
        <span class="ml-2 text-lg font-bold text-gray-900">4.8/5</span>
        <span class="text-sm text-gray-500 ml-1">(5,127 reviews)</span>
      </div>
      <h2 id="testimonials-heading" class="text-2xl md:text-3xl font-bold text-gray-900">{heading.title}</h2>
      <p class="text-gray-600 mt-2">{heading.subtitle}</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map(item => (
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-1 mb-3">
            {Array.from({length: 5}, (_, i) => (
              <svg class={`w-4 h-4 ${i < item.rating ? 'text-yellow-400' : 'text-gray-300'}`} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-gray-600 text-sm leading-relaxed mb-4 italic">"{item.text}"</p>
          <div class="flex items-center gap-3 pt-3 border-t border-gray-200">
            <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">
              {item.name.charAt(0)}
            </div>
            <div>
              <p class="font-semibold text-sm text-gray-900">{item.flag} {item.name}</p>
              <p class="text-xs text-gray-500">{item.role} · {item.country}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

</section>
