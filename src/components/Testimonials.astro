---
/**
 * Testimonials component — displays customer reviews with ratings.
 * Includes Review JSON-LD for rich snippets.
 * Supports i18n via locale prop.
 */
import { defaultLocale, type Locale } from '../i18n/config';

interface Props {
  locale?: Locale;
  limit?: number;
}

const { locale = defaultLocale as Locale, limit = 6 } = Astro.props;

interface Testimonial {
  name: string;
  role: string;
  country: string;
  flag: string;
  rating: number;
  text: string;
}

