---
import { defaultLocale, type Locale } from '../i18n/config';

interface Props {
  productName: string;
  locale?: Locale;
}

const { productName, locale = defaultLocale as Locale } = Astro.props;

const tr: Record<string, { title: string; desc: string; samples: string; btn: string; or: string; emailLabel: string }> = {
  en: {
    title: 'Wholesale & Bulk Orders',
    desc: 'Special offers and discounts on bulk orders — the bigger the volume, the better your price.',
    samples: 'Sample packs available for all strains, so you can test before ordering in volume.',
    btn: 'Contact for Wholesale or Bulk Orders',
    or: 'or email us directly at',
    emailLabel: 'Wholesale inquiry',
  },
  fr: {
    title: 'Commandes en Gros & en Volume',
    desc: 'Offres spéciales et remises sur les commandes en gros — plus le volume est important, meilleur est votre prix.',
    samples: 'Packs d\'échantillons disponibles pour toutes les variétés, pour tester avant de commander en volume.',
    btn: 'Contact pour Commandes en Gros',
    or: 'ou écrivez-nous directement à',
    emailLabel: 'Demande grossiste',
  },
  de: {
    title: 'Großhandel & Mengenbestellungen',
    desc: 'Sonderangebote und Rabatte auf Mengenbestellungen — je größer das Volumen, desto besser Ihr Preis.',
    samples: 'Musterpakete für alle Sorten verfügbar, damit Sie vor der Volumenbestellung testen können.',
    btn: 'Kontakt für Großhandel & Mengen',
    or: 'oder mailen Sie uns direkt an',
    emailLabel: 'Großhandelsanfrage',
  },
  es: {
    title: 'Pedidos Mayoristas y al Por Mayor',
    desc: 'Ofertas especiales y descuentos en pedidos al por mayor — cuanto mayor el volumen, mejor el precio.',
    samples: 'Packs de muestras disponibles de todas las variedades, para probar antes de pedir en volumen.',
    btn: 'Contacto para Pedidos Mayoristas',
    or: 'o escríbenos directamente a',
    emailLabel: 'Consulta mayorista',
  },
  it: {
    title: 'Ordini all\'Ingrosso e in Volume',
    desc: 'Offerte speciali e sconti sugli ordini in volume — maggiore il volume, migliore il prezzo.',
    samples: 'Pack campione disponibili per tutte le varietà, per testare prima di ordinare in volume.',
    btn: 'Contatto per Ordini all\'Ingrosso',
    or: 'oppure scrivici direttamente a',
    emailLabel: 'Richiesta ingrosso',
  },
  nl: {
    title: 'Groothandel & Bulkbestellingen',
    desc: 'Speciale aanbiedingen en kortingen op bulkbestellingen — hoe groter het volume, hoe beter uw prijs.',
    samples: 'Proefpakketten beschikbaar van alle soorten, zodat u kunt testen voordat u in volume bestelt.',
    btn: 'Contact voor Groothandel of Bulk',
    or: 'of mail ons direct op',
    emailLabel: 'Groothandelsaanvraag',
  },
  fi: {
    title: 'Tukku- ja Bulkkitilaukset',
    desc: 'Erikoistarjouksia ja alennuksia bulkkitilauksiin — mitä suurempi määrä, sitä parempi hinta.',
    samples: 'Näytepakkauksia saatavilla kaikista lajikkeista, jotta voit testata ennen volyymitilaamista.',
    btn: 'Ota Yhteyttä Tukkutilauksiin',
    or: 'tai lähetä sähköpostia suoraan',
    emailLabel: 'Tukkutiedustelu',
  },
  pt: {
    title: 'Encomendas por Grosso e em Volume',
    desc: 'Ofertas especiais e descontos em encomendas por grosso — quanto maior o volume, melhor o preço.',
    samples: 'Packs de amostras disponíveis de todas as variedades, para testar antes de encomendar em volume.',
    btn: 'Contacto para Encomendas por Grosso',
    or: 'ou envie email diretamente para',
    emailLabel: 'Pedido grossista',
  },
};

const s = tr[locale] || tr.en;
const waMessages: Record<string, string> = {
  en: `Hello! I'm interested in wholesale / bulk pricing for: ${productName}. Could you also tell me about sample packs?`,
  fr: `Bonjour ! Je suis intéressé par les tarifs de gros pour : ${productName}. Pouvez-vous aussi me parler des packs d'échantillons ?`,
  de: `Hallo! Ich interessiere mich für Großhandelspreise für: ${productName}. Können Sie mir auch etwas zu den Musterpaketen sagen?`,
  es: `¡Hola! Me interesan los precios mayoristas de: ${productName}. ¿Pueden informarme también sobre los packs de muestras?`,
  it: `Salve! Sono interessato ai prezzi all'ingrosso per: ${productName}. Potete parlarmi anche dei pack campione?`,
  nl: `Hallo! Ik ben geïnteresseerd in groothandelsprijzen voor: ${productName}. Kunnen jullie ook iets vertellen over de proefpakketten?`,
  fi: `Hei! Olen kiinnostunut tukkuhinnoista tuotteelle: ${productName}. Voitteko kertoa myös näytepakkauksista?`,
  pt: `Olá! Estou interessado em preços por grosso para: ${productName}. Podem também informar-me sobre os packs de amostras?`,
};
const waUrl = `https://wa.me/447346989289?text=${encodeURIComponent(waMessages[locale] || waMessages.en)}`;
const email = 'contact@greensfarmhouse.com';
const mailto = `mailto:${email}?subject=${encodeURIComponent(`${s.emailLabel}: ${productName}`)}`;
---

<div class="mt-4 bg-gradient-to-br from-primary/5 to-accent/10 border border-primary/20 rounded-xl p-5">
  <div class="flex items-start gap-3 mb-3">
    <span class="text-2xl">📦</span>
    <div>
      <h3 class="font-bold text-gray-900">{s.title}</h3>
      <p class="text-sm text-gray-600 mt-1">{s.desc}</p>
      <p class="text-sm text-gray-600 mt-1">🌿 {s.samples}</p>
    </div>
  </div>
  <a
    href={waUrl}
    target="_blank"
    rel="noopener"
    class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#25D366] hover:bg-[#1eb857] text-white font-bold rounded-lg text-sm transition-colors"
  >
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    {s.btn}
  </a>
  <p class="mt-2.5 text-xs text-gray-500 text-center">
    {s.or}
    <a href={mailto} class="text-primary font-medium hover:underline">{email}</a>
  </p>
</div>
