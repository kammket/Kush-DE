        <!-- Quick Links -->
        <div>
          <h3 class="font-semibold mb-4">{t(locale, 'footer.quickLinks')}</h3>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a href={lp('/collections/cbd-flowers')} class="hover:text-white transition-colors">{t(locale, 'home.flowersTitle')}</a></li>
            <li><a href={lp('/collections/cbd-resins')} class="hover:text-white transition-colors">{t(locale, 'home.resinsTitle')}</a></li>
