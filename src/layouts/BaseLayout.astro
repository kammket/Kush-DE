          </ul>
        </div>
        
        <!-- SEO Geo Links -->
        <div>
          <h3 class="font-semibold mb-4">{t(locale, 'footer.cbdEurope')}</h3>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a href={lp('/cbd-wholesaler-organic')} class="hover:text-white transition-colors">{t(locale, 'footer.organicCbd')}</a></li>
            <li><a href={lp('/cbd-wholesaler-belgium')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdBelgium')}</a></li>
            <li><a href={lp('/cbd-wholesaler-spain')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdSpain')}</a></li>
            <li><a href={lp('/cbd-wholesaler-luxembourg')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdLuxembourg')}</a></li>
            <li><a href={lp('/cbd-wholesaler-switzerland')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdSwitzerland')}</a></li>
            <li><a href={lp('/cbd-wholesaler-malta')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdMalta')}</a></li>
            <li><a href={lp('/cbd-in-tobacco-shops')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdTobacco')}</a></li>
          </ul>
        </div>

        <!-- CBD Flowers Links -->
        <div>
          <h3 class="font-semibold mb-4">{t(locale, 'footer.cbdFlowers')}</h3>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a href={lp('/wholesale-cbd-flowers-europe')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdFlowersEurope')}</a></li>
            <li><a href={lp('/cbd-hemp-flowers-indoor')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdFlowersIndoor')}</a></li>
            <li><a href={lp('/cbd-hemp-flowers-greenhouse')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdFlowersGreenhouse')}</a></li>
            <li><a href={lp('/wholesale-cbd-flowers-germany')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdFlowersGermany')}</a></li>
            <li><a href={lp('/wholesale-cbd-flowers-france')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdFlowersFrance')}</a></li>
            <li><a href={lp('/wholesale-cbd-flowers-italy')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdFlowersItaly')}</a></li>
            <li><a href={lp('/wholesale-cbd-flowers-netherlands')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdFlowersNetherlands')}</a></li>
            <li><a href={lp('/cbd-flowers-bulk-europe')} class="hover:text-white transition-colors">{t(locale, 'footer.cbdFlowersBulk')}</a></li>
          </ul>
        </div>
        
        <!-- Information -->
        <div>
          <h3 class="font-semibold mb-4">{t(locale, 'footer.information')}</h3>
