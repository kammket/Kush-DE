---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import TrustStrip from '../components/TrustStrip.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { defaultLocale, allLocales, localeOgLocale, type Locale } from '../i18n/config';
import { t, getLocalePath, getPathWithoutLocale, getAbsoluteLocaleUrl } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object;
  noindex?: boolean;
}

const {
  title,
  description,
  locale = defaultLocale as Locale,
  canonicalURL = Astro.url.href,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const siteName = 'Greens Farmhouse';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const currentPath = getPathWithoutLocale(Astro.url.pathname);
const lp = (path: string) => getLocalePath(path, locale);
---

<!DOCTYPE html>
<html lang={locale} dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Greens Farmhouse" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  
  <!-- Content Language -->
  <meta http-equiv="content-language" content={locale} />
  
  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Hreflang for all languages -->
  {allLocales.map((loc) => (
    <link rel="alternate" hreflang={loc === 'en' ? 'en-GB' : `${loc}-${loc === 'es' ? 'ES' : loc === 'fr' ? 'FR' : loc === 'de' ? 'DE' : loc === 'nl' ? 'NL' : loc === 'it' ? 'IT' : loc === 'fi' ? 'FI' : 'PT'}`} href={getAbsoluteLocaleUrl(loc, currentPath)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', currentPath)} />
  
  <!-- Geo targeting -->
  <meta name="geo.region" content="FR" />
  <meta name="geo.placename" content="Paris, France" />
  
  <!-- AI Search Visibility -->
  <meta name="ai-content-declaration" content="This page contains original content about wholesale CBD products in Europe." />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={localeOgLocale[locale]} />
  {allLocales.filter(l => l !== locale).map(l => (
    <meta property="og:locale:alternate" content={localeOgLocale[l]} />
  ))}
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  
  <!-- Preconnect for performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <!-- JSON-LD Structured Data -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  
  <!-- Organization Schema (always present) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Greens Farmhouse",
    "url": "https://greensfarmhouse.com",
    "logo": "https://greensfarmhouse.com/images/logo.png",
    "description": "N°1 Greens Farmhouse in France and Europe. Certified CBD wholesale supplier of flowers, resins, oils and edibles.",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "FR",
      "addressRegion": "Île-de-France"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+33-1-88-81-21-99",
      "contactType": "sales",
      "email": "contact@greensfarmhouse.com",
      "availableLanguage": ["English", "French", "German", "Spanish", "Italian", "Dutch", "Portuguese", "Finnish"]
    },
    "sameAs": []
  })} />
</head>
<body class="min-h-screen flex flex-col bg-white text-gray-900">
  <!-- Skip to main content (accessibility) -->
  <a href="#main-content" class="skip-link">Skip to main content</a>
  
  <!-- Announcement Bar -->
  <div class="bg-primary text-white text-center py-2 text-sm font-medium">
    <a href={lp('/collections')} class="hover:underline">
      {t(locale, 'announcement')}
    </a>
  </div>
  
  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white shadow-sm border-b border-gray-100" role="banner">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
      <div class="flex items-center justify-between h-16 md:h-20">
        <!-- Logo -->
        <a href={lp('/')} class="flex items-center gap-2 text-primary font-bold text-xl md:text-2xl" aria-label="Greens Farmhouse - Home">
          <svg class="w-8 h-8 md:w-10 md:h-10" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="20" fill="currentColor"/>
            <text x="50%" y="55%" text-anchor="middle" fill="white" font-size="14" font-weight="bold" dy=".1em">CBD</text>
          </svg>
          <span class="hidden sm:inline">Greens Farmhouse</span>
          <span class="sm:hidden">Greens Farmhouse</span>
        </a>
        
        <!-- Desktop Navigation -->
        <div class="hidden lg:flex items-center gap-8">
          <a href={lp('/collections/cbd-flowers')} class="text-gray-700 hover:text-primary font-medium transition-colors">{t(locale, 'nav.flowers')}</a>
          <a href={lp('/collections/cbd-resins')} class="text-gray-700 hover:text-primary font-medium transition-colors">{t(locale, 'nav.resins')}</a>
          <a href={lp('/collections/cbd-oils')} class="text-gray-700 hover:text-primary font-medium transition-colors">{t(locale, 'nav.oils')}</a>
          <a href={lp('/collections/cbd-gummies')} class="text-gray-700 hover:text-primary font-medium transition-colors">{t(locale, 'nav.gummies')}</a>
          <a href={lp('/collections/thc-gummies')} class="text-gray-700 hover:text-primary font-medium transition-colors">{t(locale, 'nav.thcGummies')}</a>
          <a href={lp('/blog')} class="text-gray-700 hover:text-primary font-medium transition-colors">{t(locale, 'nav.blog')}</a>
          <a href={lp('/about')} class="text-gray-700 hover:text-primary font-medium transition-colors">{t(locale, 'nav.about')}</a>
        </div>
        
        <!-- Right Side -->
        <div class="flex items-center gap-3">
          <!-- Language Switcher -->
          <LanguageSwitcher locale={locale} />

          <!-- Cart Icon -->
          <a href={lp('/cart')} class="relative p-2 rounded-lg hover:bg-gray-100 transition-colors" aria-label={t(locale, 'nav.cart')}>
            <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
            </svg>
            <span id="cart-badge" class="hidden absolute -top-0.5 -right-0.5 bg-red-600 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">0</span>
          </a>

          <a href={lp('/contact')} class="hidden md:inline-flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-lg font-medium hover:bg-primary-dark transition-colors text-sm">
            {t(locale, 'common.contactUs')}
          </a>
          
          <!-- Mobile Menu Button -->
          <button 
            id="mobile-menu-btn"
            class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors" 
            aria-label="Toggle mobile menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Mobile Menu -->
      <div id="mobile-menu" class="lg:hidden hidden pb-4 border-t border-gray-100" role="navigation" aria-label="Mobile navigation">
        <div class="flex flex-col gap-2 pt-4">
          <a href={lp('/collections/cbd-flowers')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.flowers')}</a>
          <a href={lp('/collections/cbd-resins')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.resins')}</a>
          <a href={lp('/collections/cbd-oils')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.oils')}</a>
          <a href={lp('/collections/cbd-gummies')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.gummies')}</a>
          <a href={lp('/collections/thc-gummies')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.thcGummies')}</a>
          <a href={lp('/blog')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.blog')}</a>
          <a href={lp('/about')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.about')}</a>
          <a href={lp('/cart')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium flex items-center gap-2">
            {t(locale, 'nav.cart')} <span id="cart-badge-mobile" class="hidden bg-red-600 text-white text-xs font-bold w-5 h-5 rounded-full inline-flex items-center justify-center">0</span>
          </a>
          <a href={lp('/contact')} class="mx-4 mt-2 text-center bg-primary text-white px-4 py-2 rounded-lg font-medium">{t(locale, 'common.contactUs')}</a>
        </div>
      </div>
    </nav>
  </header>

  <!-- Trust Strip -->
  <TrustStrip locale={locale} />
  
  <!-- Main Content -->
  <main id="main-content" class="flex-1" role="main">
    <slot />
  </main>
  
  <!-- Footer -->
  <footer class="bg-gray-900 text-white" role="contentinfo">
    <!-- Trust Badges -->
    <div class="border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div>
            <div class="text-accent text-2xl mb-2">★</div>
            <h3 class="font-semibold text-sm">{t(locale, 'trust.quality')}</h3>
            <p class="text-gray-400 text-xs mt-1">{t(locale, 'trust.qualityDesc')}</p>
          </div>
          <div>
            <div class="text-accent text-2xl mb-2">🔬</div>
            <h3 class="font-semibold text-sm">{t(locale, 'trust.lab')}</h3>
            <p class="text-gray-400 text-xs mt-1">{t(locale, 'trust.labDesc')}</p>
          </div>
          <div>
            <div class="text-accent text-2xl mb-2">🚚</div>
            <h3 class="font-semibold text-sm">{t(locale, 'trust.delivery')}</h3>
            <p class="text-gray-400 text-xs mt-1">{t(locale, 'trust.deliveryDesc')}</p>
          </div>
          <div>
            <div class="text-accent text-2xl mb-2">🇫🇷</div>
            <h3 class="font-semibold text-sm">{t(locale, 'trust.company')}</h3>
            <p class="text-gray-400 text-xs mt-1">{t(locale, 'trust.companyDesc')}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Payment Methods -->
    <div class="border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <span class="text-gray-400 text-xs font-medium uppercase tracking-wider">{locale === 'fr' ? 'Paiement sécurisé' : locale === 'de' ? 'Sichere Zahlung' : locale === 'es' ? 'Pago seguro' : locale === 'it' ? 'Pagamento sicuro' : locale === 'nl' ? 'Veilig betalen' : locale === 'fi' ? 'Turvallinen maksu' : locale === 'pt' ? 'Pagamento seguro' : 'Secure Payment'}</span>
          <div class="flex items-center gap-3 flex-wrap justify-center">
            <div class="bg-white rounded px-3 py-1.5 flex items-center gap-1.5">
              <svg class="h-5" viewBox="0 0 48 32" fill="none"><rect width="48" height="32" rx="4" fill="#1A1F71"/><path d="M19.5 21h-3l1.9-11.5h3L19.5 21zm12.7-11.2c-.6-.2-1.5-.5-2.7-.5-3 0-5.1 1.5-5.1 3.7 0 1.6 1.5 2.5 2.7 3.1 1.2.5 1.6.9 1.6 1.4 0 .7-.9 1.1-1.8 1.1-1.2 0-1.9-.2-2.9-.6l-.4-.2-.4 2.5c.7.3 2 .6 3.4.6 3.2 0 5.2-1.5 5.2-3.8 0-1.3-.8-2.2-2.5-3-1-.5-1.7-.9-1.7-1.4 0-.5.5-1 1.7-1 1 0 1.7.2 2.2.4l.3.1.4-2.4zm7.8-.3h-2.3c-.7 0-1.3.2-1.6.9L31.5 21h3.2l.6-1.8h3.9l.4 1.8H42l-2.5-11.5h-1.5zm-3.4 7.4l1.6-4.3.8 4.3h-2.4zM16 9.5l-2.8 7.9-.3-1.5c-.5-1.8-2.2-3.7-4-4.6l2.7 9.7h3.2l4.8-11.5H16z" fill="white"/><path d="M10.4 9.5H5.7l-.1.3c3.8.9 6.3 3.2 7.3 5.9l-1-5.3c-.2-.7-.7-.9-1.5-.9z" fill="#F9A533"/></svg>
              <span class="text-xs font-semibold text-gray-700">Visa</span>
            </div>
            <div class="bg-white rounded px-3 py-1.5 flex items-center gap-1.5">
              <svg class="h-5" viewBox="0 0 48 32" fill="none"><rect width="48" height="32" rx="4" fill="#252525"/><circle cx="19" cy="16" r="8" fill="#EB001B"/><circle cx="29" cy="16" r="8" fill="#F79E1B"/><path d="M24 10.3a8 8 0 010 11.4 8 8 0 000-11.4z" fill="#FF5F00"/></svg>
              <span class="text-xs font-semibold text-gray-700">Mastercard</span>
            </div>
            <div class="bg-white rounded px-3 py-1.5 flex items-center gap-1.5">
              <svg class="h-5" viewBox="0 0 48 32" fill="none"><rect width="48" height="32" rx="4" fill="#003087"/><path d="M18.3 10.5h-4.5c-.3 0-.6.2-.7.5l-1.8 11.5c0 .2.2.4.4.4h2.2c.3 0 .6-.2.7-.5l.5-3.1c0-.3.3-.5.6-.5h1.5c3 0 4.8-1.5 5.2-4.4.2-1.3 0-2.3-.5-3-.6-.6-1.7-1-3.6-1z" fill="white"/><path d="M32 10.5h-4.5c-.3 0-.6.2-.7.5l-1.8 11.5c0 .2.2.4.4.4h2.3c.2 0 .4-.2.5-.4l.5-3.2c0-.3.3-.5.6-.5h1.5c3 0 4.8-1.5 5.2-4.4.2-1.3 0-2.3-.5-3-.6-.6-1.7-1-3.5-1z" fill="#B3D7F5"/></svg>
              <span class="text-xs font-semibold text-gray-700">PayPal</span>
            </div>
            <div class="bg-white rounded px-3 py-1.5 flex items-center gap-1">
              <svg class="h-5" viewBox="0 0 24 24" fill="none"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z" fill="#34A853"/><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10" fill="none" stroke="#4285F4" stroke-width="1"/></svg>
              <span class="text-xs font-semibold text-gray-700">Bank Transfer</span>
            </div>
            <div class="bg-gray-800 border border-gray-600 rounded px-3 py-1.5 flex items-center gap-1.5">
              <svg class="h-4 w-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              <span class="text-xs font-semibold text-gray-300">SSL 256-bit</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-8">
        <!-- Brand -->
        <div>
          <h2 class="text-xl font-bold mb-4">Greens Farmhouse</h2>
          <p class="text-gray-400 text-sm leading-relaxed">
            {t(locale, 'footer.brandDesc')}
