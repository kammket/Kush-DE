  <!-- Mobile Menu Script -->
  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      const isOpen = !menu?.classList.contains('hidden');
      menu?.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  </script>

  <!-- Product Search Index & Script -->
  <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
  <script>
    function initSearch() {
      const toggle = document.getElementById('search-toggle');
      const panel = document.getElementById('search-panel');
      const input = document.getElementById('search-input') as HTMLInputElement | null;
      const results = document.getElementById('search-results');
      const indexEl = document.getElementById('search-index');
      if (!toggle || !panel || !input || !results || !indexEl) return;

      const items: { n: string; s: string; c: string; i: string }[] = JSON.parse(indexEl.textContent || '[]');
      const prefix = panel.dataset.localePrefix || '';
      const noResults = panel.dataset.noResults || 'No products found';

      function close() {
        panel!.classList.add('hidden');
        results!.classList.add('hidden');
        toggle!.setAttribute('aria-expanded', 'false');
      }

      toggle.addEventListener('click', () => {
        const isOpen = !panel.classList.contains('hidden');
        if (isOpen) { close(); return; }
        panel.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        input.focus();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });

      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        if (q.length < 2) { results.classList.add('hidden'); return; }
        const matches = items.filter(it =>
          it.n.toLowerCase().includes(q) || it.c.toLowerCase().includes(q)
        ).slice(0, 8);
        results.innerHTML = matches.length === 0
          ? `<p class="px-4 py-3 text-sm text-gray-500">${noResults}</p>`
          : matches.map(it => `
            <a href="${prefix}/products/${it.s}" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 transition-colors">
              <img src="${it.i}" alt="" width="40" height="40" class="w-10 h-10 rounded-md object-cover border border-gray-100" loading="lazy" />
              <span class="min-w-0">
                <span class="block text-sm font-medium text-gray-900 truncate">${it.n}</span>
                <span class="block text-xs text-gray-500">${it.c}</span>
              </span>
            </a>`).join('');
        results.classList.remove('hidden');
      });
    }
    initSearch();
    document.addEventListener('astro:after-swap', initSearch);
  </script>

  <!-- Cart Badge Script -->
  <script>
    import { getCartCount } from '../scripts/cart';

    function updateBadge() {
      const count = getCartCount();
      const badges = document.querySelectorAll('#cart-badge, #cart-badge-mobile');
      badges.forEach(badge => {
        if (count > 0) {
          badge.classList.remove('hidden');
          badge.textContent = String(count > 99 ? '99+' : count);
        } else {
          badge.classList.add('hidden');
        }
      });
    }

    updateBadge();
    window.addEventListener('cart:updated', updateBadge);
    document.addEventListener('astro:after-swap', updateBadge);
  </script>

