---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import TrustStrip from '../components/TrustStrip.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CompareBar from '../components/CompareBar.astro';
import { defaultLocale, allLocales, localeOgLocale, type Locale } from '../i18n/config';
import { t, getLocalePath, getPathWithoutLocale, getAbsoluteLocaleUrl } from '../i18n/utils';
import { products } from '../data/products';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object;
  noindex?: boolean;
  noHreflang?: boolean;
  /**
   * Locales this page actually exists in. Defaults to every locale.
   * Pass a subset for partially-translated pages — declaring an alternate for a
   * URL that does not exist is worse than declaring none at all.
   */
  hreflangLocales?: readonly Locale[];
  /** Locales the language switcher may offer. Defaults to the hreflang set. */
  availableLocales?: readonly Locale[];
}

const {
  title,
  description,
  locale = defaultLocale as Locale,
  canonicalURL = Astro.url.href,
  ogImage = 'https://greensfarmhouse.com/images/og-default.jpg',
  ogType = 'website',
  jsonLd,
  noindex = false,
  noHreflang = false,
  hreflangLocales = allLocales,
  availableLocales = hreflangLocales,
} = Astro.props;

const siteName = 'Greens Farmhouse';
// Google truncates titles around 60 characters. Only append the brand suffix when
// the result still fits, so long keyword-bearing titles are not cut off mid-phrase.
const titleSuffix = ` | ${siteName}`;
const TITLE_MAX = 60;
const fullTitle = title.includes(siteName)
  ? title
  : title.length + titleSuffix.length <= TITLE_MAX
    ? `${title}${titleSuffix}`
    : title;
const currentPath = getPathWithoutLocale(Astro.url.pathname);
const lp = (path: string) => getLocalePath(path, locale);
const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + '/');

// Header nav: category dropdowns with top products and related landing pages
const navCategories = [
  { slug: 'cbd-flowers', tKey: 'nav.flowers', related: [
    { path: '/wholesale-cbd-flowers-europe', tKey: 'footer.cbdFlowersEurope' },
    { path: '/cbd-flowers-bulk-europe', tKey: 'footer.cbdFlowersBulk' },
  ]},
  { slug: 'cbd-resins', tKey: 'nav.resins', related: [
    { path: '/cbd-wholesaler-organic', tKey: 'footer.organicCbd' },
    { path: '/cbd-in-tobacco-shops', tKey: 'footer.cbdTobacco' },
  ]},
  { slug: 'cbd-oils', tKey: 'nav.oils', related: [
    { path: '/cbd-wholesaler-organic', tKey: 'footer.organicCbd' },
  ]},
  { slug: 'cbd-gummies', tKey: 'nav.gummies', related: [
    { path: '/cbd-in-tobacco-shops', tKey: 'footer.cbdTobacco' },
  ]},
  { slug: 'thc-gummies', tKey: 'nav.thcGummies', related: [
    { path: '/legal', tKey: 'nav.legal' },
  ]},
].map(cat => ({
  ...cat,
  topProducts: products.filter(p => p.categorySlug === cat.slug && p.inStock).slice(0, 3),
}));

// Compact client-side search index (name, slug, category, image)
const searchIndex = products.map(p => ({ n: p.name, s: p.slug, c: p.category, i: p.image }));
const searchPlaceholders: Record<string, string> = {
  en: 'Search products…', fr: 'Rechercher des produits…', es: 'Buscar productos…',
  de: 'Produkte suchen…', it: 'Cerca prodotti…', nl: 'Producten zoeken…',
  fi: 'Etsi tuotteita…', pt: 'Pesquisar produtos…',
};
const searchNoResults: Record<string, string> = {
  en: 'No products found', fr: 'Aucun produit trouvé', es: 'No se encontraron productos',
  de: 'Keine Produkte gefunden', it: 'Nessun prodotto trovato', nl: 'Geen producten gevonden',
  fi: 'Tuotteita ei löytynyt', pt: 'Nenhum produto encontrado',
};
---

<!DOCTYPE html>
<html lang={locale} dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Primary Meta Tags -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Greens Farmhouse" />
  {/* `follow` so excluded pages still pass equity to the real content they link to */}
  {noindex && <meta name="robots" content="noindex, follow" />}
  {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Hreflang for all languages (language-only codes, matching the sitemap).
       Never emitted on noindex pages: declaring a language alternate for a page
       you have asked Google not to index is a contradictory signal. -->
  {!noHreflang && !noindex && hreflangLocales.map((loc) => (
    <link rel="alternate" hreflang={loc} href={getAbsoluteLocaleUrl(loc, currentPath)} />
  ))}
  {!noHreflang && !noindex && <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', currentPath)} />}
  
  <!-- Geo targeting -->
  <meta name="geo.region" content="FR" />
  <meta name="geo.placename" content="Paris, France" />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://greensfarmhouse.com${ogImage}`} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content={localeOgLocale[locale]} />
  {allLocales.filter(l => l !== locale).map(l => (
    <meta property="og:locale:alternate" content={localeOgLocale[l]} />
  ))}
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `https://greensfarmhouse.com${ogImage}`} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Greens Farmhouse Blog" href="/rss.xml" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  
  <!-- Self-hosted Inter font -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-variable-latin.woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/inter.css" />
  
  <!-- JSON-LD Structured Data -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  
  <!-- Organization Schema (always present) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Greens Farmhouse",
    "url": "https://greensfarmhouse.com",
    "logo": "https://greensfarmhouse.com/images/logo.png",
    "description": "N°1 Greens Farmhouse in France and Europe. Certified CBD wholesale supplier of flowers, resins, oils and edibles.",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "FR",
      "addressRegion": "Île-de-France"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+420722562271",
      "contactType": "sales",
      "email": "contact@greensfarmhouse.com",
      "availableLanguage": ["English", "French", "German", "Spanish", "Italian", "Dutch", "Portuguese", "Finnish"]
    }
  })} />
</head>
<body class="min-h-screen flex flex-col bg-white text-gray-900">
  <!-- Skip to main content (accessibility) -->
  <a href="#main-content" class="skip-link">Skip to main content</a>
  
  <!-- Utility / Announcement Bar -->
  <div class="bg-primary-dark text-white text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4 py-2">
      <div class="hidden md:flex items-center gap-4 text-xs whitespace-nowrap">
        <a href="tel:+420722562271" class="flex items-center gap-1.5 hover:text-accent transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          +420 722 562 271
        </a>
        <a href="https://wa.me/420722562271" target="_blank" rel="noopener" class="flex items-center gap-1.5 hover:text-accent transition-colors">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
      <a href={lp('/collections')} class="font-medium hover:underline text-center flex-1 md:flex-none truncate">
        {t(locale, 'announcement')}
      </a>
      <a href="mailto:contact@greensfarmhouse.com" class="hidden lg:flex items-center gap-1.5 text-xs hover:text-accent transition-colors whitespace-nowrap">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        contact@greensfarmhouse.com
      </a>
    </div>
  </div>
  
  <!-- Header -->
  <header class="sticky top-0 z-50 bg-white shadow-sm border-b border-gray-100" role="banner">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
      <div class="flex items-center justify-between h-16 md:h-20">
        <!-- Logo -->
        <a href={lp('/')} class="flex items-center gap-2 text-primary font-bold text-xl md:text-2xl">
          <svg class="w-8 h-8 md:w-10 md:h-10" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="20" cy="20" r="20" fill="currentColor"/>
            <text x="50%" y="55%" text-anchor="middle" fill="white" font-size="14" font-weight="bold" dy=".1em">CBD</text>
          </svg>
          <span>Greens Farmhouse</span>
        </a>
        
        <!-- Desktop Navigation -->
        <div class="hidden lg:flex items-center gap-6">
          {navCategories.map(cat => (
            <div class="relative group">
              <a
                href={lp(`/collections/${cat.slug}`)}
                aria-current={isActive(`/collections/${cat.slug}`) ? 'page' : undefined}
                class={`inline-flex items-center gap-1 font-medium transition-colors py-2 border-b-2 ${isActive(`/collections/${cat.slug}`) ? 'text-primary border-primary' : 'text-gray-700 border-transparent hover:text-primary'}`}
              >
                {t(locale, cat.tKey)}
                <svg class="w-3 h-3 text-gray-400 group-hover:text-primary transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </a>
              <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-1/2 -translate-x-1/2 top-full pt-2 z-50">
                <div class="w-72 bg-white rounded-xl shadow-xl border border-gray-100 p-4">
                  <ul class="space-y-1 mb-3">
                    {cat.topProducts.map(p => (
                      <li>
                        <a href={lp(`/products/${p.slug}`)} class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 transition-colors">
                          <img src={p.image} alt="" width="40" height="40" class="w-10 h-10 rounded-md object-cover border border-gray-100" loading="lazy" decoding="async" />
                          <span class="min-w-0">
                            <span class="block text-sm font-medium text-gray-900 truncate">{p.name}</span>
                            <span class="block text-xs text-primary font-semibold">{p.price}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  {cat.related.length > 0 && (
                    <div class="border-t border-gray-100 pt-2 mb-2">
                      {cat.related.map(r => (
                        <a href={lp(r.path)} class="block px-2 py-1.5 text-xs text-gray-600 hover:text-primary rounded transition-colors">{t(locale, r.tKey)} →</a>
                      ))}
                    </div>
                  )}
                  <a href={lp(`/collections/${cat.slug}`)} class="block text-center bg-primary/5 text-primary text-sm font-semibold px-3 py-2 rounded-lg hover:bg-primary/10 transition-colors">
                    {t(locale, cat.tKey)} →
                  </a>
                </div>
              </div>
            </div>
          ))}
          <a href={lp('/blog')} aria-current={isActive('/blog') ? 'page' : undefined} class={`font-medium transition-colors py-2 border-b-2 ${isActive('/blog') ? 'text-primary border-primary' : 'text-gray-700 border-transparent hover:text-primary'}`}>{t(locale, 'nav.blog')}</a>
          <a href={lp('/about')} aria-current={isActive('/about') ? 'page' : undefined} class={`font-medium transition-colors py-2 border-b-2 ${isActive('/about') ? 'text-primary border-primary' : 'text-gray-700 border-transparent hover:text-primary'}`}>{t(locale, 'nav.about')}</a>
        </div>
        
        <!-- Right Side -->
        <div class="flex items-center gap-3">
          <!-- Search -->
          <button
            id="search-toggle"
            type="button"
            class="p-2 rounded-lg hover:bg-gray-100 transition-colors"
            aria-label="Search products"
            aria-expanded="false"
            aria-controls="search-panel"
          >
            <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </button>

          <!-- Language Switcher -->
          <LanguageSwitcher locale={locale} availableLocales={availableLocales} />

          <!-- Cart Icon -->
          <a href={lp('/cart')} class="relative p-2 rounded-lg hover:bg-gray-100 transition-colors" aria-label={t(locale, 'nav.cart')}>
            <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
            </svg>
            <span id="cart-badge" class="hidden absolute -top-0.5 -right-0.5 bg-red-600 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">0</span>
          </a>

          <a href={lp('/contact')} class="hidden md:inline-flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-lg font-medium hover:bg-primary-dark transition-colors text-sm">
            {t(locale, 'common.contactUs')}
          </a>
          
          <!-- Mobile Menu Button -->
          <button 
            id="mobile-menu-btn"
            class="lg:hidden p-2 rounded-lg hover:bg-gray-100 transition-colors" 
            aria-label="Toggle mobile menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Search Panel -->
      <div id="search-panel" class="hidden pb-4 border-t border-gray-100" data-locale-prefix={locale === 'en' ? '' : `/${locale}`} data-no-results={searchNoResults[locale] || searchNoResults.en}>
        <div class="relative pt-3 max-w-2xl mx-auto">
          <svg class="absolute left-3 top-1/2 mt-1.5 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input
            id="search-input"
            type="search"
            placeholder={searchPlaceholders[locale] || searchPlaceholders.en}
            autocomplete="off"
            class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
          />
          <div id="search-results" class="hidden absolute left-0 right-0 top-full mt-2 bg-white rounded-xl shadow-xl border border-gray-100 max-h-96 overflow-y-auto z-50"></div>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="lg:hidden hidden pb-4 border-t border-gray-100" role="navigation" aria-label="Mobile navigation">
        <div class="flex flex-col gap-2 pt-4">
          <a href={lp('/collections/cbd-flowers')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.flowers')}</a>
          <a href={lp('/collections/cbd-resins')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.resins')}</a>
          <a href={lp('/collections/cbd-oils')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.oils')}</a>
          <a href={lp('/collections/cbd-gummies')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.gummies')}</a>
          <a href={lp('/collections/thc-gummies')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.thcGummies')}</a>
          <a href={lp('/blog')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.blog')}</a>
          <a href={lp('/about')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium">{t(locale, 'nav.about')}</a>
          <a href={lp('/cart')} class="px-4 py-2 text-gray-700 hover:bg-gray-50 rounded-lg font-medium flex items-center gap-2">
            {t(locale, 'nav.cart')} <span id="cart-badge-mobile" class="hidden bg-red-600 text-white text-xs font-bold w-5 h-5 rounded-full inline-flex items-center justify-center">0</span>
          </a>
          <a href={lp('/contact')} class="mx-4 mt-2 text-center bg-primary text-white px-4 py-2 rounded-lg font-medium">{t(locale, 'common.contactUs')}</a>
        </div>
      </div>
    </nav>
  </header>

  <!-- Trust Strip -->
  <TrustStrip locale={locale} />
  
  <!-- Main Content -->
  <main id="main-content" class="flex-1" role="main">
    <slot />
  </main>
  
  <!-- Footer -->
  <footer class="bg-gray-900 text-white" role="contentinfo">
    <!-- Trust Badges -->
    <div class="border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div>
            <div class="text-accent text-2xl mb-2">★</div>
            <h3 class="font-semibold text-sm">{t(locale, 'trust.quality')}</h3>
            <p class="text-gray-400 text-xs mt-1">{t(locale, 'trust.qualityDesc')}</p>
          </div>
          <div>
            <div class="text-accent text-2xl mb-2">🔬</div>
            <h3 class="font-semibold text-sm">{t(locale, 'trust.lab')}</h3>
            <p class="text-gray-400 text-xs mt-1">{t(locale, 'trust.labDesc')}</p>
          </div>
          <div>
            <div class="text-accent text-2xl mb-2">🚚</div>
            <h3 class="font-semibold text-sm">{t(locale, 'trust.delivery')}</h3>
            <p class="text-gray-400 text-xs mt-1">{t(locale, 'trust.deliveryDesc')}</p>
          </div>
          <div>
            <div class="text-accent text-2xl mb-2">🇫🇷</div>
            <h3 class="font-semibold text-sm">{t(locale, 'trust.company')}</h3>
            <p class="text-gray-400 text-xs mt-1">{t(locale, 'trust.companyDesc')}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Payment Methods -->
    <div class="border-b border-gray-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <span class="text-gray-400 text-xs font-medium uppercase tracking-wider">{locale === 'fr' ? 'Paiement sécurisé' : locale === 'de' ? 'Sichere Zahlung' : locale === 'es' ? 'Pago seguro' : locale === 'it' ? 'Pagamento sicuro' : locale === 'nl' ? 'Veilig betalen' : locale === 'fi' ? 'Turvallinen maksu' : locale === 'pt' ? 'Pagamento seguro' : 'Secure Payment'}</span>
          <div class="flex items-center gap-3 flex-wrap justify-center">
            <div class="bg-white rounded px-3 py-1.5 flex items-center gap-1.5">
