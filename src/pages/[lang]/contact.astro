---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { supportedLocales, type Locale } from '../../i18n/config';
import { t, getLocalePath, getAbsoluteLocaleUrl } from '../../i18n/utils';

export function getStaticPaths() {
  return supportedLocales.map(lang => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const locale = lang as Locale;
const lp = (path: string) => getLocalePath(path, locale);

const translations: Record<string, any> = {
  es: { title: 'Contacto | Greens Farmhouse', description: 'Contacte con Greens Farmhouse para consultas de mayoristas CBD, presupuestos y soporte.', heroTitle: 'Póngase en Contacto', heroDesc: '¿Tiene preguntas sobre nuestros productos CBD al por mayor? ¿Necesita un presupuesto personalizado? Nuestro equipo está aquí para ayudarle.', contactInfo: 'Información de Contacto', phone: 'Teléfono', email: 'Email', whatsapp: 'WhatsApp', chatWhatsApp: 'Chatear en WhatsApp', fastestWay: 'Forma más rápida de contactarnos', monFri: 'Lun-Vie, 9:00–18:00 CET', replyTime: 'Respondemos en 24 horas', wholesaleTitle: 'Consultas Mayoristas', wholesale1: 'Presupuestos personalizados para pedidos grandes', wholesale2: 'Marca blanca y etiquetado privado', wholesale3: 'Descuentos por volumen disponibles', wholesale4: 'Muestras gratuitas para compradores cualificados', firstName: 'Nombre *', lastName: 'Apellido *', emailLabel: 'Correo Electrónico *', phoneLabel: 'Teléfono', company: 'Nombre de Empresa', subject: 'Asunto *', selectSubject: 'Seleccione un asunto...', wholesaleQuote: 'Solicitud de Presupuesto Mayorista', productInfo: 'Información de Producto', orderSupport: 'Soporte de Pedido', shippingOption: 'Envío y Entrega', whiteLabel: 'Marca Blanca', partnership: 'Consulta de Asociación', other: 'Otros', message: 'Mensaje *', messagePlaceholder: 'Cuéntenos sus necesidades, cantidades y requisitos específicos...', consent: 'Acepto el procesamiento de mis datos personales de acuerdo con la', privacyPolicy: 'Política de Privacidad', sendMessage: 'Enviar Mensaje' },
  fr: { title: 'Contact | Greens Farmhouse', description: 'Contactez Greens Farmhouse pour demandes grossiste CBD, devis et support.', heroTitle: 'Contactez-Nous', heroDesc: 'Des questions sur nos produits CBD en gros ? Besoin d\'un devis sur mesure ? Notre équipe est là pour vous aider.', contactInfo: 'Informations de Contact', phone: 'Téléphone', email: 'Email', whatsapp: 'WhatsApp', chatWhatsApp: 'Discuter sur WhatsApp', fastestWay: 'Le moyen le plus rapide', monFri: 'Lun-Ven, 9h00–18h00 CET', replyTime: 'Réponse sous 24 heures', wholesaleTitle: 'Demandes Grossiste', wholesale1: 'Devis personnalisés pour commandes en gros', wholesale2: 'Marque blanche et étiquetage privé', wholesale3: 'Remises sur volume disponibles', wholesale4: 'Échantillons gratuits pour acheteurs qualifiés', firstName: 'Prénom *', lastName: 'Nom *', emailLabel: 'Adresse Email *', phoneLabel: 'Téléphone', company: 'Nom de l\'Entreprise', subject: 'Sujet *', selectSubject: 'Sélectionnez un sujet...', wholesaleQuote: 'Demande de Devis Grossiste', productInfo: 'Information Produit', orderSupport: 'Support Commande', shippingOption: 'Livraison', whiteLabel: 'Marque Blanche', partnership: 'Demande de Partenariat', other: 'Autre', message: 'Message *', messagePlaceholder: 'Parlez-nous de vos besoins, quantités et exigences spécifiques...', consent: 'J\'accepte le traitement de mes données personnelles conformément à la', privacyPolicy: 'Politique de Confidentialité', sendMessage: 'Envoyer le Message' },
  de: { title: 'Kontakt | Greens Farmhouse', description: 'Kontaktieren Sie Greens Farmhouse für CBD-Großhandelsanfragen, Angebote und Support.', heroTitle: 'Kontaktieren Sie Uns', heroDesc: 'Fragen zu unseren CBD-Großhandelsprodukten? Benötigen Sie ein individuelles Angebot? Unser Team hilft Ihnen gerne.', contactInfo: 'Kontaktinformationen', phone: 'Telefon', email: 'E-Mail', whatsapp: 'WhatsApp', chatWhatsApp: 'Auf WhatsApp chatten', fastestWay: 'Schnellster Kontaktweg', monFri: 'Mo-Fr, 9:00–18:00 CET', replyTime: 'Antwort innerhalb 24 Stunden', wholesaleTitle: 'Großhandelsanfragen', wholesale1: 'Individuelle Angebote für Großbestellungen', wholesale2: 'White-Label und Private Labeling', wholesale3: 'Mengenrabatte verfügbar', wholesale4: 'Kostenlose Proben für qualifizierte Käufer', firstName: 'Vorname *', lastName: 'Nachname *', emailLabel: 'E-Mail-Adresse *', phoneLabel: 'Telefon', company: 'Firmenname', subject: 'Betreff *', selectSubject: 'Betreff auswählen...', wholesaleQuote: 'Großhandelsangebotsanfrage', productInfo: 'Produktinformation', orderSupport: 'Bestellunterstützung', shippingOption: 'Versand & Lieferung', whiteLabel: 'White Label', partnership: 'Partnerschaftsanfrage', other: 'Sonstiges', message: 'Nachricht *', messagePlaceholder: 'Erzählen Sie uns von Ihren Bedürfnissen, Mengen und speziellen Anforderungen...', consent: 'Ich stimme der Verarbeitung meiner persönlichen Daten gemäß der', privacyPolicy: 'Datenschutzrichtlinie', sendMessage: 'Nachricht Senden' },
  nl: { title: 'Contact | Greens Farmhouse', description: 'Neem contact op met Greens Farmhouse voor CBD-groothandelvragen, offertes en ondersteuning.', heroTitle: 'Neem Contact Op', heroDesc: 'Vragen over onze CBD-groothandelsproducten? Een offerte op maat nodig? Ons team helpt u graag.', contactInfo: 'Contactinformatie', phone: 'Telefoon', email: 'E-mail', whatsapp: 'WhatsApp', chatWhatsApp: 'Chat op WhatsApp', fastestWay: 'Snelste manier', monFri: 'Ma-Vr, 9:00–18:00 CET', replyTime: 'Antwoord binnen 24 uur', wholesaleTitle: 'Groothandelvragen', wholesale1: 'Offertes op maat voor grote bestellingen', wholesale2: 'White-label en private labeling', wholesale3: 'Volumekortingen beschikbaar', wholesale4: 'Gratis monsters voor gekwalificeerde kopers', firstName: 'Voornaam *', lastName: 'Achternaam *', emailLabel: 'E-mailadres *', phoneLabel: 'Telefoon', company: 'Bedrijfsnaam', subject: 'Onderwerp *', selectSubject: 'Selecteer een onderwerp...', wholesaleQuote: 'Offerte Aanvraag', productInfo: 'Productinformatie', orderSupport: 'Bestellingondersteuning', shippingOption: 'Verzending & Levering', whiteLabel: 'White Label', partnership: 'Partnerschapsaanvraag', other: 'Anders', message: 'Bericht *', messagePlaceholder: 'Vertel ons over uw behoeften, hoeveelheden en specifieke wensen...', consent: 'Ik ga akkoord met de verwerking van mijn persoonsgegevens overeenkomstig het', privacyPolicy: 'Privacybeleid', sendMessage: 'Bericht Verzenden' },
  it: { title: 'Contatti | Greens Farmhouse', description: 'Contatta Greens Farmhouse per richieste grossista CBD, preventivi e supporto.', heroTitle: 'Contattaci', heroDesc: 'Domande sui nostri prodotti CBD all\'ingrosso? Hai bisogno di un preventivo personalizzato? Il nostro team è qui per aiutarti.', contactInfo: 'Informazioni di Contatto', phone: 'Telefono', email: 'Email', whatsapp: 'WhatsApp', chatWhatsApp: 'Chatta su WhatsApp', fastestWay: 'Il modo più rapido', monFri: 'Lun-Ven, 9:00–18:00 CET', replyTime: 'Rispondiamo entro 24 ore', wholesaleTitle: 'Richieste all\'Ingrosso', wholesale1: 'Preventivi personalizzati per ordini grandi', wholesale2: 'White-label ed etichettatura privata', wholesale3: 'Sconti quantità disponibili', wholesale4: 'Campioni gratuiti per acquirenti qualificati', firstName: 'Nome *', lastName: 'Cognome *', emailLabel: 'Indirizzo Email *', phoneLabel: 'Telefono', company: 'Nome Azienda', subject: 'Oggetto *', selectSubject: 'Seleziona un oggetto...', wholesaleQuote: 'Richiesta Preventivo', productInfo: 'Informazioni Prodotto', orderSupport: 'Supporto Ordini', shippingOption: 'Spedizione e Consegna', whiteLabel: 'White Label', partnership: 'Richiesta Partnership', other: 'Altro', message: 'Messaggio *', messagePlaceholder: 'Raccontaci le tue esigenze, quantità e requisiti specifici...', consent: 'Acconsento al trattamento dei miei dati personali in conformità con la', privacyPolicy: 'Privacy Policy', sendMessage: 'Invia Messaggio' },
  fi: { title: 'Yhteystiedot | Greens Farmhouse', description: 'Ota yhteyttä Greens Farmhouseiin CBD-tukkukyselyihin, tarjouksiin ja tukeen.', heroTitle: 'Ota Yhteyttä', heroDesc: 'Kysymyksiä CBD-tukkutuotteistamme? Tarvitsetko räätälöidyn tarjouksen? Tiimimme auttaa mielellään.', contactInfo: 'Yhteystiedot', phone: 'Puhelin', email: 'Sähköposti', whatsapp: 'WhatsApp', chatWhatsApp: 'Chattaa WhatsAppissa', fastestWay: 'Nopein tapa', monFri: 'Ma-Pe, 9:00–18:00 CET', replyTime: 'Vastaamme 24 tunnissa', wholesaleTitle: 'Tukkukyselyt', wholesale1: 'Räätälöidyt tarjoukset suurtilauksiin', wholesale2: 'White-label ja private labeling', wholesale3: 'Määräalennukset saatavilla', wholesale4: 'Ilmaiset näytteet päteville ostajille', firstName: 'Etunimi *', lastName: 'Sukunimi *', emailLabel: 'Sähköpostiosoite *', phoneLabel: 'Puhelin', company: 'Yrityksen Nimi', subject: 'Aihe *', selectSubject: 'Valitse aihe...', wholesaleQuote: 'Tukkutarjouspyyntö', productInfo: 'Tuotetiedot', orderSupport: 'Tilaustuki', shippingOption: 'Toimitus', whiteLabel: 'White Label', partnership: 'Yhteistyökysely', other: 'Muu', message: 'Viesti *', messagePlaceholder: 'Kerro tarpeistasi, määristä ja erityisvaatimuksista...', consent: 'Hyväksyn henkilötietojeni käsittelyn', privacyPolicy: 'tietosuojakäytännön', sendMessage: 'Lähetä Viesti' },
  pt: { title: 'Contacto | Greens Farmhouse', description: 'Contacte Greens Farmhouse para consultas grossista CBD, orçamentos e suporte.', heroTitle: 'Entre em Contacto', heroDesc: 'Tem perguntas sobre os nossos produtos CBD por grosso? Precisa de um orçamento personalizado? A nossa equipa está aqui para ajudar.', contactInfo: 'Informação de Contacto', phone: 'Telefone', email: 'Email', whatsapp: 'WhatsApp', chatWhatsApp: 'Conversar no WhatsApp', fastestWay: 'Forma mais rápida', monFri: 'Seg-Sex, 9:00–18:00 CET', replyTime: 'Respondemos em 24 horas', wholesaleTitle: 'Consultas Grossista', wholesale1: 'Orçamentos personalizados para grandes encomendas', wholesale2: 'Marca branca e etiquetagem privada', wholesale3: 'Descontos de volume disponíveis', wholesale4: 'Amostras grátis para compradores qualificados', firstName: 'Primeiro Nome *', lastName: 'Apelido *', emailLabel: 'Endereço de Email *', phoneLabel: 'Telefone', company: 'Nome da Empresa', subject: 'Assunto *', selectSubject: 'Selecione um assunto...', wholesaleQuote: 'Pedido de Orçamento Grossista', productInfo: 'Informação de Produto', orderSupport: 'Suporte de Encomenda', shippingOption: 'Envio e Entrega', whiteLabel: 'Marca Branca', partnership: 'Consulta de Parceria', other: 'Outro', message: 'Mensagem *', messagePlaceholder: 'Conte-nos sobre as suas necessidades, quantidades e requisitos específicos...', consent: 'Concordo com o processamento dos meus dados pessoais de acordo com a', privacyPolicy: 'Política de Privacidade', sendMessage: 'Enviar Mensagem' },
};

const tr = translations[locale] || {};

const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: lp('/') },
  { name: t(locale, 'nav.contact') },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": tr.title,
  "description": tr.description,
  "url": getAbsoluteLocaleUrl(locale, '/contact'),
  "inLanguage": locale,
  "mainEntity": {
    "@type": "Organization",
    "name": "Greens Farmhouse",
    "url": "https://greensfarmhouse.com",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+33-1-88-81-21-99",
      "contactType": "sales",
      "email": "contact@greensfarmhouse.com",
      "availableLanguage": ["English", "French", "German", "Spanish", "Italian", "Dutch", "Portuguese", "Finnish"]
    }
  }
};
---

<BaseLayout title={tr.title} description={tr.description} locale={locale} jsonLd={jsonLd}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><Breadcrumbs items={breadcrumbs} /></div>

  <section class="py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">{tr.heroTitle}</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">{tr.heroDesc}</p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1 space-y-6">
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">{tr.contactInfo}</h2>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">{tr.phone}</p>
                  <a href="tel:+447346989289" class="text-sm text-primary hover:underline">+44 7346 989289</a>
                  <p class="text-xs text-gray-500 mt-1">{tr.monFri}</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">{tr.email}</p>
                  <a href="mailto:contact@greensfarmhouse.com" class="text-sm text-primary hover:underline break-all">contact@greensfarmhouse.com</a>
                  <p class="text-xs text-gray-500 mt-1">{tr.replyTime}</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">{tr.whatsapp}</p>
                  <a href="https://wa.me/447346989289" class="text-sm text-primary hover:underline" target="_blank" rel="noopener">{tr.chatWhatsApp}</a>
                  <p class="text-xs text-gray-500 mt-1">{tr.fastestWay}</p>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-primary/5 rounded-xl p-6">
            <h3 class="font-bold text-gray-900 mb-3">{tr.wholesaleTitle}</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              {[tr.wholesale1, tr.wholesale2, tr.wholesale3, tr.wholesale4].map((item: string) => (
                <li class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="lg:col-span-2">
          <form class="bg-white rounded-xl border border-gray-200 p-6 md:p-8 space-y-6" id="contact-form">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-semibold text-gray-900 mb-1">{tr.firstName}</label>
                <input type="text" id="first-name" name="first-name" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition" />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-semibold text-gray-900 mb-1">{tr.lastName}</label>
                <input type="text" id="last-name" name="last-name" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition" />
              </div>
            </div>
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-sm font-semibold text-gray-900 mb-1">{tr.emailLabel}</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold text-gray-900 mb-1">{tr.phoneLabel}</label>
                <input type="tel" id="phone" name="phone" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition" />
              </div>
            </div>
            <div>
              <label for="company" class="block text-sm font-semibold text-gray-900 mb-1">{tr.company}</label>
              <input type="text" id="company" name="company" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition" />
            </div>
            <div>
              <label for="subject" class="block text-sm font-semibold text-gray-900 mb-1">{tr.subject}</label>
              <select id="subject" name="subject" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition bg-white">
                <option value="">{tr.selectSubject}</option>
                <option value="wholesale-quote">{tr.wholesaleQuote}</option>
                <option value="product-info">{tr.productInfo}</option>
                <option value="order-support">{tr.orderSupport}</option>
                <option value="shipping">{tr.shippingOption}</option>
                <option value="white-label">{tr.whiteLabel}</option>
                <option value="partnership">{tr.partnership}</option>
                <option value="other">{tr.other}</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-gray-900 mb-1">{tr.message}</label>
              <textarea id="message" name="message" required rows="5" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition resize-y" placeholder={tr.messagePlaceholder}></textarea>
            </div>
            <div class="flex items-start gap-2">
              <input type="checkbox" id="consent" name="consent" required class="mt-1 rounded border-gray-300 text-primary focus:ring-primary" />
              <label for="consent" class="text-xs text-gray-600">{tr.consent} <a href={lp('/privacy')} class="text-primary hover:underline">{tr.privacyPolicy}</a>. *</label>
            </div>
            <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 bg-primary text-white font-semibold rounded-full hover:bg-primary/90 transition">
              {tr.sendMessage}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
