const tr = translations[locale] || {};

const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: getLocalePath('/', locale) },
  { name: t(locale, 'nav.legal') },
];
---

<BaseLayout title={tr.title} description={tr.desc} locale={locale}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8"><Breadcrumbs items={breadcrumbs} /></div>

  <section class="py-10 md:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-8">{tr.h1}</h1>
      <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
        <h2>{tr.company}</h2>
        <p><strong>Greens Farmhouse</strong><br />Website: <a href="https://greensfarmhouse.com">https://greensfarmhouse.com</a><br />Email: <a href="mailto:contact@greensfarmhouse.com">contact@greensfarmhouse.com</a><br />Phone: <a href="tel:+420722562271">+420 722 562 271</a></p>
        <h2>{tr.terms}</h2>
        <p>{tr.termsDesc}</p>
        <h3>{tr.age}</h3>
        <p>{tr.ageDesc}</p>
        <h3>{tr.pro}</h3>
        <p>{tr.proDesc}</p>
        <h2>{tr.productInfo}</h2>
        <p>{tr.productDesc}</p>
        <h2>{tr.ip}</h2>
        <p>{tr.ipDesc}</p>
        <h2>{tr.liability}</h2>
        <p>{tr.liabilityDesc}</p>
        <h2>{tr.law}</h2>
        <p>{tr.lawDesc}</p>
        <h2>{tr.contactQ}</h2>
        <p>{tr.contactQDesc} <a href="mailto:contact@greensfarmhouse.com">contact@greensfarmhouse.com</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
