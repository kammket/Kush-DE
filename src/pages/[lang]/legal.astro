  fr: { title: 'Mentions Légales | Greens Farmhouse', desc: 'Mentions légales et conditions d\'utilisation du site Greens Farmhouse.', h1: 'Mentions Légales', company: 'Informations sur l\'Entreprise', terms: 'Conditions d\'Utilisation', termsDesc: 'En accédant et en utilisant ce site web, vous acceptez et vous engagez à respecter ces conditions.', age: 'Restriction d\'Âge', ageDesc: 'Ce site web et ses produits sont destinés aux personnes âgées de 18 ans et plus.', pro: 'Usage Professionnel', proDesc: 'Greens Farmhouse est un fournisseur grossiste B2B. Nos produits sont destinés aux acheteurs professionnels et entreprises du secteur CBD.', productInfo: 'Information Produit', productDesc: 'Tous les produits sont conformes aux réglementations de l\'Union européenne. Nos produits CBD contiennent moins de 0,3% de THC.', ip: 'Propriété Intellectuelle', ipDesc: 'Tout le contenu de ce site est la propriété de Greens Farmhouse et est protégé par les lois sur la propriété intellectuelle.', liability: 'Limitation de Responsabilité', liabilityDesc: 'Greens Farmhouse ne sera pas responsable des dommages directs, indirects ou consécutifs résultant de l\'utilisation de ce site.', law: 'Droit Applicable', lawDesc: 'Ces conditions sont régies par le droit français. Tout litige sera soumis aux tribunaux français.', contactQ: 'Contact', contactQDesc: 'Pour toute question concernant ces mentions légales, contactez-nous.' },
  de: { title: 'Impressum | Greens Farmhouse', desc: 'Impressum und Nutzungsbedingungen der Website Greens Farmhouse.', h1: 'Impressum', company: 'Unternehmensinformationen', terms: 'Nutzungsbedingungen', termsDesc: 'Durch den Zugang und die Nutzung dieser Website akzeptieren Sie diese Bedingungen.', age: 'Altersbeschränkung', ageDesc: 'Diese Website und ihre Produkte sind für Personen ab 18 Jahren bestimmt.', pro: 'Professionelle Nutzung', proDesc: 'Greens Farmhouse ist ein B2B-Großhändler. Unsere Produkte sind für professionelle Käufer und Unternehmen der CBD-Branche bestimmt.', productInfo: 'Produktinformationen', productDesc: 'Alle Produkte entsprechen den EU-Vorschriften. Unsere CBD-Produkte enthalten weniger als 0,3% THC.', ip: 'Geistiges Eigentum', ipDesc: 'Alle Inhalte dieser Website sind Eigentum von Greens Farmhouse und durch Urheberrecht geschützt.', liability: 'Haftungsbeschränkung', liabilityDesc: 'Greens Farmhouse haftet nicht für direkte, indirekte oder Folgeschäden aus der Nutzung dieser Website.', law: 'Anwendbares Recht', lawDesc: 'Diese Bedingungen unterliegen französischem Recht. Streitigkeiten unterliegen der französischen Gerichtsbarkeit.', contactQ: 'Kontakt', contactQDesc: 'Bei Fragen zu diesen rechtlichen Bedingungen kontaktieren Sie uns.' },
  nl: { title: 'Juridische Kennisgeving | Greens Farmhouse', desc: 'Juridische kennisgeving en gebruiksvoorwaarden van de website Greens Farmhouse.', h1: 'Juridische Kennisgeving', company: 'Bedrijfsinformatie', terms: 'Gebruiksvoorwaarden', termsDesc: 'Door deze website te bezoeken en te gebruiken, aanvaardt u deze voorwaarden.', age: 'Leeftijdsbeperking', ageDesc: 'Deze website en producten zijn bedoeld voor personen van 18 jaar en ouder.', pro: 'Professioneel Gebruik', proDesc: 'Greens Farmhouse is een B2B-groothandel. Onze producten zijn bestemd voor professionele kopers en CBD-bedrijven.', productInfo: 'Productinformatie', productDesc: 'Alle producten voldoen aan de EU-regelgeving. Onze CBD-producten bevatten minder dan 0,3% THC.', ip: 'Intellectueel Eigendom', ipDesc: 'Alle inhoud op deze website is eigendom van Greens Farmhouse en beschermd door auteursrecht.', liability: 'Aansprakelijkheidsbeperking', liabilityDesc: 'Greens Farmhouse is niet aansprakelijk voor directe, indirecte of gevolgschade uit het gebruik van deze website.', law: 'Toepasselijk Recht', lawDesc: 'Deze voorwaarden zijn onderworpen aan Frans recht en de exclusieve bevoegdheid van Franse rechtbanken.', contactQ: 'Contact', contactQDesc: 'Voor vragen over deze juridische voorwaarden, neem contact op.' },
