  fi: { title: 'Oikeudellinen Ilmoitus | Greens Farmhouse', desc: 'Greens Farmhousein verkkosivuston oikeudellinen ilmoitus ja käyttöehdot.', h1: 'Oikeudellinen Ilmoitus', company: 'Yrityksen Tiedot', terms: 'Käyttöehdot', termsDesc: 'Käyttämällä tätä verkkosivustoa hyväksyt nämä ehdot.', age: 'Ikäraja', ageDesc: 'Tämä verkkosivusto ja sen tuotteet on tarkoitettu vähintään 18-vuotiaille.', pro: 'Ammattimainen Käyttö', proDesc: 'Greens Farmhouse on B2B-tukkumyyjä. Tuotteemme on tarkoitettu ammattimaisille ostajille ja CBD-alan yrityksille.', productInfo: 'Tuotetiedot', productDesc: 'Kaikki tuotteet noudattavat EU:n säädöksiä. CBD-tuotteemme sisältävät alle 0,3% THC:tä.', ip: 'Immateriaalioikeudet', ipDesc: 'Kaikki tämän sivuston sisältö on Greens Farmhousein omaisuutta ja suojattu tekijänoikeuslailla.', liability: 'Vastuunrajoitus', liabilityDesc: 'Greens Farmhouse ei ole vastuussa suorista, epäsuorista tai välillisistä vahingoista.', law: 'Sovellettava Laki', lawDesc: 'Näitä ehtoja säätelee Ranskan laki. Riidat käsitellään ranskalaisissa tuomioistuimissa.', contactQ: 'Yhteystiedot', contactQDesc: 'Näitä oikeudellisia ehtoja koskevissa kysymyksissä ottakaa yhteyttä.' },
  pt: { title: 'Aviso Legal | Greens Farmhouse', desc: 'Aviso legal e condições de utilização do site Greens Farmhouse.', h1: 'Aviso Legal', company: 'Informação da Empresa', terms: 'Condições de Utilização', termsDesc: 'Ao aceder e utilizar este website, aceita e compromete-se a cumprir estas condições.', age: 'Restrição de Idade', ageDesc: 'Este website e os seus produtos destinam-se a pessoas com 18 anos ou mais.', pro: 'Uso Profissional', proDesc: 'Greens Farmhouse é um fornecedor grossista B2B. Os nossos produtos destinam-se a compradores profissionais e empresas do setor CBD.', productInfo: 'Informação do Produto', productDesc: 'Todos os produtos cumprem a regulamentação da União Europeia. Os nossos produtos CBD contêm menos de 0,3% de THC.', ip: 'Propriedade Intelectual', ipDesc: 'Todo o conteúdo deste website é propriedade da Greens Farmhouse e protegido por leis de propriedade intelectual.', liability: 'Limitação de Responsabilidade', liabilityDesc: 'Greens Farmhouse não será responsável por danos diretos, indiretos ou consequentes do uso deste website.', law: 'Lei Aplicável', lawDesc: 'Estas condições regem-se pela lei francesa. Quaisquer litígios ficam sujeitos aos tribunais franceses.', contactQ: 'Contacto', contactQDesc: 'Para questões sobre estes termos legais, contacte-nos.' },
