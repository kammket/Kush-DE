};

const tr = translations[locale] || {};
const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: lp('/') },
  { name: t(locale, 'nav.cart'), url: lp('/cart') },
  { name: tr.h1 },
];
---

<BaseLayout title={`${tr.h1} | Greens Farmhouse`} description={tr.emptyDesc} locale={locale} noindex={true}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><Breadcrumbs items={breadcrumbs} /></div>

  <section class="py-6 md:py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-8">{tr.h1}</h1>

      <!-- Empty -->
      <div id="checkout-empty" class="hidden text-center py-16">
        <h2 class="text-xl font-semibold text-gray-600 mb-2">{tr.empty}</h2>
        <p class="text-gray-400 mb-6">{tr.emptyDesc}</p>
        <a href={lp('/collections')} class="inline-flex bg-primary text-white px-6 py-3 rounded-xl font-semibold hover:bg-primary-dark transition-colors">{tr.browse}</a>
      </div>

      <!-- Form + Summary -->
      <div id="checkout-form-wrapper" class="hidden">
        <div class="grid lg:grid-cols-5 gap-8">
          <div class="lg:col-span-3">
            <form id="checkout-form" class="space-y-6">
              <!-- Contact -->
              <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4">{tr.contact}</h2>
                <div class="grid sm:grid-cols-2 gap-4">
                  <div><label for="first-name" class="block text-sm font-medium text-gray-700 mb-1">{tr.firstName}</label><input type="text" id="first-name" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" /></div>
                  <div><label for="last-name" class="block text-sm font-medium text-gray-700 mb-1">{tr.lastName}</label><input type="text" id="last-name" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" /></div>
                  <div><label for="email" class="block text-sm font-medium text-gray-700 mb-1">{tr.email}</label><input type="email" id="email" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" /></div>
                  <div><label for="phone" class="block text-sm font-medium text-gray-700 mb-1">{tr.phone}</label><input type="tel" id="phone" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" /></div>
                  <div class="sm:col-span-2"><label for="company" class="block text-sm font-medium text-gray-700 mb-1">{tr.company}</label><input type="text" id="company" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder={tr.companyPh} /></div>
                </div>
              </div>

              <!-- Shipping -->
              <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4">{tr.shippingAddr}</h2>
                <div class="space-y-4">
                  <div><label for="address" class="block text-sm font-medium text-gray-700 mb-1">{tr.address}</label><input type="text" id="address" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" /></div>
                  <div><label for="address2" class="block text-sm font-medium text-gray-700 mb-1">{tr.address2}</label><input type="text" id="address2" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" /></div>
                  <div class="grid sm:grid-cols-3 gap-4">
                    <div><label for="city" class="block text-sm font-medium text-gray-700 mb-1">{tr.city}</label><input type="text" id="city" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" /></div>
                    <div><label for="postal" class="block text-sm font-medium text-gray-700 mb-1">{tr.postal}</label><input type="text" id="postal" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" /></div>
                    <div><label for="country" class="block text-sm font-medium text-gray-700 mb-1">{tr.country}</label>
                      <select id="country" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary bg-white">
                        {getCountryOptions(locale).map(c => <option value={c.code} selected={c.code === 'FR'}>{c.name}</option>)}
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Payment -->
              <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4">{tr.payment}</h2>
                <div class="space-y-3">
                  <label class="flex items-center gap-3 p-4 border-2 border-primary rounded-lg bg-primary/5 cursor-pointer">
                    <input type="radio" name="payment" value="transfer" checked class="accent-primary" />
                    <div class="flex items-center gap-3">
                      <svg class="w-6 h-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M3 6h18M3 14h18M3 18h18"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 2h14a2 2 0 012 2v16a2 2 0 01-2 2H5a2 2 0 01-2-2V4a2 2 0 012-2z"/></svg>
                      <div>
                        <span class="text-sm font-semibold text-gray-900">{tr.transfer}</span>
                        <p class="text-xs text-gray-500 mt-0.5">{tr.transferDesc}</p>
                      </div>
                    </div>
                  </label>
                </div>
                <div class="mt-3 flex items-start gap-2 p-3 bg-blue-50 rounded-lg border border-blue-100">
                  <svg class="w-4 h-4 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
                  <p class="text-xs text-blue-700">{tr.transferInfo}</p>
                </div>
              </div>

              <!-- Notes -->
              <div class="bg-white rounded-xl border border-gray-200 p-6">
                <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">{tr.notes}</label>
                <textarea id="notes" rows="3" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder={tr.notesPh}></textarea>
              </div>

              <button type="submit" id="place-order-btn" class="w-full py-4 bg-primary text-white text-lg font-bold rounded-xl hover:bg-primary-dark transition-colors shadow-lg focus:outline-none focus:ring-4 focus:ring-primary/30">{tr.placeOrder}</button>
              <p class="text-xs text-gray-500 text-center">
                {tr.terms} <a href={lp('/legal')} class="text-primary underline">{tr.termsLink}</a> & <a href={lp('/privacy')} class="text-primary underline">{tr.privacyLink}</a>.
              </p>
            </form>
          </div>

          <!-- Summary -->
          <div class="lg:col-span-2">
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:sticky lg:top-28">
              <h2 class="text-lg font-bold text-gray-900 mb-4">{tr.orderSummary}</h2>
              <div id="checkout-items" class="divide-y divide-gray-100 max-h-80 overflow-y-auto mb-4"></div>
              <div class="space-y-2 text-sm border-t pt-4">
                <div class="flex justify-between"><span class="text-gray-600">{tr.subtotal}</span><span id="co-subtotal" class="font-medium">€0.00</span></div>
                <div class="flex justify-between"><span class="text-gray-600">{tr.shipping}</span><span id="co-shipping" class="font-medium" data-free={tr.free}>{tr.free}</span></div>
                <div class="flex justify-between text-lg font-bold border-t pt-2"><span>{tr.total}</span><span id="co-total" class="text-primary">€0.00</span></div>
              </div>
              <a href={lp('/cart')} class="block mt-4 text-center text-sm text-primary hover:underline font-medium">{tr.editCart}</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Minimum Order Warning -->
      <div id="checkout-minimum" class="hidden text-center py-16">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-100 text-amber-600 mb-6">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
        </div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">{tr.minTitle}</h2>
        <p class="text-gray-600 mb-2 max-w-md mx-auto">{tr.minDesc} <strong class="text-primary">€150.00</strong> {tr.minDescB}</p>
        <p class="text-gray-500 text-sm mb-2">{tr.minCurrent} <strong id="minimum-cart-total" class="text-gray-900">€0.00</strong></p>
        <p class="text-gray-400 text-sm mb-8">{tr.minAdd}</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={lp('/collections')} class="bg-primary text-white px-6 py-3 rounded-xl font-semibold hover:bg-primary-dark transition-colors">{tr.browse}</a>
          <a href={lp('/cart')} class="border border-gray-300 text-gray-700 px-6 py-3 rounded-xl font-medium hover:bg-gray-50 transition-colors">{tr.backCart}</a>
        </div>
      </div>

      <!-- Confirmation -->
      <div id="checkout-confirmation" class="hidden text-center py-16">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-green-100 text-green-600 mb-6">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
        </div>
        <h2 class="text-2xl font-extrabold text-gray-900 mb-3">{tr.confirmed}</h2>
        <div class="max-w-lg mx-auto">
          <p class="text-gray-600 mb-4">{tr.confirmedDesc}</p>
          <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 mb-6 text-left">
            <h3 class="font-semibold text-blue-900 mb-2 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              {tr.whatNext}
            </h3>
            <ul class="space-y-2 text-sm text-blue-800">
              <li class="flex items-start gap-2">
                <span class="font-bold text-blue-600 mt-0.5">1.</span>
                <span>{tr.step1} <strong id="confirm-email" class="text-blue-900"></strong> {tr.step1b}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-blue-600 mt-0.5">2.</span>
                <span>{tr.step2}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-blue-600 mt-0.5">3.</span>
                <span>{tr.step3}</span>
              </li>
            </ul>
          </div>
          <div class="flex items-center gap-2 justify-center text-sm text-gray-500 mb-8">
            <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>{tr.secureNote}</span>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={lp('/collections')} class="bg-primary text-white px-6 py-3 rounded-xl font-semibold hover:bg-primary-dark transition-colors">{tr.continueShopping}</a>
          <a href={lp('/')} class="border border-gray-300 text-gray-700 px-6 py-3 rounded-xl font-medium hover:bg-gray-50 transition-colors">{tr.backHome}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getCart, getCartTotal, clearCart } from '../../scripts/cart';

  const MIN_ORDER = 150;

  function initCheckout() {
    const cart = getCart();
    const emptyEl = document.getElementById('checkout-empty');
    const formWrapper = document.getElementById('checkout-form-wrapper');
    const confirmEl = document.getElementById('checkout-confirmation');
    const minimumEl = document.getElementById('checkout-minimum');

    // Hide all states first
    confirmEl?.classList.add('hidden');
    minimumEl?.classList.add('hidden');
    formWrapper?.classList.add('hidden');
    emptyEl?.classList.add('hidden');

    if (cart.length === 0) {
      emptyEl?.classList.remove('hidden');
      return;
    }

    const subtotal = getCartTotal();

    // Check minimum order
    if (subtotal < MIN_ORDER) {
      minimumEl?.classList.remove('hidden');
      const totalEl = document.getElementById('minimum-cart-total');
      if (totalEl) totalEl.textContent = `€${subtotal.toFixed(2)}`;
      return;
    }

    formWrapper?.classList.remove('hidden');

    const itemsEl = document.getElementById('checkout-items');
    if (itemsEl) {
      itemsEl.innerHTML = cart.map(item => `
        <div class="flex items-center gap-3 py-3">
          <div class="relative shrink-0">
            <img src="${item.image}" alt="${item.name}" class="w-12 h-12 rounded-lg object-cover border border-gray-200" />
            <span class="absolute -top-1.5 -right-1.5 bg-gray-700 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center font-bold">${item.quantity}</span>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-gray-900 truncate">${item.name}</p>
            <p class="text-xs text-gray-500">${item.variantLabel}</p>
          </div>
          <span class="text-sm font-bold text-gray-900 shrink-0">€${(item.price * item.quantity).toFixed(2)}</span>
        </div>
      `).join('');
    }

    const freeShipping = subtotal >= 150;
    document.getElementById('co-subtotal')!.textContent = `€${subtotal.toFixed(2)}`;
    const shippingEl = document.getElementById('co-shipping');
    if (shippingEl) { const freeText = shippingEl.dataset.free || shippingEl.textContent || 'FREE'; shippingEl.textContent = freeShipping ? freeText : '€9.90'; }
    const total = freeShipping ? subtotal : subtotal + 9.9;
    document.getElementById('co-total')!.textContent = `€${total.toFixed(2)}`;

    const form = document.getElementById('checkout-form') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn = document.getElementById('place-order-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'PROCESSING...';

      const emailInput = document.getElementById('email') as HTMLInputElement;
      const confirmEmail = document.getElementById('confirm-email');
      if (confirmEmail) confirmEmail.textContent = emailInput?.value || '';

      const orderData = {
        type: 'order',
        firstName: (document.getElementById('first-name') as HTMLInputElement)?.value,
        lastName: (document.getElementById('last-name') as HTMLInputElement)?.value,
        email: emailInput?.value,
        phone: (document.getElementById('phone') as HTMLInputElement)?.value,
        company: (document.getElementById('company') as HTMLInputElement)?.value,
        address: (document.getElementById('address') as HTMLInputElement)?.value,
        address2: (document.getElementById('address2') as HTMLInputElement)?.value,
        city: (document.getElementById('city') as HTMLInputElement)?.value,
        postal: (document.getElementById('postal') as HTMLInputElement)?.value,
        country: (document.getElementById('country') as HTMLSelectElement)?.value,
        notes: (document.getElementById('notes') as HTMLTextAreaElement)?.value,
        items: cart.map(item => ({ name: item.name, variant: item.variantLabel, quantity: item.quantity, price: item.price })),
        subtotal,
        shipping: freeShipping ? 'FREE' : '€9.90',
        total,
      };

      try {
        const res = await fetch('/api/send-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(orderData),
        });

        if (!res.ok) {
          let errorMsg = 'Failed to send order email. Please try again.';
          try {
            const errorData = await res.json();
            if (errorData?.error) errorMsg = errorData.error;
          } catch {
            // ignore JSON parse errors
          }
          throw new Error(errorMsg);
        }
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'PLACE ORDER';
        alert(err instanceof Error ? err.message : 'Failed to send order email. Please try again.');
        return;
      }

      clearCart();
      formWrapper?.classList.add('hidden');
      confirmEl?.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  initCheckout();
  document.addEventListener('astro:after-swap', initCheckout);
</script>
