---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { supportedLocales, type Locale } from '../../i18n/config';
import { t, getLocalePath, getAbsoluteLocaleUrl } from '../../i18n/utils';

export function getStaticPaths() {
  return supportedLocales.map(lang => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const locale = lang as Locale;

const translations: Record<string, any> = {
  es: { title: 'Política de Privacidad | Greens Farmhouse', desc: 'Política de privacidad de Greens Farmhouse. Cómo recopilamos, usamos y protegemos sus datos personales conforme al RGPD.', h1: 'Política de Privacidad', updated: 'Última actualización: Enero 2024', intro: '1. Introducción', introDesc: 'Greens Farmhouse se compromete a proteger su privacidad. Esta Política de Privacidad explica cómo recopilamos, usamos y protegemos su información personal, conforme al Reglamento General de Protección de Datos (RGPD).', collect: '2. Información que Recopilamos', collectYou: 'Información que Usted Proporciona', collectYouItems: ['Información de cuenta: nombre, email, teléfono, dirección', 'Información de pedidos: historial de compras, datos de pago', 'Datos de comunicación: mensajes, correspondencia', 'Suscripciones al boletín'], collectAuto: 'Información Recopilada Automáticamente', collectAutoItems: ['Dirección IP y tipo de navegador', 'Información del dispositivo', 'Páginas visitadas y patrones de navegación', 'Cookies y tecnologías similares'], use: '3. Cómo Usamos su Información', useItems: ['Procesar y cumplir sus pedidos mayoristas', 'Gestionar su cuenta y soporte al cliente', 'Enviar confirmaciones y actualizaciones de envío', 'Comunicaciones de marketing (con su consentimiento)', 'Mejorar nuestros servicios', 'Cumplimiento legal y prevención de fraude'], rights: '7. Sus Derechos (RGPD)', rightsItems: ['Derecho de acceso', 'Derecho de rectificación', 'Derecho de supresión', 'Derecho a restringir el procesamiento', 'Derecho a la portabilidad de datos', 'Derecho de oposición', 'Derecho a retirar el consentimiento'], contact: '10. Contáctenos', contactDesc: 'Para cualquier pregunta sobre esta Política de Privacidad:' },
  fr: { title: 'Politique de Confidentialité | Greens Farmhouse', desc: 'Politique de confidentialité de Greens Farmhouse. Comment nous collectons, utilisons et protégeons vos données personnelles conformément au RGPD.', h1: 'Politique de Confidentialité', updated: 'Dernière mise à jour : Janvier 2024', intro: '1. Introduction', introDesc: 'Greens Farmhouse s\'engage à protéger votre vie privée. Cette Politique de Confidentialité explique comment nous collectons, utilisons et protégeons vos informations personnelles, conformément au RGPD.', collect: '2. Informations Collectées', collectYou: 'Informations que Vous Fournissez', collectYouItems: ['Informations de compte : nom, email, téléphone, adresse', 'Informations de commande : historique, données de paiement', 'Données de communication : messages, correspondance', 'Abonnements newsletter'], collectAuto: 'Informations Collectées Automatiquement', collectAutoItems: ['Adresse IP et type de navigateur', 'Informations sur l\'appareil', 'Pages visitées et modèles de navigation', 'Cookies et technologies similaires'], use: '3. Utilisation de Vos Informations', useItems: ['Traiter et exécuter vos commandes grossiste', 'Gérer votre compte et support client', 'Envoyer confirmations et mises à jour de livraison', 'Communications marketing (avec votre consentement)', 'Améliorer nos services', 'Conformité légale et prévention de la fraude'], rights: '7. Vos Droits (RGPD)', rightsItems: ['Droit d\'accès', 'Droit de rectification', 'Droit à l\'effacement', 'Droit à la limitation du traitement', 'Droit à la portabilité des données', 'Droit d\'opposition', 'Droit de retirer le consentement'], contact: '10. Contactez-Nous', contactDesc: 'Pour toute question concernant cette Politique de Confidentialité :' },
  de: { title: 'Datenschutz | Greens Farmhouse', desc: 'Datenschutzrichtlinie von Greens Farmhouse. Wie wir Ihre persönlichen Daten gemäß DSGVO erheben, verwenden und schützen.', h1: 'Datenschutzrichtlinie', updated: 'Letzte Aktualisierung: Januar 2024', intro: '1. Einleitung', introDesc: 'Greens Farmhouse verpflichtet sich zum Schutz Ihrer Privatsphäre. Diese Datenschutzrichtlinie erklärt, wie wir Ihre persönlichen Daten gemäß der DSGVO erheben, verwenden und schützen.', collect: '2. Erhobene Informationen', collectYou: 'Von Ihnen bereitgestellte Informationen', collectYouItems: ['Kontodaten: Name, E-Mail, Telefon, Adresse', 'Bestellinformationen: Kaufhistorie, Zahlungsdaten', 'Kommunikationsdaten: Nachrichten, Korrespondenz', 'Newsletter-Abonnements'], collectAuto: 'Automatisch erhobene Informationen', collectAutoItems: ['IP-Adresse und Browsertyp', 'Geräteinformationen', 'Besuchte Seiten und Navigationsmuster', 'Cookies und ähnliche Technologien'], use: '3. Verwendung Ihrer Informationen', useItems: ['Verarbeitung Ihrer Großhandelsbestellungen', 'Kontoverwaltung und Kundensupport', 'Versandbestätigungen und Updates', 'Marketing (mit Ihrer Zustimmung)', 'Verbesserung unserer Dienste', 'Rechtliche Compliance und Betrugsprävention'], rights: '7. Ihre Rechte (DSGVO)', rightsItems: ['Auskunftsrecht', 'Recht auf Berichtigung', 'Recht auf Löschung', 'Recht auf Einschränkung der Verarbeitung', 'Recht auf Datenübertragbarkeit', 'Widerspruchsrecht', 'Recht auf Widerruf der Einwilligung'], contact: '10. Kontakt', contactDesc: 'Für Fragen zu dieser Datenschutzrichtlinie:' },
  nl: { title: 'Privacybeleid | Greens Farmhouse', desc: 'Privacybeleid van Greens Farmhouse. Hoe wij uw persoonsgegevens verzamelen, gebruiken en beschermen conform AVG.', h1: 'Privacybeleid', updated: 'Laatst bijgewerkt: Januari 2024', intro: '1. Inleiding', introDesc: 'Greens Farmhouse hecht belang aan de bescherming van uw privacy. Dit Privacybeleid legt uit hoe wij uw persoonsgegevens verzamelen, gebruiken en beschermen conform de AVG.', collect: '2. Verzamelde Informatie', collectYou: 'Door U Verstrekte Informatie', collectYouItems: ['Accountgegevens: naam, e-mail, telefoon, adres', 'Bestelinformatie: aankoopgeschiedenis, betalingsgegevens', 'Communicatiegegevens: berichten, correspondentie', 'Nieuwsbriefabonnementen'], collectAuto: 'Automatisch Verzamelde Informatie', collectAutoItems: ['IP-adres en browsertype', 'Apparaatinformatie', 'Bezochte pagina\'s en navigatiepatronen', 'Cookies en vergelijkbare technologieën'], use: '3. Gebruik van Uw Informatie', useItems: ['Verwerken van uw groothandelsbestellingen', 'Accountbeheer en klantenservice', 'Verzendbevestigingen en updates', 'Marketing (met uw toestemming)', 'Verbetering van onze diensten', 'Juridische naleving en fraudepreventie'], rights: '7. Uw Rechten (AVG)', rightsItems: ['Recht op inzage', 'Recht op rectificatie', 'Recht op verwijdering', 'Recht op beperking van verwerking', 'Recht op gegevensoverdraagbaarheid', 'Recht van bezwaar', 'Recht om toestemming in te trekken'], contact: '10. Contact', contactDesc: 'Voor vragen over dit Privacybeleid:' },
  it: { title: 'Privacy Policy | Greens Farmhouse', desc: 'Privacy policy di Greens Farmhouse. Come raccogliamo, utilizziamo e proteggiamo i vostri dati personali conformemente al GDPR.', h1: 'Privacy Policy', updated: 'Ultimo aggiornamento: Gennaio 2024', intro: '1. Introduzione', introDesc: 'Greens Farmhouse si impegna a proteggere la vostra privacy. Questa Privacy Policy spiega come raccogliamo, utilizziamo e proteggiamo le vostre informazioni personali conformemente al GDPR.', collect: '2. Informazioni Raccolte', collectYou: 'Informazioni Fornite da Voi', collectYouItems: ['Dati dell\'account: nome, email, telefono, indirizzo', 'Informazioni ordini: cronologia acquisti, dati di pagamento', 'Dati di comunicazione: messaggi, corrispondenza', 'Iscrizioni alla newsletter'], collectAuto: 'Informazioni Raccolte Automaticamente', collectAutoItems: ['Indirizzo IP e tipo di browser', 'Informazioni sul dispositivo', 'Pagine visitate e modelli di navigazione', 'Cookie e tecnologie simili'], use: '3. Utilizzo delle Informazioni', useItems: ['Elaborazione degli ordini all\'ingrosso', 'Gestione account e assistenza clienti', 'Conferme di spedizione e aggiornamenti', 'Comunicazioni marketing (con il vostro consenso)', 'Miglioramento dei servizi', 'Conformità legale e prevenzione frodi'], rights: '7. I Vostri Diritti (GDPR)', rightsItems: ['Diritto di accesso', 'Diritto di rettifica', 'Diritto alla cancellazione', 'Diritto alla limitazione del trattamento', 'Diritto alla portabilità dei dati', 'Diritto di opposizione', 'Diritto di revocare il consenso'], contact: '10. Contatti', contactDesc: 'Per domande su questa Privacy Policy:' },
  fi: { title: 'Tietosuojakäytäntö | Greens Farmhouse', desc: 'Greens Farmhousein tietosuojakäytäntö. Miten keräämme, käytämme ja suojaamme henkilötietojasi GDPR:n mukaisesti.', h1: 'Tietosuojakäytäntö', updated: 'Viimeksi päivitetty: Tammikuu 2024', intro: '1. Johdanto', introDesc: 'Greens Farmhouse on sitoutunut suojaamaan yksityisyyttäsi. Tämä tietosuojakäytäntö selittää, miten keräämme, käytämme ja suojaamme henkilötietojasi GDPR:n mukaisesti.', collect: '2. Kerättävät Tiedot', collectYou: 'Antamasi Tiedot', collectYouItems: ['Tilitiedot: nimi, sähköposti, puhelin, osoite', 'Tilaustiedot: ostohistoria, maksutiedot', 'Viestintätiedot: viestit, kirjeenvaihto', 'Uutiskirjetilaukset'], collectAuto: 'Automaattisesti Kerättävät Tiedot', collectAutoItems: ['IP-osoite ja selaintyyppi', 'Laitetiedot', 'Vieraillut sivut ja navigointimallit', 'Evästeet ja vastaavat teknologiat'], use: '3. Tietojen Käyttö', useItems: ['Tukkutilausten käsittely', 'Tilinhalllinta ja asiakastuki', 'Toimitusvahvistukset ja päivitykset', 'Markkinointiviestintä (suostumuksellasi)', 'Palveluidemme parantaminen', 'Lakien noudattaminen ja petostentorjunta'], rights: '7. Oikeutesi (GDPR)', rightsItems: ['Oikeus saada pääsy tietoihin', 'Oikeus oikaista tietoja', 'Oikeus poistaa tiedot', 'Oikeus rajoittaa käsittelyä', 'Oikeus siirtää tiedot', 'Vastustamisoikeus', 'Oikeus peruuttaa suostumus'], contact: '10. Yhteystiedot', contactDesc: 'Tätä tietosuojakäytäntöä koskevissa kysymyksissä:' },
  pt: { title: 'Política de Privacidade | Greens Farmhouse', desc: 'Política de privacidade da Greens Farmhouse. Como recolhemos, utilizamos e protegemos os seus dados pessoais conforme o RGPD.', h1: 'Política de Privacidade', updated: 'Última atualização: Janeiro 2024', intro: '1. Introdução', introDesc: 'A Greens Farmhouse compromete-se a proteger a sua privacidade. Esta Política de Privacidade explica como recolhemos, utilizamos e protegemos as suas informações pessoais, conforme o RGPD.', collect: '2. Informação Recolhida', collectYou: 'Informação Fornecida por Si', collectYouItems: ['Dados da conta: nome, email, telefone, morada', 'Informação de encomendas: histórico de compras, dados de pagamento', 'Dados de comunicação: mensagens, correspondência', 'Subscrições de newsletter'], collectAuto: 'Informação Recolhida Automaticamente', collectAutoItems: ['Endereço IP e tipo de navegador', 'Informação do dispositivo', 'Páginas visitadas e padrões de navegação', 'Cookies e tecnologias similares'], use: '3. Como Utilizamos a Sua Informação', useItems: ['Processar encomendas por grosso', 'Gestão de conta e suporte ao cliente', 'Confirmações de envio e atualizações', 'Comunicações de marketing (com o seu consentimento)', 'Melhorar os nossos serviços', 'Conformidade legal e prevenção de fraude'], rights: '7. Os Seus Direitos (RGPD)', rightsItems: ['Direito de acesso', 'Direito de retificação', 'Direito ao apagamento', 'Direito à limitação do tratamento', 'Direito à portabilidade dos dados', 'Direito de oposição', 'Direito de retirar o consentimento'], contact: '10. Contacte-nos', contactDesc: 'Para questões sobre esta Política de Privacidade:' },
};

const tr = translations[locale] || {};

const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: getLocalePath('/', locale) },
  { name: t(locale, 'nav.privacy') },
];
---

<BaseLayout title={tr.title} description={tr.desc} locale={locale}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8"><Breadcrumbs items={breadcrumbs} /></div>

  <section class="py-10 md:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">{tr.h1}</h1>
      <p class="text-gray-500 mb-8">{tr.updated}</p>
      <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
        <h2>{tr.intro}</h2>
        <p>{tr.introDesc}</p>
        <h2>{tr.collect}</h2>
        <h3>{tr.collectYou}</h3>
        <ul>{tr.collectYouItems?.map((item: string) => <li>{item}</li>)}</ul>
        <h3>{tr.collectAuto}</h3>
        <ul>{tr.collectAutoItems?.map((item: string) => <li>{item}</li>)}</ul>
        <h2>{tr.use}</h2>
        <ul>{tr.useItems?.map((item: string) => <li>{item}</li>)}</ul>
        <h2>{tr.rights}</h2>
        <ul>{tr.rightsItems?.map((item: string) => <li><strong>{item}</strong></li>)}</ul>
        <p>Email: <a href="mailto:contact@greensfarmhouse.com">contact@greensfarmhouse.com</a></p>
        <h2>{tr.contact}</h2>
        <p>{tr.contactDesc}</p>
        <p><strong>Greens Farmhouse — Data Protection</strong><br />Email: <a href="mailto:contact@greensfarmhouse.com">contact@greensfarmhouse.com</a><br />Phone: <a href="tel:+447346989289">+44 7346 989289</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
