  fr: { title: 'Livraison | Greens Farmhouse', desc: 'Politique de livraison de Greens Farmhouse, délais et coûts pour vos commandes CBD en gros en Europe.', h1: 'Livraison et Expédition', zones: 'Zones de Livraison et Délais Estimés', zone: 'Zone', countries: 'Pays', deliveryTime: 'Délai de Livraison', cost: 'Frais de Port', france: 'France Métropolitaine', zone1countries: 'Belgique, Luxembourg, Allemagne, Pays-Bas', zone2countries: 'Italie, Espagne, Portugal, Autriche, Suisse', zone3countries: 'Reste de l\'Europe (Royaume-Uni, Scandinavie, Europe de l\'Est)', free200: 'Gratuit dès 200€', methods: 'Méthodes de Livraison', methodsDesc: 'Nous utilisons des transporteurs premium pour garantir que vos commandes arrivent en toute sécurité :', standard: 'Livraison Standard : Colis suivi via Colissimo ou DPD', express: 'Livraison Express : Livraison prioritaire via Chronopost ou DHL Express', freight: 'Fret : Pour les commandes grossistes de plus de 50kg, livraison palette', processing: 'Traitement des Commandes', proc1: 'Commandes passées avant 14h00 CET (lundi-vendredi) traitées le jour même', proc2: 'Commandes après 14h00 CET ou le week-end traitées le jour ouvré suivant', proc3: 'Vous recevrez un numéro de suivi par email dès l\'expédition', packaging: 'Emballage', packagingDesc: 'Toutes les commandes sont expédiées dans un emballage discret et neutre. Les produits sont sous vide et protégés.', freeShipping: 'Livraison Gratuite', freeDesc: 'Livraison standard gratuite pour toute commande supérieure à 200€ en France métropolitaine.', returns: 'Retours et Problèmes', returnsDesc: 'Si votre commande arrive endommagée ou incorrecte, contactez-nous dans les 48h suivant la livraison.', questions: 'Questions ?', questionsDesc: 'Pour toute question sur la livraison,' },
  de: { title: 'Versand | Greens Farmhouse', desc: 'Versandrichtlinie von Greens Farmhouse, Lieferzeiten und Kosten für CBD-Großhandelsbestellungen in Europa.', h1: 'Versand & Lieferung', zones: 'Lieferzonen & Geschätzte Zeiten', zone: 'Zone', countries: 'Länder', deliveryTime: 'Lieferzeit', cost: 'Versandkosten', france: 'Frankreich (Festland)', zone1countries: 'Belgien, Luxemburg, Deutschland, Niederlande', zone2countries: 'Italien, Spanien, Portugal, Österreich, Schweiz', zone3countries: 'Rest Europas (UK, Skandinavien, Osteuropa)', free200: 'Kostenlos ab 200€', methods: 'Versandmethoden', methodsDesc: 'Wir nutzen Premium-Spediteure für sichere und pünktliche Lieferung:', standard: 'Standardversand: Verfolgtes Paket via Colissimo oder DPD', express: 'Expressversand: Prioritätslieferung via Chronopost oder DHL Express', freight: 'Fracht: Für Großbestellungen über 50kg, Palettenlieferung', processing: 'Bestellabwicklung', proc1: 'Bestellungen vor 14:00 CET (Mo-Fr) werden am selben Tag verarbeitet', proc2: 'Bestellungen nach 14:00 CET oder am Wochenende am nächsten Werktag', proc3: 'Sie erhalten eine Sendungsverfolgungsnummer per E-Mail', packaging: 'Verpackung', packagingDesc: 'Alle Bestellungen in diskreter, neutraler Verpackung. Produkte vakuumversiegelt und geschützt.', freeShipping: 'Kostenloser Versand', freeDesc: 'Kostenloser Standardversand ab 200€ innerhalb Frankreichs.', returns: 'Rücksendungen & Probleme', returnsDesc: 'Beschädigte oder falsche Lieferung? Kontaktieren Sie uns innerhalb von 48h.', questions: 'Fragen?', questionsDesc: 'Für alle Versandanfragen,' },
  nl: { title: 'Verzending | Greens Farmhouse', desc: 'Verzendbeleid van Greens Farmhouse, levertijden en kosten voor CBD-groothandelsbestellingen in Europa.', h1: 'Verzending & Levering', zones: 'Leveringszones & Geschatte Tijden', zone: 'Zone', countries: 'Landen', deliveryTime: 'Levertijd', cost: 'Verzendkosten', france: 'Frankrijk (vasteland)', zone1countries: 'België, Luxemburg, Duitsland, Nederland', zone2countries: 'Italië, Spanje, Portugal, Oostenrijk, Zwitserland', zone3countries: 'Rest van Europa (VK, Scandinavië, Oost-Europa)', free200: 'Gratis vanaf €200', methods: 'Verzendmethoden', methodsDesc: 'Wij gebruiken premium vervoerders voor veilige en tijdige levering:', standard: 'Standaardverzending: Gevolgd pakket via Colissimo of DPD', express: 'Expresverzending: Prioriteitslevering via Chronopost of DHL Express', freight: 'Vracht: Voor groothandelsbestellingen boven 50kg, palletlevering', processing: 'Orderverwerking', proc1: 'Bestellingen vóór 14:00 CET (ma-vr) worden dezelfde dag verwerkt', proc2: 'Bestellingen na 14:00 CET of in het weekend op de volgende werkdag', proc3: 'U ontvangt een trackingnummer per e-mail', packaging: 'Verpakking', packagingDesc: 'Alle bestellingen in discrete, neutrale verpakking. Producten vacuümverzegeld en beschermd.', freeShipping: 'Gratis Verzending', freeDesc: 'Gratis standaardverzending vanaf €200 binnen Frankrijk.', returns: 'Retourneren & Problemen', returnsDesc: 'Beschadigde of onjuiste levering? Neem contact op binnen 48u.', questions: 'Vragen?', questionsDesc: 'Voor alle verzendvragen,' },
  it: { title: 'Spedizioni | Greens Farmhouse', desc: 'Politica di spedizione di Greens Farmhouse, tempi di consegna e costi per ordini CBD all\'ingrosso in Europa.', h1: 'Spedizioni e Consegne', zones: 'Zone di Consegna e Tempi Stimati', zone: 'Zona', countries: 'Paesi', deliveryTime: 'Tempo di Consegna', cost: 'Costo di Spedizione', france: 'Francia Metropolitana', zone1countries: 'Belgio, Lussemburgo, Germania, Paesi Bassi', zone2countries: 'Italia, Spagna, Portogallo, Austria, Svizzera', zone3countries: 'Resto d\'Europa (UK, Scandinavia, Europa dell\'Est)', free200: 'Gratuita sopra 200€', methods: 'Metodi di Spedizione', methodsDesc: 'Utilizziamo corrieri premium per consegne sicure e puntuali:', standard: 'Spedizione Standard: Pacco tracciato via Colissimo o DPD', express: 'Spedizione Express: Consegna prioritaria via Chronopost o DHL Express', freight: 'Trasporto: Per ordini superiori a 50kg, consegna su pallet', processing: 'Elaborazione Ordini', proc1: 'Ordini prima delle 14:00 CET (lun-ven) elaborati lo stesso giorno', proc2: 'Ordini dopo le 14:00 CET o nel weekend elaborati il giorno lavorativo successivo', proc3: 'Riceverete un numero di tracciamento via email', packaging: 'Imballaggio', packagingDesc: 'Tutti gli ordini in imballaggio discreto e neutro. Prodotti sottovuoto e protetti.', freeShipping: 'Spedizione Gratuita', freeDesc: 'Spedizione standard gratuita per ordini superiori a 200€ in Francia.', returns: 'Resi e Problemi', returnsDesc: 'Consegna danneggiata o errata? Contattateci entro 48 ore.', questions: 'Domande?', questionsDesc: 'Per qualsiasi domanda sulla spedizione,' },
  fi: { title: 'Toimitus | Greens Farmhouse', desc: 'Greens Farmhousein toimitusehdot, toimitusajat ja kustannukset CBD-tukkutilauksille Euroopassa.', h1: 'Toimitus ja Kuljetukset', zones: 'Toimitusalueet ja Arvioidut Ajat', zone: 'Alue', countries: 'Maat', deliveryTime: 'Toimitusaika', cost: 'Toimituskustannus', france: 'Manner-Ranska', zone1countries: 'Belgia, Luxemburg, Saksa, Alankomaat', zone2countries: 'Italia, Espanja, Portugali, Itävalta, Sveitsi', zone3countries: 'Muu Eurooppa (UK, Skandinavia, Itä-Eurooppa)', free200: 'Ilmainen yli 200€', methods: 'Toimitustavat', methodsDesc: 'Käytämme premium-kuljettajia turvalliseen ja oikea-aikaiseen toimitukseen:', standard: 'Peruslähetys: Seurattava paketti Colissimon tai DPD:n kautta', express: 'Pikatoimitus: Ensisijainen toimitus Chronopostin tai DHL Expressin kautta', freight: 'Rahti: Yli 50kg tukkutilauksiin, kuormalavaatoimitus', processing: 'Tilausten Käsittely', proc1: 'Tilaukset ennen klo 14:00 CET (ma-pe) käsitellään samana päivänä', proc2: 'Tilaukset klo 14:00 CET jälkeen tai viikonloppuisin seuraavana arkipäivänä', proc3: 'Saat seurantanumeron sähköpostitse', packaging: 'Pakkaus', packagingDesc: 'Kaikki tilaukset diskreetissä, neutraalissa pakkauksessa. Tuotteet tyhjiöpakattuja ja suojattuja.', freeShipping: 'Ilmainen Toimitus', freeDesc: 'Ilmainen peruslähetys yli 200€ tilauksiin Manner-Ranskassa.', returns: 'Palautukset ja Ongelmat', returnsDesc: 'Vaurioitunut tai virheellinen toimitus? Ota yhteyttä 48 tunnin sisällä.', questions: 'Kysymyksiä?', questionsDesc: 'Kaikissa toimituskyselyissä,' },
  pt: { title: 'Envio | Greens Farmhouse', desc: 'Política de envio da Greens Farmhouse, prazos de entrega e custos para encomendas CBD por grosso na Europa.', h1: 'Envio e Entregas', zones: 'Zonas de Entrega e Tempos Estimados', zone: 'Zona', countries: 'Países', deliveryTime: 'Tempo de Entrega', cost: 'Custo de Envio', france: 'França Metropolitana', zone1countries: 'Bélgica, Luxemburgo, Alemanha, Países Baixos', zone2countries: 'Itália, Espanha, Portugal, Áustria, Suíça', zone3countries: 'Resto da Europa (UK, Escandinávia, Europa de Leste)', free200: 'Grátis acima de 200€', methods: 'Métodos de Envio', methodsDesc: 'Utilizamos transportadoras premium para entregas seguras e pontuais:', standard: 'Envio Padrão: Encomenda rastreada via Colissimo ou DPD', express: 'Envio Expresso: Entrega prioritária via Chronopost ou DHL Express', freight: 'Carga: Para encomendas acima de 50kg, entrega em palete', processing: 'Processamento de Encomendas', proc1: 'Encomendas antes das 14:00 CET (segunda a sexta) processadas no mesmo dia', proc2: 'Encomendas após 14:00 CET ou fins de semana no próximo dia útil', proc3: 'Receberá um número de rastreamento por email', packaging: 'Embalagem', packagingDesc: 'Todas as encomendas em embalagem discreta e neutra. Produtos selados a vácuo e protegidos.', freeShipping: 'Envio Grátis', freeDesc: 'Envio padrão grátis para encomendas acima de 200€ em França metropolitana.', returns: 'Devoluções e Problemas', returnsDesc: 'Entrega danificada ou incorreta? Contacte-nos dentro de 48 horas.', questions: 'Questões?', questionsDesc: 'Para qualquer questão sobre envio,' },
};

const tr = translations[locale] || {};

const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: getLocalePath('/', locale) },
  { name: t(locale, 'nav.shipping') },
];
---

<BaseLayout title={tr.title} description={tr.desc} locale={locale}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8"><Breadcrumbs items={breadcrumbs} /></div>

  <section class="py-10 md:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-8">{tr.h1}</h1>
      <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
        <h2>{tr.zones}</h2>
        <div class="not-prose overflow-x-auto mb-8">
          <table class="w-full text-sm border-collapse">
            <thead><tr class="bg-gray-50">
              <th class="text-left p-3 border border-gray-200 font-semibold">{tr.zone}</th>
              <th class="text-left p-3 border border-gray-200 font-semibold">{tr.countries}</th>
              <th class="text-left p-3 border border-gray-200 font-semibold">{tr.deliveryTime}</th>
              <th class="text-left p-3 border border-gray-200 font-semibold">{tr.cost}</th>
            </tr></thead>
            <tbody>
              <tr><td class="p-3 border border-gray-200 font-medium">France</td><td class="p-3 border border-gray-200">{tr.france}</td><td class="p-3 border border-gray-200">24-48h</td><td class="p-3 border border-gray-200 text-primary font-semibold">{tr.free200}</td></tr>
              <tr class="bg-gray-50/50"><td class="p-3 border border-gray-200 font-medium">Zone 1</td><td class="p-3 border border-gray-200">{tr.zone1countries}</td><td class="p-3 border border-gray-200">2-4 days</td><td class="p-3 border border-gray-200">€9.90</td></tr>
              <tr><td class="p-3 border border-gray-200 font-medium">Zone 2</td><td class="p-3 border border-gray-200">{tr.zone2countries}</td><td class="p-3 border border-gray-200">3-5 days</td><td class="p-3 border border-gray-200">€14.90</td></tr>
              <tr class="bg-gray-50/50"><td class="p-3 border border-gray-200 font-medium">Zone 3</td><td class="p-3 border border-gray-200">{tr.zone3countries}</td><td class="p-3 border border-gray-200">5-7 days</td><td class="p-3 border border-gray-200">€19.90</td></tr>
            </tbody>
          </table>
        </div>
        <h2>{tr.methods}</h2>
        <p>{tr.methodsDesc}</p>
        <ul><li><strong>{tr.standard}</strong></li><li><strong>{tr.express}</strong></li><li><strong>{tr.freight}</strong></li></ul>
        <h2>{tr.processing}</h2>
        <ul><li>{tr.proc1}</li><li>{tr.proc2}</li><li>{tr.proc3}</li></ul>
        <h2>{tr.packaging}</h2>
        <p>{tr.packagingDesc}</p>
        <h2>{tr.freeShipping}</h2>
        <p>{tr.freeDesc}</p>
        <h2>{tr.returns}</h2>
        <p>{tr.returnsDesc} <a href="mailto:contact@greensfarmhouse.com">contact@greensfarmhouse.com</a></p>
        <h2>{tr.questions}</h2>
        <p>{tr.questionsDesc} <a href={lp('/contact')}>{t(locale, 'common.contactUs')}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
