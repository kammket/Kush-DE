    ctaTitle: '¿Listo para Pedir con Confianza?', ctaDesc: 'Únase a más de 5.000 profesionales que confían en Greens Farmhouse.',
    browse: 'Ver Productos', contact: 'Contáctenos',
  },
  fr: {
    title: 'Nos Garanties | Qualité, Sécurité et Satisfaction | Greens Farmhouse',
    desc: 'Greens Farmhouse garantit : produits 100% testés en laboratoire, garantie satisfaction, paiements SSL sécurisés, expédition assurée 24h, conformité totale UE.',
