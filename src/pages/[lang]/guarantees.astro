    heading: 'As Nossas', headingHL: 'Garantias',
    intro: 'Quando encomenda na Greens Farmhouse, beneficia de garantias abrangentes para a sua tranquilidade.',
    labTitle: 'Produtos 100% Testados', labDesc: 'Cada produto é analisado por laboratórios independentes. Fornecemos Certificados de Análise (COA) para cada lote.',
    satTitle: 'Garantia de Satisfação', satDesc: 'Garantimos a qualidade de cada produto. Se a sua encomenda não corresponder às expectativas, encontraremos uma solução.',
    secTitle: 'Pagamentos Seguros', secDesc: 'As suas informações são protegidas com encriptação SSL. Oferecemos vários métodos de pagamento de confiança.',
    shipTitle: 'Envio Rápido e Segurado', shipDesc: 'Todas as encomendas são enviadas em 24h. Cada embalagem é totalmente segurada, rastreada e em embalagem discreta.',
    euTitle: 'Plena Conformidade com a UE', euDesc: 'Todos os produtos cumprem a regulamentação europeia. O nosso cânhamo provém exclusivamente de quintas europeias certificadas.',
    privTitle: 'Privacidade e Proteção de Dados', privDesc: 'A sua privacidade é importante. Os seus dados são protegidos em conformidade com o RGPD. Nunca vendemos as suas informações.',
    ctaTitle: 'Pronto para Encomendar com Confiança?', ctaDesc: 'Junte-se a mais de 5.000 profissionais que confiam na Greens Farmhouse.',
    browse: 'Ver Produtos', contact: 'Contacte-nos',
  },
};

const t2 = tr[locale] || tr.es;

const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: lp('/') },
  { name: t2.headingHL },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": t2.title,
  "description": t2.desc,
  "url": getAbsoluteLocaleUrl(locale, '/guarantees'),
  "inLanguage": locale,
  "isPartOf": { "@type": "WebSite", "url": "https://greensfarmhouse.com" }
};
---

<BaseLayout title={t2.title} description={t2.desc} locale={locale} canonicalURL={getAbsoluteLocaleUrl(locale, '/guarantees')} jsonLd={jsonLd}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="py-12 md:py-16 bg-gradient-to-br from-primary/5 to-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-6">
        {t2.heading} <span class="text-primary">{t2.headingHL}</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto">{t2.intro}</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center mb-5"><span class="text-3xl">🔬</span></div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">{t2.labTitle}</h2>
          <p class="text-gray-600 leading-relaxed">{t2.labDesc}</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mb-5"><span class="text-3xl">🛡️</span></div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">{t2.satTitle}</h2>
          <p class="text-gray-600 leading-relaxed">{t2.satDesc}</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-purple-100 rounded-xl flex items-center justify-center mb-5"><span class="text-3xl">🔒</span></div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">{t2.secTitle}</h2>
          <p class="text-gray-600 leading-relaxed">{t2.secDesc}</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-orange-100 rounded-xl flex items-center justify-center mb-5"><span class="text-3xl">📦</span></div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">{t2.shipTitle}</h2>
          <p class="text-gray-600 leading-relaxed">{t2.shipDesc}</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-yellow-100 rounded-xl flex items-center justify-center mb-5"><span class="text-3xl">🇪🇺</span></div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">{t2.euTitle}</h2>
          <p class="text-gray-600 leading-relaxed">{t2.euDesc}</p>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-teal-100 rounded-xl flex items-center justify-center mb-5"><span class="text-3xl">🔐</span></div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">{t2.privTitle}</h2>
          <p class="text-gray-600 leading-relaxed">{t2.privDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <Testimonials locale={locale} />

  <section class="py-12 md:py-16 bg-primary text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">{t2.ctaTitle}</h2>
      <p class="text-green-100 mb-8 text-lg">{t2.ctaDesc}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={lp('/collections')} class="inline-flex items-center gap-2 px-8 py-3 bg-white text-primary font-bold rounded-lg hover:bg-gray-100 transition-colors shadow-lg">
          {t2.browse}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href={lp('/contact')} class="inline-flex items-center gap-2 px-8 py-3 border-2 border-white text-white font-bold rounded-lg hover:bg-white/10 transition-colors">{t2.contact}</a>
      </div>
    </div>
  </section>
</BaseLayout>
