---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { products, getProductBySlug, getProductsByCategory } from '../../../data/products';
import { supportedLocales, type Locale } from '../../../i18n/config';
import { t, getLocalePath, getAbsoluteLocaleUrl } from '../../../i18n/utils';
import { categoryTranslations } from '../../../data/translations/categories';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const lang of supportedLocales) {
    for (const p of products) {
      paths.push({ params: { lang, slug: p.slug }, props: { lang } });
    }
  }
  return paths;
}

const { lang } = Astro.props;
const locale = lang as Locale;
const { slug } = Astro.params;
const product = getProductBySlug(slug!);
if (!product) return Astro.redirect('/404');

const lp = (path: string) => getLocalePath(path, locale);
const catT = categoryTranslations[locale]?.[product.categorySlug] || categoryTranslations.en[product.categorySlug];

const relatedProducts = getProductsByCategory(product.categorySlug)
  .filter(p => p.id !== product.id && p.inStock)
  .slice(0, 4);

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.description,
  "image": product.image.startsWith('http') ? product.image : `https://greensfarmhouse.com${product.image}`,
  "url": getAbsoluteLocaleUrl(locale, `/products/${product.slug}`),
  "brand": { "@type": "Brand", "name": product.supplier },
  "category": catT?.name || product.category,
  "inLanguage": locale,
  "offers": (product.variants && product.variants.length > 1) ? {
    "@type": "AggregateOffer",
    "lowPrice": Math.min(...product.variants.map(v => v.price)),
    "highPrice": Math.max(...product.variants.map(v => v.price)),
    "offerCount": product.variants.length,
    "priceCurrency": "EUR",
    "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": { "@type": "Organization", "name": "Greens Farmhouse" },
    "url": getAbsoluteLocaleUrl(locale, `/products/${product.slug}`),
  } : {
    "@type": "Offer",
    "price": product.priceNumeric,
    "priceCurrency": "EUR",
    "availability": product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "seller": { "@type": "Organization", "name": "Greens Farmhouse" },
    "priceValidUntil": "2026-12-31",
    "url": getAbsoluteLocaleUrl(locale, `/products/${product.slug}`),
  }
};

const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: lp('/') },
  { name: catT?.name || product.category, url: lp(`/collections/${product.categorySlug}`) },
  { name: product.name },
];
---

<BaseLayout
  title={`${product.name} | ${catT?.name || product.category} | Greens Farmhouse`}
  description={product.description}
  locale={locale}
  canonicalURL={getAbsoluteLocaleUrl(locale, `/products/${product.slug}`)}
  ogType="product"
  jsonLd={productJsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="py-6 md:py-10" itemscope itemtype="https://schema.org/Product">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
        <!-- Product Image -->
        <div class="relative">
          <div class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-green-50 to-green-100 border border-gray-200">
            {product.image.startsWith('http') ? (
              <img src={product.image} alt={product.name} width="600" height="600" class="w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async" itemprop="image" />
            ) : (
              <div class="w-full h-full flex items-center justify-center">
                <div class="text-center p-8">
                  <svg class="w-24 h-24 mx-auto text-primary/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <p class="text-gray-400 mt-4 text-sm">{product.name}</p>
                </div>
              </div>
            )}
          </div>
          <div class="absolute top-4 left-4 flex flex-col gap-2">
            {product.isSpecialOffer && <span class="bg-red-600 text-white text-sm font-bold px-3 py-1.5 rounded-lg shadow">SPECIAL OFFER</span>}
            {!product.inStock && <span class="bg-gray-500 text-white text-sm font-bold px-3 py-1.5 rounded-lg shadow">{t(locale, 'common.outOfStock').toUpperCase()}</span>}
          </div>
        </div>

        <!-- Product Info -->
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wider" itemprop="brand" itemscope itemtype="https://schema.org/Brand">
              <span itemprop="name">{product.supplier}</span>
            </span>
            {product.subcategory && <span class="text-xs bg-primary/10 text-primary px-2 py-0.5 rounded-full font-medium">{product.subcategory}</span>}
          </div>
          
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-gray-900 mb-4" itemprop="name">{product.name}</h1>

          <div class="flex items-baseline gap-3 mb-6" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
            {product.originalPrice && <span class="text-xl text-gray-400 line-through">{product.originalPrice}</span>}
            <span class="text-3xl font-extrabold text-primary" itemprop="price" content={String(product.priceNumeric)}>{product.price}</span>
            <meta itemprop="priceCurrency" content="EUR" />
            <meta itemprop="availability" content={product.inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"} />
          </div>

          {product.variants && product.variants.length > 0 && (
            <div class="mb-6 border border-primary/20 rounded-xl overflow-hidden" id="variant-picker">
              <div class="bg-primary/5 px-5 py-3 border-b border-primary/20">
                <h2 class="font-semibold text-sm text-gray-900 flex items-center gap-2">
                  <span>📦</span> {t(locale, 'common.selectVariant')}
                </h2>
              </div>
              <div class="divide-y divide-gray-100" id="variant-list">
                {product.variants.map((v, i) => (
                  <button type="button" data-variant-btn data-variant-label={v.label} data-variant-price={v.price}
                    class={`variant-row w-full flex items-center justify-between px-5 py-3 text-sm transition-colors cursor-pointer ${i === 0 ? 'bg-primary/10 ring-1 ring-inset ring-primary/30' : 'hover:bg-gray-50'}`}>
                    <span class="flex items-center gap-2">
                      <span class={`w-4 h-4 rounded-full border-2 flex items-center justify-center ${i === 0 ? 'border-primary' : 'border-gray-300'}`}>
                        {i === 0 && <span class="w-2 h-2 rounded-full bg-primary"></span>}
                      </span>
                      <span class="font-medium text-gray-700">{v.label}</span>
                    </span>
                    <span class={`font-bold ${i === 0 ? 'text-primary text-base' : 'text-gray-900'}`}>€{v.price.toFixed(2)}</span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <div class="bg-gray-50 rounded-xl p-5 mb-6">
            <h2 class="font-semibold text-sm text-gray-900 mb-3">{t(locale, 'product.description')}</h2>
            <dl class="grid grid-cols-2 gap-3 text-sm">
              {product.cbdContent && (<><dt class="text-gray-500">{t(locale, 'product.cbdContent')}</dt><dd class="font-medium text-gray-900">{product.cbdContent}</dd></>)}
              {product.thcContent && (<><dt class="text-gray-500">{t(locale, 'product.thcContent')}</dt><dd class="font-medium text-gray-900">{product.thcContent}</dd></>)}
              <dt class="text-gray-500">{t(locale, 'common.categories')}</dt>
              <dd class="font-medium text-gray-900"><a href={lp(`/collections/${product.categorySlug}`)} class="text-primary hover:underline">{catT?.name || product.category}</a></dd>
              <dt class="text-gray-500">{t(locale, 'product.supplier')}</dt>
              <dd class="font-medium text-gray-900">{product.supplier}</dd>
              <dt class="text-gray-500">{t(locale, 'common.inStock')}</dt>
              <dd class={`font-medium ${product.inStock ? 'text-green-600' : 'text-red-600'}`}>
                {product.inStock ? `✓ ${t(locale, 'common.inStock')}` : `✗ ${t(locale, 'common.outOfStock')}`}
              </dd>
            </dl>
          </div>

          <div class="mb-6" itemprop="description">
            <h2 class="font-semibold text-gray-900 mb-2">{t(locale, 'product.description')}</h2>
            <p class="text-gray-600 leading-relaxed">{product.description}</p>
          </div>

          <div class="space-y-3">
            {product.inStock ? (
              <>
                <div class="flex items-center gap-3">
                  <label for="qty" class="text-sm font-medium text-gray-700">{t(locale, 'common.quantity')}:</label>
                  <div class="flex items-center border border-gray-300 rounded-lg overflow-hidden">
                    <button type="button" id="qty-minus" class="px-3 py-2 text-gray-600 hover:bg-gray-100 transition-colors font-bold">−</button>
                    <input type="number" id="qty" value="1" min="1" max="999" class="w-14 text-center border-x border-gray-300 py-2 text-sm font-medium focus:outline-none" />
                    <button type="button" id="qty-plus" class="px-3 py-2 text-gray-600 hover:bg-gray-100 transition-colors font-bold">+</button>
                  </div>
                </div>
                <button id="add-to-cart-btn" type="button"
                  data-slug={product.slug} data-name={product.name} data-image={product.image}
                  data-price={product.priceNumeric}
                  data-variant-label={product.variants && product.variants.length > 0 ? product.variants[0].label : 'Default'}
                  data-added-text={`✓ ${t(locale, 'product.addedToCart')}`}
                  class="w-full py-4 bg-primary text-white text-lg font-bold rounded-xl hover:bg-primary-dark transition-colors shadow-lg focus:outline-none focus:ring-4 focus:ring-primary/30">
                  {t(locale, 'common.addToCart').toUpperCase()}
                </button>
                <div id="cart-toast" class="hidden fixed top-24 right-6 z-[100] bg-green-600 text-white px-5 py-3 rounded-xl shadow-2xl text-sm font-medium flex items-center gap-2 animate-slide-in">
                  <span>✓</span>
                  <span id="cart-toast-msg">{t(locale, 'product.addedToCart')}</span>
                  <a href={lp('/cart')} class="underline font-bold ml-2">{t(locale, 'nav.cart')}</a>
                </div>
              </>
            ) : (
              <button class="w-full py-4 bg-gray-300 text-gray-500 text-lg font-bold rounded-xl cursor-not-allowed" disabled>
                {t(locale, 'common.outOfStock').toUpperCase()}
              </button>
            )}
          </div>

          <div class="mt-6 grid grid-cols-2 gap-3">
            <div class="flex items-center gap-2 text-xs text-gray-600 bg-gray-50 rounded-lg p-3"><span>🔬</span><span>{t(locale, 'trust.labDesc')}</span></div>
            <div class="flex items-center gap-2 text-xs text-gray-600 bg-gray-50 rounded-lg p-3"><span>🚚</span><span>{t(locale, 'trust.deliveryDesc')}</span></div>
            <div class="flex items-center gap-2 text-xs text-gray-600 bg-gray-50 rounded-lg p-3"><span>🌿</span><span>{t(locale, 'trust.qualityDesc')}</span></div>
            <div class="flex items-center gap-2 text-xs text-gray-600 bg-gray-50 rounded-lg p-3"><span>📦</span><span>{t(locale, 'common.freeDelivery')}</span></div>
          </div>

          <!-- Satisfaction Guarantee -->
          <div class="mt-4 bg-green-50 border border-green-200 rounded-xl p-4">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold text-sm text-green-800">{locale === 'fr' ? 'Garantie Satisfaction 100%' : locale === 'de' ? '100% Zufriedenheitsgarantie' : locale === 'es' ? 'Garantía de Satisfacción 100%' : locale === 'it' ? 'Garanzia Soddisfazione 100%' : locale === 'nl' ? '100% Tevredenheidsgarantie' : locale === 'fi' ? '100% Tyytyväisyystakuu' : locale === 'pt' ? 'Garantia de Satisfação 100%' : '100% Satisfaction Guarantee'}</h4>
                <p class="text-xs text-green-700 mt-1">{locale === 'fr' ? 'Qualité certifiée par des laboratoires indépendants. Plus de 5 000 professionnels nous font confiance.' : locale === 'de' ? 'Qualität zertifiziert durch unabhängige Labore. Vertraut von über 5.000 Profis in Europa.' : locale === 'es' ? 'Calidad certificada por laboratorios independientes. Más de 5.000 profesionales confían en nosotros.' : locale === 'it' ? 'Qualità certificata da laboratori indipendenti. Oltre 5.000 professionisti ci scelgono in Europa.' : locale === 'nl' ? 'Kwaliteit gecertificeerd door onafhankelijke laboratoria. Vertrouwd door 5.000+ professionals.' : locale === 'fi' ? 'Laatu sertifioitu riippumattomien laboratorioiden toimesta. Yli 5 000 ammattilaista luottaa meihin.' : locale === 'pt' ? 'Qualidade certificada por laboratórios independentes. Mais de 5.000 profissionais confiam em nós.' : 'Quality certified by independent labs. Trusted by 5,000+ professionals across Europe.'}</p>
                <a href={lp('/guarantees')} class="text-xs text-green-600 font-medium hover:underline mt-1 inline-block">{locale === 'fr' ? 'Voir nos garanties →' : locale === 'de' ? 'Unsere Garantien ansehen →' : locale === 'es' ? 'Ver nuestras garantías →' : locale === 'it' ? 'Vedi le nostre garanzie →' : locale === 'nl' ? 'Bekijk onze garanties →' : locale === 'fi' ? 'Katso takuumme →' : locale === 'pt' ? 'Ver nossas garantias →' : 'View our guarantees →'}</a>
              </div>
            </div>
          </div>

          <!-- Secure Payment -->
          <div class="mt-3 flex items-center gap-2 text-xs text-gray-500">
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <span>{locale === 'fr' ? 'Paiement SSL sécurisé · Visa · Mastercard · PayPal · Virement' : locale === 'de' ? 'Sichere SSL-Zahlung · Visa · Mastercard · PayPal · Überweisung' : locale === 'es' ? 'Pago SSL seguro · Visa · Mastercard · PayPal · Transferencia' : locale === 'it' ? 'Pagamento SSL sicuro · Visa · Mastercard · PayPal · Bonifico' : locale === 'nl' ? 'Veilige SSL-betaling · Visa · Mastercard · PayPal · Bankoverschrijving' : locale === 'fi' ? 'Turvallinen SSL-maksu · Visa · Mastercard · PayPal · Tilisiirto' : locale === 'pt' ? 'Pagamento SSL seguro · Visa · Mastercard · PayPal · Transferência' : 'Secure SSL payment · Visa · Mastercard · PayPal · Bank Transfer'}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {relatedProducts.length > 0 && (
    <section class="py-10 md:py-14 bg-gray-50" aria-labelledby="related-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="related-heading" class="text-2xl font-bold mb-6">{t(locale, 'product.relatedProducts')}</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          {relatedProducts.map(p => <ProductCard product={p} locale={locale} />)}
        </div>
      </div>
    </section>
  )}

  <script>
    import { addToCart } from '../../../scripts/cart';

    function initProductPage() {
      const btn = document.getElementById('add-to-cart-btn') as HTMLButtonElement | null;
      if (!btn) return;
      const qtyInput = document.getElementById('qty') as HTMLInputElement;
      const qtyMinus = document.getElementById('qty-minus');
      const qtyPlus = document.getElementById('qty-plus');
      qtyMinus?.addEventListener('click', () => { const v = parseInt(qtyInput.value) || 1; qtyInput.value = String(Math.max(1, v - 1)); });
      qtyPlus?.addEventListener('click', () => { const v = parseInt(qtyInput.value) || 1; qtyInput.value = String(Math.min(999, v + 1)); });
      const variantBtns = document.querySelectorAll<HTMLButtonElement>('[data-variant-btn]');
      if (variantBtns.length > 0) {
        variantBtns.forEach(vb => {
          vb.addEventListener('click', () => {
            variantBtns.forEach(b => { b.classList.remove('bg-primary/10','ring-1','ring-inset','ring-primary/30'); b.classList.add('hover:bg-gray-50'); const r = b.querySelector('.w-4'); if(r){r.classList.remove('border-primary');r.classList.add('border-gray-300');r.innerHTML='';} });
            vb.classList.add('bg-primary/10','ring-1','ring-inset','ring-primary/30'); vb.classList.remove('hover:bg-gray-50');
            const r = vb.querySelector('.w-4'); if(r){r.classList.remove('border-gray-300');r.classList.add('border-primary');r.innerHTML='<span class="w-2 h-2 rounded-full bg-primary"></span>';}
            btn.dataset.variantLabel = vb.dataset.variantLabel!; btn.dataset.price = vb.dataset.variantPrice!;
            const priceEl = document.querySelector('[itemprop="price"]') as HTMLElement; if(priceEl){const p=parseFloat(vb.dataset.variantPrice!);priceEl.textContent=`€${p.toFixed(2)}`;priceEl.setAttribute('content',String(p));}
            variantBtns.forEach(b=>{const ps=b.querySelector('span:last-child') as HTMLElement;if(ps){ps.classList.remove('text-primary','text-base');ps.classList.add('text-gray-900');}});
            const sp=vb.querySelector('span:last-child') as HTMLElement;if(sp){sp.classList.remove('text-gray-900');sp.classList.add('text-primary','text-base');}
          });
        });
      }
      btn.addEventListener('click', () => {
        const qty = parseInt(qtyInput?.value) || 1;
        addToCart({ slug: btn.dataset.slug!, name: btn.dataset.name!, image: btn.dataset.image!, variantLabel: btn.dataset.variantLabel!, price: parseFloat(btn.dataset.price!) }, qty);
        const toast = document.getElementById('cart-toast'); if(toast){toast.classList.remove('hidden');setTimeout(()=>toast.classList.add('hidden'),3500);}
        const orig = btn.textContent; btn.textContent = btn.dataset.addedText || '✓ ADDED!'; btn.classList.add('!bg-green-600'); setTimeout(()=>{btn.textContent=orig;btn.classList.remove('!bg-green-600');},1200);
      });
    }
    initProductPage();
    document.addEventListener('astro:after-swap', initProductPage);
  </script>
</BaseLayout>
