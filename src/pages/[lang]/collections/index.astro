---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { categories } from '../../../data/products';
import { supportedLocales, type Locale } from '../../../i18n/config';
import { t, getLocalePath, getAbsoluteLocaleUrl } from '../../../i18n/utils';
import { categoryTranslations } from '../../../data/translations/categories';

export function getStaticPaths() {
  return supportedLocales.map(lang => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const locale = lang as Locale;
const lp = (path: string) => getLocalePath(path, locale);

const breadcrumbs = [
  { name: t(locale, 'nav.home'), url: lp('/') },
  { name: t(locale, 'nav.collections') },
];

// Search-result copy for this index. `home.catDesc` is a one-line section subtitle
// and too thin to stand in for a meta description.
const seo: Record<string, { title: string; desc: string }> = {
  es: { title: 'Catálogo CBD al por Mayor | Flores, Resinas y Aceites', desc: 'Todas las colecciones CBD al por mayor: flores, resinas, aceites, gominolas y comestibles THC. Analizados en laboratorio, conformes UE, envío en 24h.' },
  fr: { title: 'Catalogue CBD en Gros | Fleurs, Résines et Huiles', desc: 'Toutes nos collections CBD en gros : fleurs, résines, huiles, gummies et comestibles THC. Testés en laboratoire, conformes UE, expédition en 24h.' },
  de: { title: 'CBD Großhandel Katalog | Blüten, Harze & Öle', desc: 'Alle CBD-Großhandelskollektionen: Blüten, Harze, Öle, Fruchtgummis und THC-Edibles. Laborgeprüft, EU-konform, Versand innerhalb von 24h.' },
  nl: { title: 'CBD Groothandel Catalogus | Bloemen, Harsen & Oliën', desc: 'Alle CBD-groothandelcollecties: bloemen, harsen, oliën, gummies en THC-edibles. Laboratoriumgetest, EU-conform, verzending binnen 24 uur.' },
  it: { title: 'Catalogo CBD all\'Ingrosso | Fiori, Resine e Oli', desc: 'Tutte le collezioni CBD all\'ingrosso: fiori, resine, oli, caramelle e edibili THC. Testati in laboratorio, conformi UE, spedizione in 24h.' },
  fi: { title: 'CBD-tukkukatalogi | Kukat, Hartsit ja Öljyt', desc: 'Kaikki CBD-tukkukokoelmat: kukat, hartsit, öljyt, karkit ja THC-syötävät. Laboratoriotestattu, EU-vaatimusten mukainen, toimitus 24 tunnissa.' },
  pt: { title: 'Catálogo CBD por Grosso | Flores, Resinas e Óleos', desc: 'Todas as coleções CBD por grosso: flores, resinas, óleos, gomas e comestíveis THC. Testados em laboratório, conformes UE, envio em 24h.' },
};
const pageSeo = seo[locale] ?? { title: `${t(locale, 'nav.collections')} | Greens Farmhouse`, desc: t(locale, 'home.catDesc') };

const collectionsJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": t(locale, 'nav.collections'),
  "description": pageSeo.desc,
  "url": getAbsoluteLocaleUrl(locale, '/collections'),
  "inLanguage": locale,
  "isPartOf": { "@type": "WebSite", "url": "https://greensfarmhouse.com" }
};
---

<BaseLayout
  title={pageSeo.title}
  description={pageSeo.desc}
  locale={locale}
  canonicalURL={getAbsoluteLocaleUrl(locale, '/collections')}
  jsonLd={collectionsJsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="bg-gradient-to-r from-primary to-primary-light text-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-extrabold mb-3">{t(locale, 'home.catTitle')}</h1>
      <p class="text-green-100 max-w-3xl">{t(locale, 'home.catDesc')}</p>
    </div>
  </section>

  <section class="py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map(cat => {
          const catT = categoryTranslations[locale]?.[cat.slug] || categoryTranslations.en[cat.slug];
          return (
            <a href={lp(`/collections/${cat.slug}`)} class="group bg-white rounded-xl border border-gray-200 p-8 text-center hover:shadow-lg hover:border-primary/30 transition-all duration-300">
              <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-green-50 to-green-100 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
              </div>
              <h2 class="text-lg font-bold text-gray-900 group-hover:text-primary transition-colors mb-2">{catT.name}</h2>
              <p class="text-sm text-gray-600 mb-3">{catT.description.slice(0, 120)}...</p>
              <span class="text-xs text-gray-500">{cat.productCount} {t(locale, 'common.products')}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
