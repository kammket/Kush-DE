---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Shopping Cart" },
];
---

<BaseLayout
  title="Shopping Cart | Greens Farmhouse"
  description="Review your wholesale CBD order and proceed to checkout."
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="py-6 md:py-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-8">Shopping Cart</h1>

      <!-- Empty Cart -->
      <div id="cart-empty" class="hidden text-center py-16">
        <svg class="w-20 h-20 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
        </svg>
        <h2 class="text-xl font-semibold text-gray-600 mb-2">Your cart is empty</h2>
        <p class="text-gray-400 mb-6">Browse our wholesale CBD products and add items to your cart.</p>
        <a href="/collections" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-xl font-semibold hover:bg-primary-dark transition-colors">
          Browse Products
        </a>
      </div>

      <!-- Cart Content -->
      <div id="cart-content" class="hidden">
        <!-- Cart Items -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden mb-6">
          <!-- Header -->
          <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3 bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wider border-b">
            <div class="col-span-6">Product</div>
            <div class="col-span-2 text-center">Price</div>
            <div class="col-span-2 text-center">Quantity</div>
            <div class="col-span-2 text-right">Subtotal</div>
          </div>

          <div id="cart-items" class="divide-y divide-gray-100">
            <!-- Items rendered by JS -->
          </div>
        </div>

        <!-- Volume discount ladder — the nudge that grows basket size -->
        <div id="volume-panel" class="hidden bg-gradient-to-br from-accent/15 via-white to-primary/5 rounded-xl border-2 border-accent/40 p-5 mb-6">
          <div class="flex items-center justify-between gap-3 mb-3">
            <h2 class="text-sm font-bold text-gray-900 flex items-center gap-2">
              <span aria-hidden="true">📦</span> Volume discount
            </h2>
            <span id="volume-badge" class="hidden text-xs font-bold px-2.5 py-1 rounded-full bg-primary text-white"></span>
          </div>

          <!-- Progress to the next tier -->
          <div id="volume-progress-wrap" class="hidden">
            <div class="h-2 w-full rounded-full bg-gray-200 overflow-hidden mb-2">
              <div id="volume-bar" class="h-full bg-primary rounded-full transition-all duration-500" style="width:0%"></div>
            </div>
            <p id="volume-nudge" class="text-sm text-gray-800 font-medium"></p>
          </div>
          <p id="volume-max" class="hidden text-sm font-semibold text-primary"></p>

          <!-- The full ladder, so the payoff for a bigger order is always visible -->
          <ul id="volume-ladder" class="mt-4 grid grid-cols-3 sm:grid-cols-6 gap-2 text-center"></ul>
        </div>

        <!-- Discount Code -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
          <div class="flex flex-col sm:flex-row gap-3">
            <div class="flex-1">
              <label for="discount-code" class="block text-sm font-medium text-gray-700 mb-1">Discount Code</label>
              <input
                id="discount-code"
                type="text"
                placeholder="Enter code (e.g. CBD20)"
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
              />
            </div>
            <button id="apply-discount" class="self-end px-6 py-2.5 bg-gray-900 text-white rounded-lg font-medium text-sm hover:bg-gray-800 transition-colors">
              Apply
            </button>
          </div>
          <p id="discount-msg" class="hidden mt-2 text-sm font-medium"></p>
        </div>

        <!-- Order Summary -->
        <div class="bg-white rounded-xl border border-gray-200 p-6">
          <h2 class="text-lg font-bold text-gray-900 mb-4">Order Summary</h2>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between">
              <span class="text-gray-600">Subtotal</span>
              <span id="summary-subtotal" class="font-medium text-gray-900">€0.00</span>
            </div>
            <div id="summary-discount-row" class="hidden flex justify-between text-green-600">
              <span id="summary-discount-label">Discount</span>
              <span id="summary-discount">−€0.00</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">Shipping</span>
              <span id="summary-shipping" class="font-medium text-gray-900">Calculated at checkout</span>
            </div>
            <div class="border-t pt-3 flex justify-between text-lg font-bold">
              <span>Total</span>
              <span id="summary-total" class="text-primary">€0.00</span>
            </div>
            <p id="free-shipping-note" class="hidden text-xs text-green-600 font-medium text-right">✓ Free shipping on orders over €150!</p>
          </div>
          <div class="mt-6 space-y-3">
            <a href="/checkout" id="checkout-btn" class="block w-full py-4 bg-primary text-white text-center text-lg font-bold rounded-xl hover:bg-primary-dark transition-colors shadow-lg">
              PROCEED TO CHECKOUT
            </a>
            <!-- Minimum order warning -->
            <div id="min-order-warning" class="hidden flex items-start gap-2 p-3 bg-amber-50 border border-amber-200 rounded-lg">
              <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
              <p class="text-sm text-amber-800">Minimum order of <strong>€150.00</strong> required for delivery. Add <strong id="min-order-remaining">€0.00</strong> more to proceed.</p>
            </div>
            <a href="/collections" class="block w-full py-3 border border-gray-300 text-gray-700 text-center font-medium rounded-xl hover:bg-gray-50 transition-colors text-sm">
              Continue Shopping
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getCart, removeFromCart, updateQuantity, getCartTotal } from '../scripts/cart';
  import { discountTiers, getTier, getNextTierProgress, resolveDiscount, topTierPercent } from '../data/discounts';

  /**
   * Renders the volume-discount panel: current tier, the gap to the next one, and
   * the full ladder. The gap line is the part that actually grows basket size —
   * an abstract "we offer volume discounts" does very little, whereas
   * "add €47 to save €48" is a concrete, one-step-away action.
   */
  function renderVolumePanel(subtotal: number, resolved: { percent: number; source: string }) {
    const panel = document.getElementById('volume-panel');
    if (!panel) return;
    panel.classList.remove('hidden');

    const badge = document.getElementById('volume-badge');
    const tier = getTier(subtotal);
    if (badge) {
      if (tier.percent > 0) {
        badge.textContent = `${tier.percent}% OFF APPLIED`;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    const next = getNextTierProgress(subtotal);
    const wrap = document.getElementById('volume-progress-wrap');
    const maxNote = document.getElementById('volume-max');
    const bar = document.getElementById('volume-bar');
    const nudge = document.getElementById('volume-nudge');

    if (next) {
      wrap?.classList.remove('hidden');
      maxNote?.classList.add('hidden');
      if (bar) bar.style.width = `${next.progress}%`;
      if (nudge) {
        nudge.innerHTML = `Add <strong class="text-primary">€${next.amountAway.toFixed(2)}</strong> more to unlock `
          + `<strong class="text-primary">${next.tier.percent}% off</strong> — you'd save `
          + `<strong class="text-primary">€${next.saving.toFixed(2)}</strong>.`;
      }
    } else {
      wrap?.classList.add('hidden');
      maxNote?.classList.remove('hidden');
      if (maxNote) maxNote.textContent = `🎉 You've unlocked our best rate — ${topTierPercent}% off this order.`;
    }

    const ladder = document.getElementById('volume-ladder');
    if (ladder) {
      ladder.innerHTML = discountTiers
        .filter(t => t.percent > 0)
        .map(t => {
          const active = subtotal >= t.min;
          return `<li class="rounded-lg border px-2 py-2 ${active ? 'border-primary bg-primary/10' : 'border-gray-200 bg-white'}">
            <span class="block text-sm font-bold ${active ? 'text-primary' : 'text-gray-900'}">${t.percent}%</span>
            <span class="block text-[11px] ${active ? 'text-primary' : 'text-gray-500'}">from €${t.min}</span>
          </li>`;
        }).join('');
    }

    // When a promo code beats the tier, say so rather than silently overriding.
    const msg = document.getElementById('discount-msg');
    if (msg && resolved.source === 'volume' && discountApplied) {
      msg.classList.remove('hidden', 'text-red-600');
      msg.classList.add('text-green-600');
      msg.textContent = `✓ Your ${tier.percent}% volume discount is larger than the code — we applied the better one.`;
    }
  }

  let discountApplied = false;
  const DISCOUNT_PCT = 0.20;
  const DISCOUNT_CODE = 'CBD20';

  function renderCart() {
    const cart = getCart();
    const emptyEl = document.getElementById('cart-empty');
    const contentEl = document.getElementById('cart-content');
    const itemsEl = document.getElementById('cart-items');

    if (cart.length === 0) {
      emptyEl?.classList.remove('hidden');
      contentEl?.classList.add('hidden');
      return;
    }

    emptyEl?.classList.add('hidden');
    contentEl?.classList.remove('hidden');

    if (itemsEl) {
      itemsEl.innerHTML = cart.map(item => `
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 px-4 md:px-6 py-4 items-center" data-key="${item.slug}::${item.variantLabel}">
          <!-- Product info -->
          <div class="md:col-span-6 flex items-center gap-4">
            <a href="/products/${item.slug}" class="shrink-0">
              <img src="${item.image}" alt="${item.name}" class="w-16 h-16 md:w-20 md:h-20 rounded-lg object-cover border border-gray-200" loading="lazy" />
            </a>
            <div class="min-w-0">
              <a href="/products/${item.slug}" class="font-semibold text-sm text-gray-900 hover:text-primary transition-colors line-clamp-2">${item.name}</a>
              <p class="text-xs text-gray-500 mt-0.5">${item.variantLabel}</p>
              <button class="cart-remove text-xs text-red-500 hover:text-red-700 mt-1 font-medium" data-slug="${item.slug}" data-variant="${item.variantLabel}">
                Remove
              </button>
            </div>
          </div>
          <!-- Price -->
          <div class="md:col-span-2 text-center">
            <span class="md:hidden text-xs text-gray-500">Price: </span>
            <span class="font-medium text-sm text-gray-900">€${item.price.toFixed(2)}</span>
          </div>
          <!-- Quantity -->
          <div class="md:col-span-2 flex justify-center">
            <div class="flex items-center border border-gray-300 rounded-lg overflow-hidden">
              <button class="cart-qty-minus px-2.5 py-1.5 text-gray-600 hover:bg-gray-100 text-sm font-bold" data-slug="${item.slug}" data-variant="${item.variantLabel}">−</button>
              <span class="w-10 text-center text-sm font-medium border-x border-gray-300 py-1.5">${item.quantity}</span>
              <button class="cart-qty-plus px-2.5 py-1.5 text-gray-600 hover:bg-gray-100 text-sm font-bold" data-slug="${item.slug}" data-variant="${item.variantLabel}">+</button>
            </div>
          </div>
          <!-- Subtotal -->
          <div class="md:col-span-2 text-right">
            <span class="md:hidden text-xs text-gray-500">Subtotal: </span>
            <span class="font-bold text-sm text-gray-900">€${(item.price * item.quantity).toFixed(2)}</span>
          </div>
        </div>
      `).join('');
    }

    // Bind qty & remove buttons
    document.querySelectorAll<HTMLButtonElement>('.cart-remove').forEach(btn => {
      btn.addEventListener('click', () => {
        removeFromCart(btn.dataset.slug!, btn.dataset.variant!);
        renderCart();
      });
    });
    document.querySelectorAll<HTMLButtonElement>('.cart-qty-minus').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = cart.find(c => c.slug === btn.dataset.slug && c.variantLabel === btn.dataset.variant);
        if (item) {
          updateQuantity(btn.dataset.slug!, btn.dataset.variant!, item.quantity - 1);
          renderCart();
        }
      });
    });
    document.querySelectorAll<HTMLButtonElement>('.cart-qty-plus').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = cart.find(c => c.slug === btn.dataset.slug && c.variantLabel === btn.dataset.variant);
        if (item) {
          updateQuantity(btn.dataset.slug!, btn.dataset.variant!, item.quantity + 1);
          renderCart();
        }
      });
    });

    // Summary — volume tier and promo code do not stack; the better one wins.
    const subtotal = getCartTotal();
    const resolved = resolveDiscount(subtotal, discountApplied ? DISCOUNT_PCT * 100 : 0);
    const discountAmt = resolved.amount;
    const total = subtotal - discountAmt;
    const freeShipping = total >= 150;
    renderVolumePanel(subtotal, resolved);

    const subtotalEl = document.getElementById('summary-subtotal');
    const discountRow = document.getElementById('summary-discount-row');
    const discountEl = document.getElementById('summary-discount');
    const shippingEl = document.getElementById('summary-shipping');
    const totalEl = document.getElementById('summary-total');
    const freeShipNote = document.getElementById('free-shipping-note');

    if (subtotalEl) subtotalEl.textContent = `€${subtotal.toFixed(2)}`;
    if (discountRow && discountEl) {
      if (resolved.percent > 0) {
        discountRow.classList.remove('hidden');
        discountEl.textContent = `−€${discountAmt.toFixed(2)}`;
        const label = document.getElementById('summary-discount-label');
        if (label) {
          label.textContent = resolved.source === 'promo'
            ? `Discount code (${resolved.percent}%)`
            : `Volume discount (${resolved.percent}%)`;
        }
      } else {
        discountRow.classList.add('hidden');
      }
    }
    if (shippingEl) shippingEl.textContent = freeShipping ? 'FREE' : 'Calculated at checkout';
    if (totalEl) totalEl.textContent = `€${total.toFixed(2)}`;
    if (freeShipNote) {
      if (freeShipping) freeShipNote.classList.remove('hidden');
      else freeShipNote.classList.add('hidden');
    }

    // Minimum order check
    const MIN_ORDER = 150;
    const checkoutBtn = document.getElementById('checkout-btn') as HTMLAnchorElement | null;
    const minWarning = document.getElementById('min-order-warning');
    const minRemaining = document.getElementById('min-order-remaining');
    if (total < MIN_ORDER) {
      if (checkoutBtn) {
        checkoutBtn.classList.remove('bg-primary', 'hover:bg-primary-dark', 'shadow-lg');
        checkoutBtn.classList.add('bg-gray-300', 'cursor-not-allowed', 'pointer-events-none');
      }
      if (minWarning) minWarning.classList.remove('hidden');
      if (minRemaining) minRemaining.textContent = `€${(MIN_ORDER - total).toFixed(2)}`;
    } else {
      if (checkoutBtn) {
        checkoutBtn.classList.add('bg-primary', 'hover:bg-primary-dark', 'shadow-lg');
        checkoutBtn.classList.remove('bg-gray-300', 'cursor-not-allowed', 'pointer-events-none');
      }
      if (minWarning) minWarning.classList.add('hidden');
    }
  }

  function initCartPage() {
    renderCart();

    // Discount code
    const applyBtn = document.getElementById('apply-discount');
    const codeInput = document.getElementById('discount-code') as HTMLInputElement | null;
    const discountMsg = document.getElementById('discount-msg');

    applyBtn?.addEventListener('click', () => {
      const code = codeInput?.value.trim().toUpperCase();
      if (discountMsg) {
        if (code === DISCOUNT_CODE) {
          discountApplied = true;
          discountMsg.classList.remove('hidden', 'text-red-600');
          discountMsg.classList.add('text-green-600');
          discountMsg.textContent = '✓ Code CBD20 applied — 20% off!';
          renderCart();
        } else {
          discountApplied = false;
          discountMsg.classList.remove('hidden', 'text-green-600');
          discountMsg.classList.add('text-red-600');
          discountMsg.textContent = '✗ Invalid discount code.';
          const discountRow = document.getElementById('summary-discount-row');
          discountRow?.classList.add('hidden');
          renderCart();
        }
      }
    });
  }

  initCartPage();
  document.addEventListener('astro:after-swap', initCartPage);
</script>
