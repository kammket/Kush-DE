---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Legal Notice" },
];
---

<BaseLayout
  title="Legal Notice | Greens Farmhouse"
  description="Legal notice and terms of use for Greens Farmhouse website. Information about the company, hosting, and intellectual property."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="py-10 md:py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-8">Legal Notice</h1>
      
      <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-600 prose-li:text-gray-600">
        <h2>Company Information</h2>
        <p>
          <strong>Greens Farmhouse</strong><br />
          Website: <a href="https://greensfarmhouse.com">https://greensfarmhouse.com</a><br />
          Email: <a href="mailto:contact@greensfarmhouse.com">contact@greensfarmhouse.com</a><br />
          Phone: <a href="tel:+420722562271">+420 722 562 271</a>
        </p>

        <h2>Terms of Use</h2>
        <p>By accessing and using this website, you accept and agree to be bound by these terms and conditions. If you do not agree to these terms, please do not use our website.</p>

        <h3>Age Restriction</h3>
        <p>This website and its products are intended for individuals aged 18 and over. By using this site, you confirm that you are at least 18 years of age.</p>

        <h3>Professional Use Only</h3>
        <p>Greens Farmhouse is a B2B (business-to-business) wholesale supplier. Our products are intended for professional buyers, retailers, and businesses operating in the CBD industry.</p>

        <h2>Product Information</h2>
        <p>All products sold on this website comply with applicable European Union regulations regarding hemp-derived products. Our CBD products contain less than 0.3% THC as required by law. Certificates of Analysis (COA) are available for all products upon request.</p>
        <p>Product images are for illustrative purposes. Actual products may vary slightly in appearance. Prices are subject to change without notice and are quoted in Euros (€) excluding applicable taxes.</p>

        <h2>Intellectual Property</h2>
        <p>All content on this website — including text, images, logos, graphics, and design elements — is the property of Greens Farmhouse and is protected by intellectual property laws. Unauthorized reproduction, distribution, or use of any content is strictly prohibited.</p>

        <h2>Limitation of Liability</h2>
        <p>Greens Farmhouse shall not be liable for any direct, indirect, incidental, or consequential damages arising from the use of this website or the products sold herein. We make no warranties, expressed or implied, regarding the accuracy of information provided on this site.</p>

        <h2>Governing Law</h2>
        <p>These terms are governed by and construed in accordance with French law. Any disputes arising from the use of this website shall be subject to the exclusive jurisdiction of the French courts.</p>

        <h2>Contact</h2>
        <p>For any questions regarding these legal terms, please contact us at <a href="mailto:contact@greensfarmhouse.com">contact@greensfarmhouse.com</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
