---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCountryOptions } from '../data/countries';

const countryOptions = getCountryOptions('en');

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Cart", url: "/cart" },
  { name: "Checkout" },
];
---

<BaseLayout
  title="Checkout | Greens Farmhouse"
  description="Complete your wholesale CBD order."
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="py-6 md:py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 mb-8">Checkout</h1>

      <!-- Empty redirect -->
      <div id="checkout-empty" class="hidden text-center py-16">
        <h2 class="text-xl font-semibold text-gray-600 mb-2">Your cart is empty</h2>
        <p class="text-gray-400 mb-6">Add products before checking out.</p>
        <a href="/collections" class="inline-flex bg-primary text-white px-6 py-3 rounded-xl font-semibold hover:bg-primary-dark transition-colors">Browse Products</a>
      </div>

      <!-- Checkout Form + Summary -->
      <div id="checkout-form-wrapper" class="hidden">
        <div class="grid lg:grid-cols-5 gap-8">
          
          <!-- Left: Form -->
          <div class="lg:col-span-3">
            <form id="checkout-form" class="space-y-6">
              
              <!-- Contact -->
              <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4">Contact Information</h2>
                <div class="grid sm:grid-cols-2 gap-4">
                  <div>
                    <label for="first-name" class="block text-sm font-medium text-gray-700 mb-1">First Name *</label>
                    <input type="text" id="first-name" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
                  </div>
                  <div>
                    <label for="last-name" class="block text-sm font-medium text-gray-700 mb-1">Last Name *</label>
                    <input type="text" id="last-name" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
                  </div>
                  <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                    <input type="email" id="email" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
                  </div>
                  <div>
                    <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                    <input type="tel" id="phone" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
                  </div>
                  <div class="sm:col-span-2">
                    <label for="company" class="block text-sm font-medium text-gray-700 mb-1">Company Name</label>
                    <input type="text" id="company" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder="For wholesale / B2B orders" />
                  </div>
                </div>
              </div>

              <!-- Shipping Address -->
              <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4">Shipping Address</h2>
                <div class="space-y-4">
                  <div>
                    <label for="address" class="block text-sm font-medium text-gray-700 mb-1">Address *</label>
                    <input type="text" id="address" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
                  </div>
                  <div>
                    <label for="address2" class="block text-sm font-medium text-gray-700 mb-1">Apartment, suite, etc.</label>
                    <input type="text" id="address2" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
                  </div>
                  <div class="grid sm:grid-cols-3 gap-4">
                    <div>
                      <label for="city" class="block text-sm font-medium text-gray-700 mb-1">City *</label>
                      <input type="text" id="city" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                      <label for="postal" class="block text-sm font-medium text-gray-700 mb-1">Postal Code *</label>
                      <input type="text" id="postal" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" />
                    </div>
                    <div>
                      <label for="country" class="block text-sm font-medium text-gray-700 mb-1">Country *</label>
                      <select id="country" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary bg-white">
                        {countryOptions.map(c => (
                          <option value={c.code} selected={c.code === 'FR'}>{c.name}</option>
                        ))}
                      </select>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Payment -->
              <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4">Payment Method</h2>
                <div class="space-y-3">
                  <label class="flex items-center gap-3 p-4 border-2 border-primary rounded-lg bg-primary/5 cursor-pointer">
                    <input type="radio" name="payment" value="transfer" checked class="accent-primary" />
                    <div class="flex items-center gap-3">
                      <svg class="w-6 h-6 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M3 6h18M3 14h18M3 18h18"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 2h14a2 2 0 012 2v16a2 2 0 01-2 2H5a2 2 0 01-2-2V4a2 2 0 012-2z"/></svg>
                      <div>
                        <span class="text-sm font-semibold text-gray-900">Bank Transfer (SEPA)</span>
                        <p class="text-xs text-gray-500 mt-0.5">Secure B2B payment — details sent via email after order</p>
                      </div>
                    </div>
                  </label>
                </div>
                <div class="mt-3 flex items-start gap-2 p-3 bg-blue-50 rounded-lg border border-blue-100">
                  <svg class="w-4 h-4 text-blue-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
                  <p class="text-xs text-blue-700">After placing your order, our team emails you our bank details — usually within a few hours.</p>
                </div>
                <div class="mt-2 flex items-start gap-2 p-3 bg-amber-50 rounded-lg border border-amber-200">
                  <span class="text-base leading-none shrink-0" aria-hidden="true">⚡</span>
                  <p class="text-xs text-amber-900"><strong>Send the transfer as soon as you receive those details.</strong> We reserve your stock and dispatch the moment payment lands, so a same-day transfer is the single biggest thing you control in how fast your order arrives.</p>
                </div>
              </div>

              <!-- First-time customer gift -->
              <div class="bg-accent/10 border-2 border-dashed border-accent rounded-xl p-5">
                <label for="first-time-gift" class="flex items-start gap-3 cursor-pointer">
                  <input type="checkbox" id="first-time-gift" class="mt-1 w-5 h-5 accent-primary shrink-0 cursor-pointer" />
                  <span>
                    <span class="block text-sm font-bold text-gray-900">🎁 First time ordering with Greens Farmhouse?</span>
                    <span class="block text-sm text-gray-600 mt-1">
                      Tick this box and we will add a few grams of one of our top products to your package,
                      free of charge — so you can try something new alongside what you ordered.
                    </span>
                  </span>
                </label>
              </div>

              <!-- Ordering with confidence -->
              <div class="bg-white rounded-xl border border-gray-200 p-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4">Ordering With Confidence</h2>
                <ul class="space-y-4">
                  <li class="flex items-start gap-3">
                    <span class="text-xl leading-none shrink-0" aria-hidden="true">🔬</span>
                    <span>
                      <strong class="block text-sm text-gray-900">The lab certificate ships inside the box</strong>
                      <span class="block text-sm text-gray-600 mt-0.5">Every batch is tested by an independent laboratory, and the COA travels with your package — so the paperwork you need is in your hands the moment the parcel arrives.</span>
                    </span>
                  </li>
                  <li class="flex items-start gap-3">
                    <span class="text-xl leading-none shrink-0" aria-hidden="true">🚚</span>
                    <span>
                      <strong class="block text-sm text-gray-900">Delivery is guaranteed</strong>
                      <span class="block text-sm text-gray-600 mt-0.5">Every order is tracked and insured, dispatched within 24 hours of payment clearing, and reaches you across Europe in 1–3 working days. You get the tracking number as soon as it ships.</span>
                    </span>
                  </li>
                  <li class="flex items-start gap-3">
                    <span class="text-xl leading-none shrink-0" aria-hidden="true">🛡️</span>
                    <span>
                      <strong class="block text-sm text-gray-900">48-hour guarantee on every parcel</strong>
                      <span class="block text-sm text-gray-600 mt-0.5">If anything arrives damaged or incorrect, send us photos within 48 hours of delivery and we arrange a replacement or a refund. See <a href="/guarantees" class="text-primary underline">our guarantees</a>.</span>
                    </span>
                  </li>
                  <li class="flex items-start gap-3">
                    <span class="text-xl leading-none shrink-0" aria-hidden="true">💬</span>
                    <span>
                      <strong class="block text-sm text-gray-900">Questions before you pay? Talk to us first</strong>
                      <span class="block text-sm text-gray-600 mt-0.5">You will reach the same team preparing your order — not a call centre. Ask for a COA, check stock, or arrange a different payment arrangement before transferring anything.</span>
                      <a
                        href="https://wa.me/420722562271?text=Hello!%20I%20have%20a%20question%20before%20placing%20my%20order."
                        target="_blank"
                        rel="noopener"
                        class="mt-2 inline-flex items-center gap-2 px-4 py-2 bg-[#0D6D5F] text-white rounded-lg text-sm font-semibold hover:bg-[#094F45] transition-colors"
                      >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        Message us on WhatsApp
                      </a>
                    </span>
                  </li>
                </ul>
              </div>

              <!-- Notes -->
              <div class="bg-white rounded-xl border border-gray-200 p-6">
                <label for="notes" class="block text-sm font-medium text-gray-700 mb-1">Order Notes (optional)</label>
                <textarea id="notes" rows="3" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary" placeholder="Special instructions for your order..."></textarea>
              </div>

              <!-- Error banner -->
              <div id="checkout-error" class="hidden bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl p-4"></div>

              <!-- Submit -->
              <button type="submit" id="place-order-btn" class="w-full py-4 bg-primary text-white text-lg font-bold rounded-xl hover:bg-primary-dark transition-colors shadow-lg focus:outline-none focus:ring-4 focus:ring-primary/30">
                PLACE ORDER
              </button>

              <p class="text-xs text-gray-500 text-center">
                By placing your order, you agree to our
                <a href="/legal" class="text-primary underline">Terms</a> and
                <a href="/privacy" class="text-primary underline">Privacy Policy</a>.
              </p>
            </form>
          </div>

          <!-- Right: Order Summary -->
          <div class="lg:col-span-2">
            <div class="bg-white rounded-xl border border-gray-200 p-6 lg:sticky lg:top-28">
              <h2 class="text-lg font-bold text-gray-900 mb-4">Order Summary</h2>
              <div id="checkout-items" class="divide-y divide-gray-100 max-h-80 overflow-y-auto mb-4">
                <!-- Items rendered by JS -->
              </div>
              <div class="space-y-2 text-sm border-t pt-4">
                <div class="flex justify-between">
                  <span class="text-gray-600">Subtotal</span>
                  <span id="co-subtotal" class="font-medium">€0.00</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Shipping</span>
                  <span id="co-shipping" class="font-medium">FREE</span>
                </div>
                <div class="flex justify-between text-lg font-bold border-t pt-2">
                  <span>Total</span>
                  <span id="co-total" class="text-primary">€0.00</span>
                </div>
              </div>
              <a href="/cart" class="block mt-4 text-center text-sm text-primary hover:underline font-medium">← Edit Cart</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Minimum Order Warning -->
      <div id="checkout-minimum" class="hidden text-center py-16">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-amber-100 text-amber-600 mb-6">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
        </div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Minimum Order Not Reached</h2>
        <p class="text-gray-600 mb-2 max-w-md mx-auto">Your order total must be at least <strong class="text-primary">€150.00</strong> to be eligible for delivery.</p>
        <p class="text-gray-500 text-sm mb-2">Your current cart total: <strong id="minimum-cart-total" class="text-gray-900">€0.00</strong></p>
        <p class="text-gray-400 text-sm mb-8">Please add more items to your cart to proceed with checkout.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/collections" class="bg-primary text-white px-6 py-3 rounded-xl font-semibold hover:bg-primary-dark transition-colors">Browse Products</a>
          <a href="/cart" class="border border-gray-300 text-gray-700 px-6 py-3 rounded-xl font-medium hover:bg-gray-50 transition-colors">Back to Cart</a>
        </div>
      </div>

      <!-- Confirmation (shown after order) -->
      <div id="checkout-confirmation" class="hidden text-center py-16">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-green-100 text-green-600 mb-6">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h2 class="text-2xl font-extrabold text-gray-900 mb-3">Thank You for Your Order!</h2>
        <div class="max-w-lg mx-auto">
          <p class="text-gray-600 mb-4">Our team has received your order and is reviewing it now.</p>

          <!-- Shown only when the order could not be registered automatically. The
               order is never discarded: the WhatsApp button below carries the full
               order, so the customer always has a working route to us. -->
          <div id="confirm-fallback" class="hidden bg-amber-50 border-2 border-amber-300 rounded-xl p-5 mb-6 text-left">
            <h3 class="font-bold text-amber-900 mb-1 flex items-center gap-2"><span aria-hidden="true">⚠️</span> One quick step to finish</h3>
            <p class="text-sm text-amber-900">We could not confirm your order by email just now. Your order details are safe — please tap the WhatsApp button below to send them straight to our team, and we will take it from there immediately.</p>
          </div>

          <!-- Order reference: shown here so the customer has it immediately, without
               depending on the confirmation email arriving or escaping a spam filter. -->
          <div id="confirm-ref-box" class="hidden bg-white border-2 border-primary/30 rounded-xl p-5 mb-6">
            <p class="text-xs font-bold text-primary uppercase tracking-wide mb-1">Your order reference</p>
            <p id="confirm-ref" class="text-2xl font-extrabold text-gray-900 tracking-wide select-all"></p>
            <p class="text-xs text-gray-500 mt-2">Quote this as the payment description on your transfer. Write it down now — you will also receive it by email.</p>
          </div>
          <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 mb-6 text-left">
            <h3 class="font-semibold text-blue-900 mb-2 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              What Happens Next?
            </h3>
            <ul class="space-y-2 text-sm text-blue-800">
              <li class="flex items-start gap-2">
                <span class="font-bold text-blue-600 mt-0.5">1.</span>
                <span>You will receive an email shortly at <strong id="confirm-email" class="text-blue-900"></strong> with your order summary and our bank transfer details.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-blue-600 mt-0.5">2.</span>
                <span>Complete the bank transfer at your convenience. Please include your order reference in the transfer description.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="font-bold text-blue-600 mt-0.5">3.</span>
                <span>Once payment is confirmed, we will prepare and ship your order with full tracking.</span>
              </li>
            </ul>
            <a
              id="confirm-whatsapp"
              href="https://wa.me/420722562271"
              target="_blank"
              rel="noopener"
              class="mt-4 w-full flex items-center justify-center gap-3 px-5 py-4 bg-[#0B6B5D] hover:bg-[#094F45] text-white rounded-xl transition-colors shadow-md hover:shadow-lg"
            >
              <svg class="w-8 h-8 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              <span class="text-left">
                <span class="block font-bold text-sm">Send your order through WhatsApp</span>
                <span class="block text-xs text-white/90 mt-0.5">For a faster response and personal follow-up on your order</span>
              </span>
            </a>
            <p class="mt-2 text-xs text-blue-700 text-center flex items-center justify-center gap-1">
              <svg class="w-3.5 h-3.5 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              You'll chat directly with our team — the same people preparing your order.
            </p>
          </div>
          <div class="flex items-center gap-2 justify-center text-sm text-gray-500 mb-8">
            <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span>Your data is securely handled. We never share your information with third parties.</span>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/collections" class="bg-primary text-white px-6 py-3 rounded-xl font-semibold hover:bg-primary-dark transition-colors">Continue Shopping</a>
          <a href="/" class="border border-gray-300 text-gray-700 px-6 py-3 rounded-xl font-medium hover:bg-gray-50 transition-colors">Back to Home</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getCart, getCartTotal, clearCart } from '../scripts/cart';

  const MIN_ORDER = 150;

  function initCheckout() {
    const cart = getCart();
    const emptyEl = document.getElementById('checkout-empty');
    const formWrapper = document.getElementById('checkout-form-wrapper');
    const confirmEl = document.getElementById('checkout-confirmation');
    const minimumEl = document.getElementById('checkout-minimum');

    // Hide all states first
    confirmEl?.classList.add('hidden');
    minimumEl?.classList.add('hidden');
    formWrapper?.classList.add('hidden');
    emptyEl?.classList.add('hidden');

    if (cart.length === 0) {
      emptyEl?.classList.remove('hidden');
      return;
    }

    const subtotal = getCartTotal();

    // Check minimum order
    if (subtotal < MIN_ORDER) {
      minimumEl?.classList.remove('hidden');
      const totalEl = document.getElementById('minimum-cart-total');
      if (totalEl) totalEl.textContent = `€${subtotal.toFixed(2)}`;
      return;
    }

    formWrapper?.classList.remove('hidden');

    // Render summary items
    const itemsEl = document.getElementById('checkout-items');
    if (itemsEl) {
      itemsEl.innerHTML = cart.map(item => `
        <div class="flex items-center gap-3 py-3">
          <div class="relative shrink-0">
            <img src="${item.image}" alt="${item.name}" class="w-12 h-12 rounded-lg object-cover border border-gray-200" />
            <span class="absolute -top-1.5 -right-1.5 bg-gray-700 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center font-bold">${item.quantity}</span>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-gray-900 truncate">${item.name}</p>
            <p class="text-xs text-gray-500">${item.variantLabel}</p>
          </div>
          <span class="text-sm font-bold text-gray-900 shrink-0">€${(item.price * item.quantity).toFixed(2)}</span>
        </div>
      `).join('');
    }

    // Totals
    const freeShipping = subtotal >= 150;
    document.getElementById('co-subtotal')!.textContent = `€${subtotal.toFixed(2)}`;
    document.getElementById('co-shipping')!.textContent = freeShipping ? 'FREE' : '€9.90';
    const total = freeShipping ? subtotal : subtotal + 9.9;
    document.getElementById('co-total')!.textContent = `€${total.toFixed(2)}`;

    // Form submission
    const form = document.getElementById('checkout-form') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn = document.getElementById('place-order-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'PROCESSING...';
      document.getElementById('checkout-error')?.classList.add('hidden');

      // Generated here so the customer sees a reference even if the email service
      // is unreachable, and so screen, inbox and our copy all quote the same one.
      const orderRef = `GF-${Date.now().toString(36).toUpperCase()}`;

      const emailInput = document.getElementById('email') as HTMLInputElement;
      const confirmEmail = document.getElementById('confirm-email');
      if (confirmEmail) confirmEmail.textContent = emailInput?.value || '';

      // Build order data
      const orderData = {
        type: 'order',
        firstName: (document.getElementById('first-name') as HTMLInputElement)?.value,
        lastName: (document.getElementById('last-name') as HTMLInputElement)?.value,
        email: emailInput?.value,
        phone: (document.getElementById('phone') as HTMLInputElement)?.value,
        company: (document.getElementById('company') as HTMLInputElement)?.value,
        address: (document.getElementById('address') as HTMLInputElement)?.value,
        address2: (document.getElementById('address2') as HTMLInputElement)?.value,
        city: (document.getElementById('city') as HTMLInputElement)?.value,
        postal: (document.getElementById('postal') as HTMLInputElement)?.value,
        country: (document.getElementById('country') as HTMLSelectElement)?.value,
        notes: (document.getElementById('notes') as HTMLTextAreaElement)?.value,
        items: cart.map(item => ({ name: item.name, variant: item.variantLabel, quantity: item.quantity, price: item.price })),
        subtotal,
        shipping: freeShipping ? 'FREE' : '€9.90',
        total,
        orderRef,
        firstTimeGift: (document.getElementById('first-time-gift') as HTMLInputElement)?.checked || false,
      };

      // An order is never discarded because email failed. If the request does not
      // succeed we still confirm, still show the reference, and route the customer
      // to WhatsApp with the full order pre-filled so it always reaches the team.
      let registered = false;
      try {
        const res = await fetch('/api/send-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(orderData),
        });
        registered = res.ok;
      } catch {
        registered = false;
      }

      const refEl = document.getElementById('confirm-ref');
      if (refEl) refEl.textContent = orderRef;
      document.getElementById('confirm-ref-box')?.classList.remove('hidden');
      if (!registered) {
        document.getElementById('confirm-fallback')?.classList.remove('hidden');
      }

      // WhatsApp summary doubles as the recovery path, so it carries everything
      // needed to fulfil the order — reference, delivery address and gift flag.
      const waLink = document.getElementById('confirm-whatsapp') as HTMLAnchorElement | null;
      if (waLink) {
        const lines = [
          `Hello! I just placed an order on greensfarmhouse.com`,
          `Order reference: ${orderRef}`,
          ``,
          `Order summary:`,
          ...orderData.items.map(i => `- ${i.quantity}x ${i.name} (${i.variant}) — €${(i.price * i.quantity).toFixed(2)}`),
          ``,
          `Subtotal: €${subtotal.toFixed(2)}`,
          `Shipping: ${orderData.shipping}`,
          `Total: €${total.toFixed(2)}`,
          ``,
          `Name: ${orderData.firstName} ${orderData.lastName}${orderData.company ? ` (${orderData.company})` : ''}`,
          `Email: ${orderData.email}`,
          ...(orderData.phone ? [`Phone: ${orderData.phone}`] : []),
          `Address: ${orderData.address}${orderData.address2 ? `, ${orderData.address2}` : ''}, ${orderData.postal} ${orderData.city}, ${orderData.country}`,
          ...(orderData.firstTimeGift ? [``, `First-time customer — free sample requested.`] : []),
          ...(orderData.notes ? [``, `Notes: ${orderData.notes}`] : []),
        ];
        waLink.href = `https://wa.me/420722562271?text=${encodeURIComponent(lines.join('\n'))}`;
      }

      // Only clear the cart once the order actually reached us. If it did not, the
      // cart survives so the customer can retry rather than losing their basket.
      if (registered) clearCart();
      formWrapper?.classList.add('hidden');
      confirmEl?.classList.remove('hidden');

      // Scroll to top
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  initCheckout();
  document.addEventListener('astro:after-swap', initCheckout);
</script>
