---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContentByline from '../components/ContentByline.astro';
import ProductCard from '../components/ProductCard.astro';
import WaLink from '../components/WaLink.astro';
import { getProductBySlug } from '../data/products';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "CBN & Sleep Products" },
];

const cbnProducts = ['le-beldia-cbn-cbd-resin', 'le-jaune-cbn-resin', 'golden-static-resin', 'cbd-cbn-melatonin-oil'].map(s => getProductBySlug(s)!).filter(Boolean);
const sleepEdibles = ['bonbons-1400mg-melatonin', 'bonbons-1400mg-strawberry', 'organic-cbd-oil-10', 'organic-cbd-oil-20'].map(s => getProductBySlug(s)!).filter(Boolean);

const waUrl = `https://wa.me/447346989289?text=${encodeURIComponent("Hello! I'm interested in your CBN and sleep-support products. Can you tell me about wholesale pricing?")}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "CBN & Sleep Products Wholesale: The Fastest-Growing Cannabinoid Segment",
  "description": "Wholesale CBN resins, CBD+CBN+melatonin oil, and melatonin CBD gummies. The sleep-support segment is the fastest-growing corner of the cannabinoid market. Lab-tested, EU-compliant.",
  "url": "https://greensfarmhouse.com/cbn-sleep-products",
  "author": { "@type": "Organization", "name": "Greens Farmhouse" },
  "publisher": { "@type": "Organization", "name": "Greens Farmhouse", "url": "https://greensfarmhouse.com" },
  "datePublished": "2026-07-06",
  "dateModified": "2026-07-06"
};

const faqItems = [
  {
    question: "What is CBN?",
    answer: "CBN (cannabinol) is a cannabinoid that forms naturally as THC ages and oxidizes. It's non-intoxicating at legal concentrations and is best known for its association with relaxation and sleep support — which is why CBN products are marketed almost exclusively to the evening and nighttime segment. Like all our products, our CBN range is lab-tested and compliant with EU law."
  },
  {
    question: "Why should my shop stock sleep-support products?",
    answer: "Sleep is the number-one reason new customers walk into a CBD shop, ahead of pain and anxiety. A dedicated sleep shelf — CBN resins, a CBD+CBN+melatonin oil, melatonin gummies — captures that intent immediately and gives you products with a clear use case that's easy to explain at the counter. It also attracts an older, wellness-focused clientele with higher basket values."
  },
  {
    question: "What sleep products do you carry?",
    answer: "Three families: CBN-focused resins (Le Jaune CBN, Le Beldia CBN+CBD, and Golden Static with its triple CBD+CBG+CBN profile), a specialty oil combining 10% CBD, 10% CBN and melatonin, and 1400mg CBD gummies with melatonin in red-fruits flavor. All are available at wholesale pricing with volume discounts."
  },
  {
    question: "Are CBN products legal in the EU?",
    answer: "Yes. CBN is not a controlled substance under EU law, and all our CBN products respect the same THC limits as the rest of the catalog, verified by independent lab certificates that ship with every batch."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
};
---

<BaseLayout
  title="CBN & Sleep Products Wholesale | CBN Resins, Melatonin CBD — Europe"
  description="Wholesale CBN and sleep-support products: CBN resins, CBD+CBN+melatonin oil, melatonin CBD gummies. The fastest-growing cannabinoid segment. Lab-tested, EU-compliant, shipped in 24h."
  canonicalURL="https://greensfarmhouse.com/cbn-sleep-products"
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero -->
  <section class="py-12 md:py-20 bg-gradient-to-br from-indigo-50 via-white to-primary/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-indigo-100 text-indigo-800 text-xs font-bold px-3 py-1 rounded-full mb-4 uppercase tracking-wider">🌙 The Sleep Segment</span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-3">
        CBN &amp; Sleep Products — <span class="text-primary">The Fastest-Growing Cannabinoid Segment</span>
      </h1>
      <div class="mb-4 flex justify-center"><ContentByline /></div>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto mb-8">
        Sleep is the #1 reason new customers try cannabinoids. Stock the shelf that captures them:
        CBN-rich resins, a specialty CBD+CBN+melatonin oil, and melatonin CBD gummies —
        all lab-tested, EU-compliant, and available at wholesale pricing.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/products/cbd-cbn-melatonin-oil" class="inline-flex items-center px-6 py-3 bg-primary text-white font-bold rounded-lg hover:bg-primary-dark transition-colors">
          See the CBD+CBN+Melatonin Oil
        </a>
        <WaLink href={waUrl} class="px-6 py-3">Ask About Wholesale Pricing</WaLink>
      </div>
    </div>
  </section>

  <!-- CBN products -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold mb-2">CBN Resins &amp; Specialty Oil</h2>
      <p class="text-gray-600 mb-8 max-w-2xl">CBN (cannabinol) is the cannabinoid most associated with relaxation and nighttime use. Our CBN range covers resins and a dedicated sleep-formula oil.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-6">
        {cbnProducts.map(p => <ProductCard product={p} />)}
      </div>
      <a href="/collections/cbd-resins" class="text-primary font-semibold hover:underline">View all CBD Resins →</a>
    </div>
  </section>

  <!-- Why sleep segment -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-10">Why the Sleep Shelf Sells</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200">
          <span class="text-4xl block mb-4">🛌</span>
          <h3 class="font-bold text-lg mb-2">#1 Customer Intent</h3>
          <p class="text-sm text-gray-600">Sleep support is the most common reason new customers try cannabinoid products — ahead of pain and stress. Meet the demand the moment they walk in.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200">
          <span class="text-4xl block mb-4">🔁</span>
          <h3 class="font-bold text-lg mb-2">Repeat Purchases</h3>
          <p class="text-sm text-gray-600">Sleep products are consumed nightly and repurchased monthly — the most reliable recurring revenue in the CBD shop.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200">
          <span class="text-4xl block mb-4">💎</span>
          <h3 class="font-bold text-lg mb-2">Low Competition</h3>
          <p class="text-sm text-gray-600">Most shops stop at CBD oil. A dedicated CBN and melatonin range differentiates your shelf and justifies premium pricing.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sleep edibles -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold mb-2">Melatonin Gummies &amp; Evening Oils</h2>
      <p class="text-gray-600 mb-8 max-w-2xl">Round out the sleep shelf with melatonin CBD gummies and organic evening oils.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-6">
        {sleepEdibles.map(p => <ProductCard product={p} />)}
      </div>
      <a href="/collections/cbd-gummies" class="text-primary font-semibold hover:underline">View all CBD Gummies →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-10">CBN &amp; Sleep Products — FAQ</h2>
      <div class="space-y-4">
        {faqItems.map(f => (
          <details class="group bg-white rounded-xl border border-gray-200 p-5">
            <summary class="font-semibold text-gray-900 cursor-pointer list-none flex items-center justify-between gap-4">
              {f.question}
              <svg class="w-5 h-5 text-gray-400 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 text-gray-600 text-sm leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 md:py-16 bg-primary text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-4">Build Your Sleep Shelf</h2>
      <p class="text-green-100 mb-8 max-w-2xl mx-auto">Ask us for wholesale pricing on the CBN range — or start with a sample pack to test the products first.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <WaLink href={waUrl} class="px-6 py-3">Chat on WhatsApp</WaLink>
        <a href="/cbd-sample-packs" class="bg-white text-primary px-6 py-3 rounded-lg font-bold hover:bg-gray-100 transition-colors">Order Samples First</a>
      </div>
    </div>
  </section>
</BaseLayout>
