---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQ from '../components/FAQ.astro';
import { getProductsByCategory } from '../data/products';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Wholesale CBD Flowers Italy" },
];

const topFlowers = getProductsByCategory('cbd-flowers').filter(p => p.inStock).slice(0, 4);
const topResins = getProductsByCategory('cbd-resins').filter(p => p.inStock).slice(0, 4);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Wholesale CBD Flowers Italy — Fiori CBD all'Ingrosso Italia",
  "description": "Your wholesale CBD flower supplier for Italy. Cannabis light compliant with Legge 242/2016. Fast shipping to Rome, Milan, Naples, Turin.",
  "url": "https://greensfarmhouse.com/wholesale-cbd-flowers-italy",
  "isPartOf": { "@type": "WebSite", "url": "https://greensfarmhouse.com" }
};

const faqItems = [
  {
    question: "Is CBD legal in Italy?",
    answer: "Yes. Cannabis light with THC below 0.2% is legal in Italy under the Legge 242/2016. All our products are fully compliant with Italian legislation and ship with COA documentation."
  },
  {
    question: "How fast is shipping to Italy?",
    answer: "2-4 business days for delivery throughout Italy — Rome, Milan, Naples, Turin, and all other cities. Free shipping on orders above €150."
  },
  {
    question: "Do you provide Italian invoicing?",
    answer: "Yes. We issue invoices compliant with Italian regulations for all orders. Complete legal documentation included."
  }
];


---

<BaseLayout
  title="Wholesale CBD Flowers Italy | Fiori CBD all'Ingrosso Italia"
  description="Your wholesale CBD flower supplier for Italy. Cannabis light compliant with Legge 242/2016. Fast 2-4 day shipping. Premium flowers from €0.19/g."
  canonicalURL="https://greensfarmhouse.com/wholesale-cbd-flowers-italy"
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero -->
  <section class="py-12 md:py-20 bg-gradient-to-br from-green-50 via-white to-red-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-green-100 text-green-800 text-xs font-bold px-3 py-1 rounded-full mb-4 uppercase tracking-wider">🇮🇹 CBD Italy</span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-6">
        Wholesale CBD Flowers Italy — <span class="text-primary">Cannabis Light Premium</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto mb-8">
        Italy has one of Europe's most developed cannabis light markets. Our CBD flowers fully comply with the Legge 242/2016. Fast shipping in 2-4 business days throughout Italy with complete documentation.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/collections/cbd-flowers" class="inline-flex items-center px-6 py-3 bg-primary text-white font-bold rounded-lg hover:bg-primary-dark transition-colors">
          Shop CBD Flowers
        </a>
        <a href="/collections/cbd-resins" class="inline-flex items-center px-6 py-3 border-2 border-primary text-primary font-bold rounded-lg hover:bg-primary/5 transition-colors">
          Shop CBD Resins
        </a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-10">Why Choose Us for Cannabis Light in Italy?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200">
          <span class="text-4xl block mb-4">🇮🇹</span>
          <h3 class="font-bold text-lg mb-2">Legge 242/2016 Compliant</h3>
          <p class="text-sm text-gray-600">All products fully comply with Italian cannabis light legislation. THC &lt; 0.2% guaranteed with Certificate of Analysis for every batch.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200">
          <span class="text-4xl block mb-4">🚚</span>
          <h3 class="font-bold text-lg mb-2">Fast Italian Delivery</h3>
          <p class="text-sm text-gray-600">2-4 business day delivery throughout Italy. Free shipping on orders over €150. Tracked and insured.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200">
          <span class="text-4xl block mb-4">🌱</span>
          <h3 class="font-bold text-lg mb-2">Italian & European Quality</h3>
          <p class="text-sm text-gray-600">Hemp partially cultivated in Tuscany and completed with premium Swiss and French production. The best of Europe.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold mb-2">CBD Flowers Italy — Wholesale</h2>
      <p class="text-gray-600 mb-8">Premium <a href="/collections/cbd-flowers" class="text-primary hover:underline font-medium">cannabis light</a> compliant with Italian legislation. Fast delivery throughout Italy.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {topFlowers.map(p => <ProductCard product={p} />)}
      </div>
      <div class="text-center mt-6">
        <a href="/collections/cbd-flowers" class="text-primary font-semibold hover:underline">Browse all CBD Flowers →</a>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold mb-2">CBD Resins Italy — Wholesale</h2>
      <p class="text-gray-600 mb-8"><a href="/collections/cbd-resins" class="text-primary hover:underline font-medium">CBD hash and resins</a> compliant with Italian legislation. European production.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {topResins.map(p => <ProductCard product={p} />)}
      </div>
      <div class="text-center mt-6">
        <a href="/collections/cbd-resins" class="text-primary font-semibold hover:underline">Browse all CBD Resins →</a>
      </div>
    </div>
  </section>

  <!-- SEO Content -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-6">Cannabis Light Wholesale Italy: Market Overview</h2>
      <div class="prose prose-gray max-w-none space-y-4 text-gray-600 leading-relaxed">
        <p>
          Italy pioneered the European <strong>cannabis light movement</strong> with the Legge 242/2016, creating one of the continent's most mature and thriving CBD markets. Thousands of cannabis light shops operate across Italy, from Milan to Naples, and the market continues to grow. As a trusted <a href="/wholesale-cbd-flowers-europe" class="text-primary underline hover:no-underline">European wholesale supplier</a>, we help Italian businesses access the best quality at the most competitive prices.
        </p>
        <h3 class="text-xl font-bold text-gray-900 mt-6">Italian Compliance & Quality</h3>
        <p>
          Our cannabis light products comply with Legge 242/2016 with THC levels verified below 0.2%. We combine the finest Italian hemp — including Tuscan-grown varieties — with premium Swiss and French production. All <a href="/cbd-hemp-flowers-indoor" class="text-primary underline hover:no-underline">indoor</a>, <a href="/cbd-hemp-flowers-greenhouse" class="text-primary underline hover:no-underline">greenhouse</a>, and outdoor flower options are available with full COA.
        </p>
        <h3 class="text-xl font-bold text-gray-900 mt-6">Serving the Italian Market</h3>
        <p>
          Whether you're a cannabis light shop in Rome, a <a href="/cbd-in-tobacco-shops" class="text-primary underline hover:no-underline">tabaccheria</a> in Milan, or an online retailer serving all of Italy, we provide the products, documentation, and pricing you need. <a href="/cbd-flowers-bulk-europe" class="text-primary underline hover:no-underline">Bulk purchasing</a> from 1kg+ receives preferential pricing with priority shipping.
        </p>
      </div>
    </div>
  </section>

  <FAQ title="Cannabis Light Wholesale Italy — FAQ" items={faqItems} />

  <!-- CTA -->
  <section class="py-12 md:py-16 bg-primary text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Your CBD Supplier for Italy</h2>
      <p class="text-green-100 mb-6">Premium cannabis light, fully compliant. Fast delivery throughout Italy, free shipping from €150.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/collections" class="bg-white text-primary px-6 py-3 rounded-lg font-bold hover:bg-gray-100 transition-colors">Browse Products</a>
        <a href="/contact" class="border-2 border-white text-white px-6 py-3 rounded-lg font-bold hover:bg-white/10 transition-colors">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
