---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Testimonials from '../components/Testimonials.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Our Guarantees" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Our Guarantees — Greens Farmhouse",
  "description": "Discover our quality guarantees: lab-tested products, satisfaction guarantee, secure payments, fast shipping, and full EU compliance.",
  "url": "https://greensfarmhouse.com/guarantees",
  "isPartOf": { "@type": "WebSite", "url": "https://greensfarmhouse.com" }
};
---

<BaseLayout
  title="Our Guarantees | Quality, Safety & Satisfaction | Greens Farmhouse"
  description="Greens Farmhouse guarantees: 100% lab-tested products, satisfaction guarantee, secure SSL payments, insured 24h shipping, full EU compliance. Buy wholesale CBD with confidence."
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero -->
  <section class="py-12 md:py-16 bg-gradient-to-br from-primary/5 to-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-6">
        Our <span class="text-primary">Guarantees</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto">
        When you order from Greens Farmhouse, you benefit from comprehensive guarantees designed to give you complete peace of mind. 
        We're committed to your satisfaction at every step.
      </p>
    </div>
  </section>

  <!-- Guarantees Grid -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8">

        <!-- Lab Testing -->
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center mb-5">
            <span class="text-3xl">🔬</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">100% Lab-Tested Products</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Every single product we sell is tested by independent third-party laboratories. We provide 
            Certificates of Analysis (COA) for every batch, verifying cannabinoid content, terpene profiles, 
            and the absence of pesticides, heavy metals, and microbial contaminants.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Third-party laboratory analysis</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> COA available for every batch</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Guaranteed THC &lt; 0.3%</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Pesticide & heavy metal free</li>
          </ul>
        </div>

        <!-- Satisfaction Guarantee -->
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mb-5">
            <span class="text-3xl">🛡️</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">100% Satisfaction Guarantee</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            We stand behind the quality of every product we sell. If your order doesn't meet your expectations, 
            we'll work with you to make it right — whether that means a replacement, credit, or refund. 
            Your satisfaction is our priority.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Replacement or refund available</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Report issues within 48 hours</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Dedicated support team</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Free samples with every order</li>
          </ul>
        </div>

        <!-- Secure Payments -->
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-purple-100 rounded-xl flex items-center justify-center mb-5">
            <span class="text-3xl">🔒</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">Secure Payments</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Your financial information is protected with industry-standard SSL encryption. We offer multiple 
            trusted payment methods so you can choose what works best for your business. All transactions 
            are processed through certified payment gateways.
          </p>
          <div class="flex flex-wrap items-center gap-3 mt-4">
            <span class="inline-flex items-center gap-1.5 bg-gray-100 px-3 py-2 rounded-lg text-xs font-medium text-gray-700">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="4" width="22" height="16" rx="2" ry="2" stroke-width="2"/><line x1="1" y1="10" x2="23" y2="10" stroke-width="2"/></svg>
              Visa
            </span>
            <span class="inline-flex items-center gap-1.5 bg-gray-100 px-3 py-2 rounded-lg text-xs font-medium text-gray-700">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="4" width="22" height="16" rx="2" ry="2" stroke-width="2"/><line x1="1" y1="10" x2="23" y2="10" stroke-width="2"/></svg>
              Mastercard
            </span>
            <span class="inline-flex items-center gap-1.5 bg-gray-100 px-3 py-2 rounded-lg text-xs font-medium text-gray-700">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2a10 10 0 100 20 10 10 0 000-20z" stroke-width="2"/><path d="M12 8v4l3 3" stroke-width="2" stroke-linecap="round"/></svg>
              Bank Transfer
            </span>
            <span class="inline-flex items-center gap-1.5 bg-gray-100 px-3 py-2 rounded-lg text-xs font-medium text-gray-700">
              🔐 SSL Encrypted
            </span>
          </div>
        </div>

        <!-- Fast Shipping -->
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-orange-100 rounded-xl flex items-center justify-center mb-5">
            <span class="text-3xl">📦</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">Insured & Fast Shipping</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            All orders are shipped within 24 hours of payment via premium carriers. Every package is fully 
            insured, tracked, and sent in discreet, neutral packaging. Free shipping on orders over €200 
            within France. Competitive rates for all European destinations.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Shipped within 24 hours</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Fully insured & tracked</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Discreet neutral packaging</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Free delivery over €200 (France)</li>
          </ul>
        </div>

        <!-- EU Compliance -->
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-yellow-100 rounded-xl flex items-center justify-center mb-5">
            <span class="text-3xl">🇪🇺</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">Full EU Compliance</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            All products comply with European Union regulations. Our hemp is sourced exclusively from certified 
            European farms, and every product contains less than 0.3% THC as required by law. We maintain full 
            traceability from farm to delivery.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> EU-certified hemp sources</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> THC &lt; 0.3% guaranteed</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Full product traceability</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Organic, Non-GMO hemp</li>
          </ul>
        </div>

        <!-- Data Privacy -->
        <div class="bg-white rounded-2xl border border-gray-200 p-8 hover:shadow-lg transition-shadow">
          <div class="w-14 h-14 bg-teal-100 rounded-xl flex items-center justify-center mb-5">
            <span class="text-3xl">🔐</span>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-3">Privacy & Data Protection</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            We take your privacy seriously. Your personal and business data is protected under GDPR compliance. 
            We never sell or share your information with third parties. All communication is encrypted and 
            order details are kept strictly confidential.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> GDPR compliant</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> No data sold to third parties</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Encrypted communications</li>
            <li class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Discreet billing & packaging</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <Testimonials />

  <!-- CTA -->
  <section class="py-12 md:py-16 bg-primary text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Ready to Order with Confidence?</h2>
      <p class="text-green-100 mb-8 text-lg">
        Join 5,000+ professionals who trust Greens Farmhouse for their wholesale CBD supply.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/collections" class="inline-flex items-center gap-2 px-8 py-3 bg-white text-primary font-bold rounded-lg hover:bg-gray-100 transition-colors shadow-lg">
          Browse Products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 px-8 py-3 border-2 border-white text-white font-bold rounded-lg hover:bg-white/10 transition-colors">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
