---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQ from '../components/FAQ.astro';
import { getProductsByCategory } from '../data/products';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Greens Farmhouse Belgium" },
];

const flowers = getProductsByCategory('cbd-flowers').filter(p => p.inStock).slice(0, 4);
const resins = getProductsByCategory('cbd-resins').filter(p => p.inStock).slice(0, 4);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Greens Farmhouse Belgium — Wholesale CBD Flowers, Oils & Resins Supplier",
  "description": "Your trusted CBD wholesale supplier for Belgium. Premium CBD flowers, oils, resins & edibles at wholesale prices. Fast delivery throughout Belgium.",
  "url": "https://greensfarmhouse.com/cbd-wholesaler-belgium",
  "isPartOf": { "@type": "WebSite", "url": "https://greensfarmhouse.com" }
};

const faqItems = [
  {
    question: "Is CBD legal in Belgium?",
    answer: "Yes. CBD products are legal in Belgium provided the THC content is below 0.2% (aligned with EU regulations). All products shipped from Greens Farmhouse to Belgium are certified to contain less than 0.2% THC, with Certificates of Analysis from independent European laboratories."
  },
  {
    question: "How fast is delivery to Belgium?",
    answer: "We ship to Belgium from our European warehouse. Standard delivery takes 2-3 business days. Express shipping (1-2 business days) is available. Free delivery on all orders over €99."
  },
  {
    question: "Can I sell CBD in my Belgian shop?",
    answer: "Yes. Retailers, tobacco shops, vape shops, and wellness stores throughout Belgium can legally sell CBD products meeting the 0.2% THC threshold. We provide full product documentation, COAs, and invoicing that meets Belgian regulatory requirements."
  },
  {
    question: "What are the best-selling CBD products in Belgium?",
    answer: "In Belgium, the most popular wholesale CBD products are indoor CBD flowers (like Amnesia and Gorilla Glue), CBD hash/resins, and CBD oils in 10% and 20% concentrations. Belgian consumers favour strong-flavoured, high-quality products."
  },
  {
    question: "Do you offer private labeling for Belgian businesses?",
    answer: "Yes. We offer white-label and private-label services for Belgian CBD brands. Choose from our full product range, add your custom branding, and we'll handle packaging. Contact us for volume pricing and customization options."
  }
];


const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
};
---

<BaseLayout
  title="Greens Farmhouse Belgium | Bulk CBD Flowers, Oils & Resins — Best Prices"
  description="Belgium's trusted CBD wholesale supplier. Buy CBD flowers, resins, oils in bulk at the best wholesale prices. Lab-tested, EU-compliant, fast delivery to Belgium."
  canonicalURL="https://greensfarmhouse.com/cbd-wholesaler-belgium"
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <!-- Hero -->
  <section class="py-12 md:py-20 bg-gradient-to-br from-yellow-50 via-white to-red-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-3xl mb-3">🇧🇪</span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-6">
        Greens Farmhouse Belgium — <span class="text-primary">Premium Wholesale CBD Products</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto mb-8">
        Greens Farmhouse is Belgium's go-to supplier for premium wholesale CBD products. We deliver 
        <a href="/collections/cbd-flowers" class="text-primary hover:underline">CBD flowers</a>, 
        <a href="/collections/cbd-resins" class="text-primary hover:underline">resins</a>, 
        <a href="/collections/cbd-oils" class="text-primary hover:underline">oils</a>, and edibles 
        at unbeatable wholesale prices — directly to Brussels, Antwerp, Ghent, Liège, and all of Belgium.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/collections" class="inline-flex items-center px-6 py-3 bg-primary text-white font-bold rounded-lg hover:bg-primary-dark transition-colors">
          Shop Wholesale CBD
        </a>
        <a href="/contact" class="inline-flex items-center px-6 py-3 border-2 border-primary text-primary font-bold rounded-lg hover:bg-primary/5 transition-colors">
          Request Belgian Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Belgium Market Info -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-10">Why Source CBD Wholesale for the Belgian Market?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200">
          <span class="text-4xl block mb-4">📦</span>
          <h3 class="font-bold text-lg mb-2">Fast Belgian Delivery</h3>
          <p class="text-sm text-gray-600">2-3 business day delivery throughout Belgium — Brussels, Antwerp, Ghent, Liège, Charleroi, Bruges. Free shipping on orders over €99.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200">
          <span class="text-4xl block mb-4">✅</span>
          <h3 class="font-bold text-lg mb-2">Belgian-Compliant Products</h3>
          <p class="text-sm text-gray-600">All products certified below 0.2% THC, fully compliant with Belgian CBD regulations. Complete COA documentation for your records.</p>
        </div>
        <div class="text-center p-6 bg-white rounded-xl border border-gray-200">
          <span class="text-4xl block mb-4">💰</span>
          <h3 class="font-bold text-lg mb-2">Best Wholesale Prices</h3>
          <p class="text-sm text-gray-600">CBD flowers from €0.19/g, oils from €1.50/unit, resins from €0.49/g. Volume discounts available for Belgian retailers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold mb-2">Popular CBD Flowers in Belgium</h2>
      <p class="text-gray-600 mb-8">Belgian retailers love our premium <a href="/collections/cbd-flowers" class="text-primary hover:underline font-medium">CBD flowers</a>. Indoor strains like Amnesia, Gorilla Glue, and Wedding Cake are top sellers in Brussels and Antwerp.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {flowers.map(p => <ProductCard product={p} />)}
      </div>
      <div class="text-center mt-6">
        <a href="/collections/cbd-flowers" class="text-primary font-semibold hover:underline">Browse all CBD Flowers →</a>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold mb-2">CBD Resins & Hash — Wholesale Belgium</h2>
      <p class="text-gray-600 mb-8">Our <a href="/collections/cbd-resins" class="text-primary hover:underline font-medium">CBD resins</a> and hash are among the best-selling products in Belgian CBD shops. Premium quality at wholesale prices.</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {resins.map(p => <ProductCard product={p} />)}
      </div>
      <div class="text-center mt-6">
        <a href="/collections/cbd-resins" class="text-primary font-semibold hover:underline">Browse all CBD Resins →</a>
      </div>
    </div>
  </section>

  <!-- SEO Content -->
  <section class="py-12 md:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-6">CBD Wholesale in Belgium: The Complete Guide</h2>
      <div class="prose prose-gray max-w-none space-y-4 text-gray-600 leading-relaxed">
        <p>
          Belgium has emerged as one of Europe's most dynamic CBD markets, with growing consumer demand across 
          Flanders, Wallonia, and Brussels. As a Belgian CBD retailer, <a href="/cbd-in-tobacco-shops" class="text-primary hover:underline">tobacco shop owner</a>, 
          or e-commerce entrepreneur, sourcing high-quality wholesale CBD is essential to building a profitable business.
        </p>
        <h3 class="text-xl font-bold text-gray-900 mt-6">Belgian CBD Market Overview</h3>
        <p>
          The Belgian CBD market has grown substantially since 2020. Key retail channels include specialized CBD shops 
          (particularly in Brussels, Antwerp, and Ghent), tobacco shops and press shops (tabacs), pharmacies, and online 
          stores. Belgian consumers are quality-conscious and prefer lab-tested products with clear THC compliance documentation.
        </p>
        <h3 class="text-xl font-bold text-gray-900 mt-6">CBD Regulations in Belgium</h3>
        <p>
          Belgium follows EU guidelines allowing CBD products with less than 0.2% THC. The Belgian Federal Agency for the 
          Safety of the Food Chain (FAVV/AFSCA) oversees CBD food products. All our wholesale products come with full 
          lab certificates demonstrating compliance, making it easy for Belgian retailers to maintain regulatory standards.
        </p>
        <h3 class="text-xl font-bold text-gray-900 mt-6">Serving All Belgian Cities</h3>
        <p>
          We deliver to every Belgian city and commune, with particularly fast service to Brussels, Antwerp, Ghent, 
          Charleroi, Liège, Bruges, Namur, Leuven, and Mons. Whether you're opening a <a href="/blog/how-to-start-cbd-business" class="text-primary hover:underline">new CBD shop</a> in 
          Brussels or expanding your existing <a href="/collections" class="text-primary hover:underline">product range</a> in Antwerp, 
          we're your trusted Belgian wholesale partner.
        </p>
        <p>
          Looking for <a href="/cbd-wholesaler-organic" class="text-primary hover:underline">organic CBD products</a>? We also offer a 
          premium organic range sourced from certified European farms — ideal for Belgium's health-conscious market.
        </p>
      </div>
    </div>
  </section>

  <FAQ title="CBD Wholesale Belgium — FAQ" items={faqItems} />

  <!-- CTA -->
  <section class="py-12 md:py-16 bg-primary text-white text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Start Selling CBD in Belgium Today</h2>
      <p class="text-green-100 mb-6">Get premium CBD products at wholesale prices with fast delivery throughout Belgium.</p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/collections" class="bg-white text-primary px-6 py-3 rounded-lg font-bold hover:bg-gray-100 transition-colors">Shop Wholesale</a>
        <a href="/contact" class="border-2 border-white text-white px-6 py-3 rounded-lg font-bold hover:bg-white/10 transition-colors">Contact Us</a>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
