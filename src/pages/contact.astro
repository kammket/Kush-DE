---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Contact Us" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Greens Farmhouse",
  "description": "Get in touch with Greens Farmhouse for wholesale CBD inquiries, quotes, and support.",
  "url": "https://greensfarmhouse.com/contact",
  "mainEntity": {
    "@type": "Organization",
    "name": "Greens Farmhouse",
    "url": "https://greensfarmhouse.com",
    "telephone": "+33-1-88-81-21-99",
    "email": "contact@greensfarmhouse.com",
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": "+33-1-88-81-21-99",
        "contactType": "customer service",
        "email": "contact@greensfarmhouse.com",
        "availableLanguage": ["English", "French"],
        "hoursAvailable": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "FR"
    }
  }
};
---

<BaseLayout
  title="Contact Us | Greens Farmhouse — Get a Wholesale Quote"
  description="Contact Greens Farmhouse for wholesale CBD inquiries, custom quotes, and customer support. Phone: +44 7346 989289 | Email: contact@greensfarmhouse.com"
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <section class="py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4">Get In Touch</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Have questions about our wholesale CBD products? Need a custom quote? 
          Our team is here to help you find the perfect solution for your business.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Contact Info -->
        <div class="lg:col-span-1 space-y-6">
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Contact Information</h2>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">Phone</p>
                  <a href="tel:+447346989289" class="text-sm text-primary hover:underline">+44 7346 989289</a>
                  <p class="text-xs text-gray-500 mt-1">Mon–Fri, 9:00–18:00 CET</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">Email</p>
                  <a href="mailto:contact@greensfarmhouse.com" class="text-sm text-primary hover:underline break-all">contact@greensfarmhouse.com</a>
                  <p class="text-xs text-gray-500 mt-1">We reply within 24 hours</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-gray-900">WhatsApp</p>
                  <a href="https://wa.me/447346989289" class="text-sm text-primary hover:underline" target="_blank" rel="noopener">Chat with us on WhatsApp</a>
                  <p class="text-xs text-gray-500 mt-1">Fastest way to reach us</p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-primary/5 rounded-xl p-6">
            <h3 class="font-bold text-gray-900 mb-3">For Wholesale Inquiries</h3>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                Custom quotes for bulk orders
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                White-label and private labeling
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                Volume discounts available
              </li>
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                Free samples for qualified buyers
              </li>
            </ul>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <form class="bg-white rounded-xl border border-gray-200 p-6 md:p-8 space-y-6" id="contact-form">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-semibold text-gray-900 mb-1">First Name *</label>
                <input 
                  type="text" 
                  id="first-name" 
                  name="first-name" 
                  required
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition"
                  placeholder="John"
                />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-semibold text-gray-900 mb-1">Last Name *</label>
                <input 
                  type="text" 
                  id="last-name" 
                  name="last-name" 
                  required
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition"
                  placeholder="Doe"
                />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-sm font-semibold text-gray-900 mb-1">Email Address *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition"
                  placeholder="john@company.com"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-semibold text-gray-900 mb-1">Phone Number</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone"
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition"
                  placeholder="+33 6 12 34 56 78"
                />
              </div>
            </div>

            <div>
              <label for="company" class="block text-sm font-semibold text-gray-900 mb-1">Company Name</label>
              <input 
                type="text" 
                id="company" 
                name="company"
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition"
                placeholder="Your Business Name"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-semibold text-gray-900 mb-1">Subject *</label>
              <select 
                id="subject" 
                name="subject" 
                required
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition bg-white"
              >
                <option value="">Select a subject...</option>
                <option value="wholesale-quote">Wholesale Quote Request</option>
                <option value="product-info">Product Information</option>
                <option value="order-support">Order Support</option>
                <option value="shipping">Shipping & Delivery</option>
                <option value="white-label">White Label / Private Label</option>
                <option value="partnership">Partnership Inquiry</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-gray-900 mb-1">Message *</label>
              <textarea 
                id="message" 
                name="message" 
                required
                rows="5"
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/30 focus:border-primary text-sm transition resize-y"
                placeholder="Tell us about your needs, quantities, and any specific requirements..."
              ></textarea>
            </div>

            <div class="flex items-start gap-2">
              <input type="checkbox" id="consent" name="consent" required class="mt-1 rounded border-gray-300 text-primary focus:ring-primary" />
              <label for="consent" class="text-xs text-gray-600">
                I agree to the processing of my personal data in accordance with the 
                <a href="/privacy" class="text-primary underline hover:no-underline">Privacy Policy</a>. *
              </label>
            </div>

            <button 
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 bg-primary text-white font-semibold rounded-full hover:bg-primary/90 transition"
            >
              Send Message
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Sending...';

      const data = {
        type: 'contact',
        firstName: (document.getElementById('first-name') as HTMLInputElement)?.value,
        lastName: (document.getElementById('last-name') as HTMLInputElement)?.value,
        email: (document.getElementById('email') as HTMLInputElement)?.value,
        phone: (document.getElementById('phone') as HTMLInputElement)?.value,
        company: (document.getElementById('company') as HTMLInputElement)?.value,
        contactSubject: (document.getElementById('subject') as HTMLSelectElement)?.value,
        message: (document.getElementById('message') as HTMLTextAreaElement)?.value,
      };

      try {
        const res = await fetch('/api/send-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          form.innerHTML = '<div class="text-center py-12"><div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 text-green-600 mb-4"><svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg></div><h3 class="text-xl font-bold text-gray-900 mb-2">Message Sent!</h3><p class="text-gray-600">Thank you for contacting us. We\'ll get back to you within 24 hours.</p></div>';
        } else {
          throw new Error('Failed');
        }
      } catch {
        btn.disabled = false;
        btn.innerHTML = originalText;
        alert('Sorry, there was an error sending your message. Please try again or email us directly at kushyguy5@gmail.com');
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
